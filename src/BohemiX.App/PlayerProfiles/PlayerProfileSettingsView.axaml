<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:BohemiX.App.Controls"
             xmlns:profiles="using:BohemiX.App.PlayerProfiles"
             x:Class="BohemiX.App.PlayerProfiles.PlayerProfileSettingsView"
             x:DataType="profiles:PlayerProfileManagerViewModel">
    <UserControl.Resources>
        <StreamGeometry x:Key="ProfilePageSteam">M11.98,0 C5.68,0 0.51,4.86 0.02,11.04 L6.45,13.70 C6.99,13.33 7.65,13.11 8.36,13.11 C8.42,13.11 8.48,13.11 8.55,13.12 L11.41,8.97 L11.41,8.91 C11.41,6.42 13.44,4.39 15.94,4.39 C18.43,4.39 20.46,6.42 20.46,8.91 C20.46,11.41 18.43,13.44 15.94,13.44 L15.83,13.44 L11.76,16.35 C11.76,16.40 11.76,16.46 11.76,16.51 C11.76,18.38 10.25,19.90 8.37,19.90 C6.74,19.90 5.36,18.73 5.04,17.18 L0.44,15.28 C1.86,20.30 6.49,24 11.98,24 C18.61,24 24,18.63 24,12 C24,5.37 18.61,0 11.98,0 Z M8.39,18.77 C7.07,18.77 6,17.70 6,16.38 C6,16.29 6.01,16.20 6.02,16.11 L7.62,16.77 C7.80,17.58 8.52,18.19 9.38,18.19 C10.38,18.19 11.19,17.37 11.19,16.37 C11.19,15.51 10.58,14.79 9.77,14.61 L9.11,13.01 C9.20,13 9.29,12.99 9.38,12.99 C10.70,12.99 11.77,14.06 11.77,15.38 C11.77,16.70 10.70,18.77 8.39,18.77 Z M15.95,12.02 C14.24,12.02 12.86,10.63 12.86,8.93 C12.86,7.22 14.24,5.84 15.95,5.84 C17.65,5.84 19.04,7.22 19.04,8.93 C19.04,10.63 17.65,12.02 15.95,12.02 Z M15.95,6.59 C14.66,6.59 13.61,7.64 13.61,8.93 C13.61,10.21 14.66,11.26 15.95,11.26 C17.24,11.26 18.28,10.21 18.28,8.93 C18.28,7.64 17.24,6.59 15.95,6.59 Z</StreamGeometry>
