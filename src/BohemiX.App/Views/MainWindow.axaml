<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:BohemiX.App.Controls"
        xmlns:community="using:BohemiX.App.Community"
        xmlns:anim="https://github.com/whistyun/AnimatedImage.Avalonia"
        xmlns:playerProfiles="using:BohemiX.App.PlayerProfiles"
        xmlns:vm="using:BohemiX.App.ViewModels"
        xmlns:views="using:BohemiX.App.Views"
        xmlns:alchemyViews="using:BohemiX.Modules.Alchemy.Views"
        xmlns:saveManagerModels="using:BohemiX.Modules.SaveManager.Models"
        xmlns:saveManagerViews="using:BohemiX.Modules.SaveManager.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
        x:Class="BohemiX.App.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/bohemix-logo.ico"
        Title="BohemiX"
        Width="1600"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <Window.Resources>
        <StreamGeometry x:Key="IconSteam">M11.98,0 C5.68,0 0.51,4.86 0.02,11.04 L6.45,13.70 C6.99,13.33 7.65,13.11 8.36,13.11 C8.42,13.11 8.48,13.11 8.55,13.12 L11.41,8.97 L11.41,8.91 C11.41,6.42 13.44,4.39 15.94,4.39 C18.43,4.39 20.46,6.42 20.46,8.91 C20.46,11.41 18.43,13.44 15.94,13.44 L15.83,13.44 L11.76,16.35 C11.76,16.40 11.76,16.46 11.76,16.51 C11.76,18.38 10.25,19.90 8.37,19.90 C6.74,19.90 5.36,18.73 5.04,17.18 L0.44,15.28 C1.86,20.30 6.49,24 11.98,24 C18.61,24 24,18.63 24,12 C24,5.37 18.61,0 11.98,0 Z M8.39,18.77 C7.07,18.77 6,17.70 6,16.38 C6,16.29 6.01,16.20 6.02,16.11 L7.62,16.77 C7.80,17.58 8.52,18.19 9.38,18.19 C10.38,18.19 11.19,17.37 11.19,16.37 C11.19,15.51 10.58,14.79 9.77,14.61 L9.11,13.01 C9.20,13 9.29,12.99 9.38,12.99 C10.70,12.99 11.77,14.06 11.77,15.38 C11.77,16.70 10.70,18.77 8.39,18.77 Z M15.95,12.02 C14.24,12.02 12.86,10.63 12.86,8.93 C12.86,7.22 14.24,5.84 15.95,5.84 C17.65,5.84 19.04,7.22 19.04,8.93 C19.04,10.63 17.65,12.02 15.95,12.02 Z M15.95,6.59 C14.66,6.59 13.61,7.64 13.61,8.93 C13.61,10.21 14.66,11.26 15.95,11.26 C17.24,11.26 18.28,10.21 18.28,8.93 C18.28,7.64 17.24,6.59 15.95,6.59 Z</StreamGeometry>
        <StreamGeometry x:Key="IconArrowLeft">M19,12 L5,12 M11,6 L5,12 L11,18</StreamGeometry>
        <StreamGeometry x:Key="IconSidebarExpandSolid">M7,5 L18,12 L7,19 Z</StreamGeometry>
        <!-- Erlenmeyer flask (cone flask), styled like the other 24x24 line icons -->
    </Window.Resources>

    <Grid>
    <Grid x:Name="RootChrome">
        <controls:SmoothCornerBorder x:Name="WindowFrame"
                                     CornerRadius="18"
                                     Background="#050A14"
                                     BorderBrush="#263040"
                                     BorderThickness="1"
                                     InsetStroke="True"
                                     ClipToBounds="True">
    <Grid>
    <Grid x:Name="WindowDragSurface"
          Background="Transparent"
          ClipToBounds="True"
          PointerPressed="WindowDragSurface_OnPointerPressed"
          PointerMoved="WindowDragSurface_OnPointerMoved"
          PointerReleased="WindowDragSurface_OnPointerReleased"
          PointerCaptureLost="WindowDragSurface_OnPointerCaptureLost">
        <controls:BackgroundLayerHost x:Name="BackgroundHost"
                                      IsHitTestVisible="False"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch">
            <Image x:Name="DefaultBackgroundImage"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch" />

            <controls:BackgroundImageControl x:Name="StaticBackgroundImage"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             CropMode="{Binding MoreSettings.BackgroundCropMode}"
                                             CropX="{Binding MoreSettings.BackgroundCropX}"
                                             CropY="{Binding MoreSettings.BackgroundCropY}"
                                             CropWidth="{Binding MoreSettings.BackgroundCropWidth}"
                                             CropHeight="{Binding MoreSettings.BackgroundCropHeight}" />

            <Grid x:Name="DynamicBackgroundHost"
                  ClipToBounds="True">
                <Image x:Name="DynamicBackgroundImage"
                       anim:ImageBehavior.AnimatedSource="{Binding MoreSettings.DynamicBackgroundUri}"
                       anim:ImageBehavior.RepeatBehavior="Forever"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       RenderTransformOrigin="0%,0%">
                    <Image.RenderTransform>
                        <TranslateTransform />
                    </Image.RenderTransform>
                </Image>
            </Grid>

            <ContentControl x:Name="BackgroundVideoHost"
                            IsHitTestVisible="False"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </controls:BackgroundLayerHost>

        <Grid x:Name="StartupStripeBackdrop"
              Opacity="0"
              IsHitTestVisible="False"
              ZIndex="1"
              ClipToBounds="True">
            <Border Background="#0A192F" />
            <Grid Width="2600"
                  Height="2194"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  RenderTransformOrigin="50%,50%">
                <Grid.RenderTransform>
                    <TranslateTransform X="-96" Y="-96" />
                </Grid.RenderTransform>

                <Image x:Name="StartupStripeImage"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" />

                <Border Opacity="0.28">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#30FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="0.22" />
                            <GradientStop Color="#00000000" Offset="0.6" />
                            <GradientStop Color="#5F000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <Border>
                <Border.Background>
                    <RadialGradientBrush Center="50%,46%" GradientOrigin="50%,46%" RadiusX="82%" RadiusY="82%">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#1F000000" Offset="0.54" />
                        <GradientStop Color="#B0000000" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <Border IsHitTestVisible="False"
                Opacity="{Binding BackgroundDimOpacity}">
            <Border.Background>
                <RadialGradientBrush Center="70%,50%" GradientOrigin="70%,50%" RadiusX="82%" RadiusY="82%">
                    <GradientStop Color="#00050A14" Offset="0" />
                    <GradientStop Color="#59050A14" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Border Height="160"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                ZIndex="5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#B8050A14" Offset="0" />
                    <GradientStop Color="#4D050A14" Offset="0.55" />
                    <GradientStop Color="#00050A14" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid x:Name="TopBar"
              Height="56"
              Margin="24,0,22,0"
              VerticalAlignment="Top"
              ColumnDefinitions="Auto,*,Auto"
              ZIndex="20">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <StackPanel.RenderTransform>
                    <TranslateTransform X="-14" />
                </StackPanel.RenderTransform>
                <Grid Width="40"
                      Height="40"
                      VerticalAlignment="Center">
                    <controls:BohemiXLogoMark Width="38"
                                               Height="38"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                </Grid>
                <controls:BohemiXWordLogo Width="92"
                                           Height="26"
                                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding KeepTopNavigationVisible}">
                <Button Classes="GlyphNavCircle" Classes.active="{Binding IsDashboardActive}" AutomationProperties.AutomationId="Nav.Home" ToolTip.Tip="{Binding DashboardNavTooltipText}" Command="{Binding NavigateCommand}" CommandParameter="Home">
                    <PathIcon Data="{StaticResource BmxIconHome}" Width="17" Height="17" />
                </Button>
                <Button Classes="GlyphNavCircle" Classes.active="{Binding IsModsActive}" AutomationProperties.AutomationId="Nav.Mods" ToolTip.Tip="{Binding ModsNavTooltipText}" Command="{Binding LoadModsCommand}">
                    <PathIcon Data="{StaticResource BmxIconPuzzle}" Width="17" Height="17" />
                </Button>
                <Button Classes="GlyphNavCircle" Classes.active="{Binding IsStoreActive}" AutomationProperties.AutomationId="Nav.Store" ToolTip.Tip="{Binding StoreNavTooltipText}" Command="{Binding OpenStoreCommand}">
                    <Border Width="24"
                            Height="24"
                            CornerRadius="12"
                            Background="#CC0B1324">
                        <Path Data="{StaticResource IconSteam}"
                              Width="19"
                              Height="19"
                              Fill="White"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                </Button>
                <Button Classes="GlyphNavCircle" Classes.active="{Binding IsLabActive}" AutomationProperties.AutomationId="Nav.Lab" ToolTip.Tip="{Binding LabNavTooltipText}" Command="{Binding OpenLabCommand}">
                    <PathIcon Data="{StaticResource BmxIconFlask}" Width="17" Height="17" />
                </Button>
                <Button Classes="GlyphNavCircle" Classes.active="{Binding IsSettingsActive}" AutomationProperties.AutomationId="Nav.Settings" ToolTip.Tip="{Binding SettingsNavTooltipText}" Command="{Binding OpenSettingsCommand}">
                    <PathIcon Data="{StaticResource BmxIconSettings}" Width="17" Height="17" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Button Classes="GlyphWindowControlButton"
                        ToolTip.Tip="{Binding MinimizeText}"
                        Click="MinimizeWindowButton_OnClick">
                    <Border Width="13"
                            Height="2"
                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            VerticalAlignment="Center" />
                </Button>
                <Button Classes="GlyphWindowControlButton"
                        ToolTip.Tip="{Binding ScaleText}"
                        Click="ToggleWindowScaleButton_OnClick">
                    <Border Width="13"
                            Height="13"
                            BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            BorderThickness="1.5" />
                </Button>
                <Button Classes="GlyphWindowControlButton CloseWindowControl"
                        ToolTip.Tip="{Binding CloseText}"
                        PointerEntered="CloseWindowButton_OnPointerEntered"
                        Click="CloseWindowButton_OnClick">
                    <Grid x:Name="CloseWindowGlyph"
                          Width="22"
                          Height="22"
                          RenderTransformOrigin="50%,50%">
                        <Grid.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Grid.RenderTransform>
                        <Border Width="25"
                                Height="2.6"
                                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="50%,50%">
                            <Border.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Border.RenderTransform>
                        </Border>
                        <Border Width="25"
                                Height="2.6"
                                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="50%,50%">
                            <Border.RenderTransform>
                                <RotateTransform Angle="-45" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="SidebarShell"
              Width="{Binding SidebarWidth}"
              Margin="0,56,0,0"
              HorizontalAlignment="Left"
              RowDefinitions="Auto,Auto,*,Auto"
              ClipToBounds="True"
              Background="Transparent"
              ZIndex="15">
            <StackPanel x:Name="LauncherSidebarNavigation" Margin="10,18,10,0" Spacing="5" IsVisible="{Binding IsLauncherNavigationVisible}">
                <TextBlock Text="{Binding NavigationHeaderText}"
                           Margin="12,0,0,6"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#66FFFFFF"
                           IsVisible="{Binding IsSidebarExpanded}" />

                <Button Classes="GlyphSidebarItem" Classes.active="{Binding IsDashboardActive}" ToolTip.Tip="{Binding DashboardNavTooltipText}" Command="{Binding NavigateSilentCommand}" CommandParameter="Dashboard">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <PathIcon Data="{StaticResource BmxIconDashboard}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding DashboardNavText}" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" />
                    </Grid>
                </Button>
                <Button Classes="GlyphSidebarItem" Classes.active="{Binding IsModsActive}" ToolTip.Tip="{Binding ModsNavTooltipText}" Command="{Binding LoadModsCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <PathIcon Data="{StaticResource BmxIconPuzzle}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ModsNavText}" VerticalAlignment="Center" FontSize="13.5" />
                        <Border Grid.Column="2" MinWidth="20" Height="20" CornerRadius="10" Background="#20FFFFFF">
                            <TextBlock Text="{Binding ModCount}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Button>
                <Button Classes="GlyphSidebarItem" Classes.active="{Binding IsSavesActive}" AutomationProperties.AutomationId="Nav.Saves" ToolTip.Tip="{Binding SavesNavTooltipText}" Command="{Binding OpenSavesSilentCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Grid Width="16" Height="22" VerticalAlignment="Center">
                            <Image Source="/Assets/save-bed-isometric.png"
                                   Width="22"
                                   Height="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding !IsSavesActive}" />
                            <Image Source="/Assets/save-bed-isometric-active.png"
                                   Width="22"
                                   Height="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsSavesActive}" />
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{Binding SavesNavText}" VerticalAlignment="Center" FontSize="13.5" />
                        <Border Grid.Column="2" MinWidth="20" Height="20" CornerRadius="10" Background="#20FFFFFF">
                            <TextBlock Text="{Binding SaveManager.ProfileCount}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Button>
            </StackPanel>

            <StackPanel x:Name="ModSidebarNavigation" Margin="10,18,10,0" Spacing="5" IsVisible="{Binding IsModManagerVisible}">
                <Button Classes="GlyphSidebarItem"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Dashboard"
                        ToolTip.Tip="{Binding ModManagerExitText}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <PathIcon Data="{StaticResource IconArrowLeft}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ModManagerExitText}" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" />
                    </Grid>
                </Button>

                <TextBlock Text="{Binding ModManagerHeaderText}"
                           Margin="12,0,0,6"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#66FFFFFF"
                           IsVisible="{Binding IsSidebarExpanded}" />

                <Button Classes="GlyphSidebarItem" Classes.active="{Binding IsModListPageActive}" ToolTip.Tip="{Binding ModListPageText}" Command="{Binding SelectModManagerPageCommand}" CommandParameter="List">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <PathIcon Data="{StaticResource BmxIconPuzzle}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ModListPageText}" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" />
                        <Border Grid.Column="2" MinWidth="20" Height="20" CornerRadius="10" Background="#20FFFFFF">
                            <TextBlock Text="{Binding ModCount}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Button>
                <Button Classes="GlyphSidebarItem" Classes.active="{Binding IsModDownloadPageActive}" ToolTip.Tip="{Binding ModDownloadPageText}" Command="{Binding SelectModManagerPageCommand}" CommandParameter="Download">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <PathIcon Data="{StaticResource BmxIconDownload}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ModDownloadPageText}" VerticalAlignment="Center" FontSize="13.5" />
                    </Grid>
                </Button>
                <Button Classes="GlyphSidebarItem" Classes.active="{Binding IsModRecommendationPageActive}" ToolTip.Tip="{Binding ModRecommendationPageText}" Command="{Binding SelectModManagerPageCommand}" CommandParameter="Recommendation">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <PathIcon Data="{StaticResource BmxIconGift}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ModRecommendationPageText}" VerticalAlignment="Center" FontSize="13.5" />
                    </Grid>
                </Button>
            </StackPanel>

            <StackPanel x:Name="SettingsSidebarNavigation" Margin="10,18,10,0" Spacing="5" IsVisible="{Binding IsSettingsView}">
                <TextBlock Text="{Binding SettingsHeaderText}"
                           Margin="12,0,0,6"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#66FFFFFF"
                           IsVisible="{Binding IsSidebarExpanded}" />

                <Button Classes="GlyphSidebarItem" Classes.active="{Binding IsSettingsPlayerProfilesActive}" ToolTip.Tip="{Binding SettingsPlayerProfilesTooltipText}" Command="{Binding SelectSettingsCategoryCommand}" CommandParameter="PlayerProfiles">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <PathIcon Data="{StaticResource BmxIconUsers}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SettingsPlayerProfilesText}" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" />
                    </Grid>
                </Button>

                <Button Classes="GlyphSidebarItem" Classes.active="{Binding IsSettingsNavigationActive}" ToolTip.Tip="{Binding SettingsNavigationTooltipText}" Command="{Binding SelectSettingsCategoryCommand}" CommandParameter="Navigation">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <PathIcon Data="{StaticResource BmxIconCompass}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SettingsNavigationText}" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" />
                    </Grid>
                </Button>
                <Button Classes="GlyphSidebarItem" Classes.active="{Binding IsSettingsLaunchActive}" ToolTip.Tip="{Binding SettingsLaunchTooltipText}" Command="{Binding SelectSettingsCategoryCommand}" CommandParameter="Launch">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <PathIcon Data="{StaticResource BmxIconPlay}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SettingsLaunchText}" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" />
                    </Grid>
                </Button>
                <Button Classes="GlyphSidebarItem" Classes.active="{Binding IsSettingsModsActive}" ToolTip.Tip="{Binding ModsNavTooltipText}" Command="{Binding SelectSettingsCategoryCommand}" CommandParameter="Mods">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <PathIcon Data="{StaticResource BmxIconPuzzle}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ModsNavText}" VerticalAlignment="Center" FontSize="13.5" />
                    </Grid>
                </Button>
                <Button Classes="GlyphSidebarItem" Classes.active="{Binding IsSettingsAppearanceActive}" ToolTip.Tip="{Binding SettingsAppearanceTooltipText}" Command="{Binding SelectSettingsCategoryCommand}" CommandParameter="Appearance">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <PathIcon Data="{StaticResource BmxIconPalette}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SettingsAppearanceText}" VerticalAlignment="Center" FontSize="13.5" />
                    </Grid>
                </Button>
                <Button Classes="GlyphSidebarItem" Classes.active="{Binding IsSettingsGraphicsActive}" ToolTip.Tip="{Binding SettingsGraphicsTooltipText}" Command="{Binding SelectSettingsCategoryCommand}" CommandParameter="Graphics">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <PathIcon Data="{StaticResource BmxIconSpark}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SettingsGraphicsText}" VerticalAlignment="Center" FontSize="13.5" />
                    </Grid>
                </Button>
                <Button Classes="GlyphSidebarItem" Classes.active="{Binding IsSettingsStorageActive}" ToolTip.Tip="{Binding SettingsStorageTooltipText}" Command="{Binding SelectSettingsCategoryCommand}" CommandParameter="Storage">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <PathIcon Data="{StaticResource BmxIconDatabase}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SettingsStorageText}" VerticalAlignment="Center" FontSize="13.5" />
                    </Grid>
                </Button>
                <Button Classes="GlyphSidebarItem" Classes.active="{Binding IsSettingsAdvancedActive}" ToolTip.Tip="{Binding SettingsAdvancedTooltipText}" Command="{Binding SelectSettingsCategoryCommand}" CommandParameter="Advanced">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <PathIcon Data="{StaticResource BmxIconSettings}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SettingsAdvancedText}" VerticalAlignment="Center" FontSize="13.5" />
                    </Grid>
                </Button>
                <Button Classes="GlyphSidebarItem" Classes.active="{Binding IsSettingsMoreActive}" ToolTip.Tip="{Binding SettingsMoreTooltipText}" Command="{Binding SelectSettingsCategoryCommand}" CommandParameter="More">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <PathIcon Data="{StaticResource BmxIconMore}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SettingsMoreText}" VerticalAlignment="Center" FontSize="13.5" />
                    </Grid>
                </Button>
            </StackPanel>

            <StackPanel x:Name="LabSidebarNavigation" Margin="10,18,10,0" Spacing="5" IsVisible="{Binding IsLabView}">
                <TextBlock Text="{Binding LabNavText}"
                           Margin="12,0,0,6"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#66FFFFFF"
                           IsVisible="{Binding IsSidebarExpanded}" />

                <Button Classes="GlyphSidebarItem" Classes.active="{Binding IsLabAlchemyActive}" AutomationProperties.AutomationId="Lab.Alchemy" ToolTip.Tip="{Binding LabAlchemyText}" Command="{Binding SelectLabModuleCommand}" CommandParameter="Alchemy">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <PathIcon Data="{StaticResource BmxIconFlask}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding LabAlchemyText}" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" />
                    </Grid>
                </Button>
                <Button Classes="GlyphSidebarItem" Classes.active="{Binding IsLabForgingActive}" AutomationProperties.AutomationId="Lab.Forging" ToolTip.Tip="{Binding LabForgingText}" Command="{Binding SelectLabModuleCommand}" CommandParameter="Forging">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <PathIcon Data="{StaticResource BmxIconHammer}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding LabForgingText}" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" />
                    </Grid>
                </Button>
            </StackPanel>

            <Button x:Name="GameIdentityButton"
                    Grid.Row="1"
                    Margin="10,16,0,0"
                    Width="40"
                    Height="40"
                    Command="{Binding NavigateSilentCommand}"
                    CommandParameter="Dashboard"
                    ToolTip.Tip="Kingdom Come: Deliverance II"
                    AutomationProperties.Name="Kingdom Come: Deliverance II"
                    Padding="1"
                    CornerRadius="12"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center">
                <Grid x:Name="GameIdentityBlock"
                      MinHeight="38"
                      ColumnDefinitions="38,*"
                      ColumnSpacing="0">
                    <Border x:Name="GameIdentityIconFrame"
                            Width="38"
                            Height="38"
                            CornerRadius="6"
                            ClipToBounds="True"
                            BorderThickness="0">
                        <Image Source="/Assets/kcd2-game-icon.png"
                               Stretch="Uniform" />
                    </Border>

                    <TextBlock x:Name="GameIdentityTitle"
                               Grid.Column="1"
                               Text="Kingdom Come: Deliverance II"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               LineHeight="15"
                               IsVisible="{Binding IsSidebarExpanded}" />
                </Grid>
            </Button>

            <StackPanel Grid.Row="3"
                        Margin="10,0,10,14"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Spacing="10">
                <Button Classes="GlyphSidebarItem"
                        Classes.active="{Binding IsDownloadCenterVisible}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Command="{Binding OpenDownloadCenterCommand}"
                        ToolTip.Tip="{Binding DownloadCenterLauncherTooltipText}"
                        AutomationProperties.AutomationId="Sidebar.DownloadQueue"
                        AutomationProperties.Name="{Binding DownloadQueueText}">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12"
                          HorizontalAlignment="Stretch">
                        <PathIcon Data="{StaticResource BmxIconDownload}"
                                  Width="16"
                                  Height="16"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DownloadQueueText}"
                                   VerticalAlignment="Center"
                                   FontSize="13.5"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Button>

                <Button Classes="GlyphSidebarToggleButton"
                        ToolTip.Tip="{Binding SidebarToggleText}"
                        AutomationProperties.Name="{Binding SidebarToggleText}"
                        Click="SidebarToggleButton_OnClick">
                    <Grid>
                        <PathIcon x:Name="SidebarToggleCollapseIcon"
                                  Data="{StaticResource IconArrowLeft}"
                                  Width="12"
                                  Height="12" />
                        <PathIcon x:Name="SidebarToggleExpandIcon"
                                  Data="{StaticResource IconSidebarExpandSolid}"
                                  Width="10"
                                  Height="12"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderTransform="translateX(0.5px)" />
                    </Grid>
                </Button>

                <playerProfiles:PlayerSidebarProfile DataContext="{Binding PlayerProfiles}"
                                                     IsSidebarExpanded="{Binding #Root.DataContext.IsSidebarExpanded}" />
            </StackPanel>
        </Grid>

        <Grid x:Name="LauncherSurface"
              Margin="184,56,0,0"
              ClipToBounds="True"
              Background="Transparent"
              IsVisible="{Binding IsLauncherView}"
              ZIndex="10">
            <StackPanel x:Name="LauncherContentTrack"
                        Margin="32,0,28,32"
                        Spacing="24">
                <StackPanel.RenderTransform>
                    <TranslateTransform Y="0" />
                </StackPanel.RenderTransform>
                <Grid Height="660"
                      IsVisible="{Binding IsLauncherDashboardVisible}">
                    <StackPanel Spacing="14"
                                Width="520"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="0,28,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Padding="10,4" CornerRadius="12" Background="#2EFFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                                <TextBlock Text="{Binding GameGenreText}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                            <Border Padding="10,4" CornerRadius="12" Background="#4D0284C7" BorderBrush="#590284C7" BorderThickness="1">
                                <TextBlock Text="{Binding VerificationText}" FontSize="11" FontWeight="SemiBold" Foreground="#7DD3FC" />
                            </Border>
                        </StackPanel>

                        <TextBlock FontSize="56"
                                   FontWeight="ExtraBold"
                                   LineHeight="58"
                                   LetterSpacing="0"
                                   Foreground="White"
                                   TextAlignment="Left">
                            <Run Text="Kingdom Come:" />
                            <LineBreak />
                            <Run Text="Deliverance II" />
                        </TextBlock>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="12"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left">
                            <Border x:Name="HeroLaunchButtonHost"
                                    Height="48"
                                    CornerRadius="12"
                                    ClipToBounds="True">
                                <Grid>
                                    <Button Classes="GlyphPrimaryButton"
                                            Height="48"
                                            Padding="22,0"
                                            Command="{Binding LaunchGameCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <PathIcon Data="{StaticResource BmxIconPlay}" Width="16" Height="16" />
                                            <TextBlock Text="{Binding PrimaryActionLabel}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <Border x:Name="HeroLaunchHighlight"
                                            Width="96"
                                            Margin="-28,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Stretch"
                                            IsHitTestVisible="False"
                                            IsVisible="{Binding IsLaunchReady}"
                                            Opacity="0"
                                            ZIndex="2">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                                <GradientStop Color="#28FFFFFF" Offset="0.2" />
                                                <GradientStop Color="#82FFFFFF" Offset="0.4" />
                                                <GradientStop Color="#F5FFFFFF" Offset="0.5" />
                                                <GradientStop Color="#82FFFFFF" Offset="0.6" />
                                                <GradientStop Color="#28FFFFFF" Offset="0.8" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <SkewTransform AngleX="-18" />
                                                <TranslateTransform X="-124" />
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Border>
                            <Button Classes="GlyphGlassButton"
                                    Height="48"
                                    Padding="20,0"
                                    Command="{Binding OpenVerificationDialogCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource BmxIconVerified}" Width="15" Height="15" />
                                    <TextBlock Text="{Binding VerifyInstallText}" VerticalAlignment="Center" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                </Grid>

                <Border Height="48"
                        IsVisible="{Binding IsLauncherDashboardVisible}" />
                <Grid x:Name="LauncherDetailsHost"
                      Height="874"
                      Margin="0,-64,0,0"
                      IsVisible="{Binding IsLauncherDashboardVisible}"
                      Opacity="0"
                      RenderTransformOrigin="50%,0%">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                            <TranslateTransform Y="0" />
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <controls:DisposableWorkspaceHost x:Name="LauncherDetailsContentHost"
                                                      Kind="Home"
                                                      HorizontalContentAlignment="Stretch"
                                                      VerticalContentAlignment="Stretch">
                        <controls:DisposableWorkspaceHost.LazyContentTemplate>
                            <DataTemplate x:DataType="vm:MainWindowViewModel">
                                <views:LauncherDetailsView HorizontalContentAlignment="Stretch"
                                                           VerticalContentAlignment="Stretch">
                                    <Grid RowDefinitions="352,244,262" RowSpacing="8">

                    <controls:AdventureProfile Margin="0,64,0,0"
                                               DataContext="{Binding AdventureProfile}" />

                    <Grid Grid.Row="1"
                          ColumnDefinitions="1.05*,0.75*,0.8*"
                          ColumnSpacing="8">
                        <controls:SmoothCornerBorder Classes="LauncherDashboardPanel">
                            <Border Background="Transparent">
                            <Grid>
                            <controls:BackdropReflection Source="{Binding MoreSettings.EffectiveBackdropReflectionSource}"
                                                          IsVisible="{Binding MoreSettings.ShowBackdropReflection}"
                                                         Margin="-24"
                                                         StripeOpacity="0"
                                                         IsHitTestVisible="False">
                                <controls:BackdropReflection.Effect>
                                    <BlurEffect Radius="18" />
                                </controls:BackdropReflection.Effect>
                            </controls:BackdropReflection>
                            <Border Background="#82FFFFFF" IsHitTestVisible="False" />
                            <Grid Margin="18,14" RowDefinitions="Auto,*" RowSpacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource BmxIconSave}"
                                                  Width="15"
                                                  Height="15"
                                                  Foreground="#8A651C" />
                                        <TextBlock Text="{Binding DashboardRecentSavesText}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#18212F" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="LauncherDashboardCommand"
                                            Command="{Binding OpenSavesSilentCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding DashboardManageSavesText}" />
                                            <PathIcon Data="{StaticResource BmxIconArrowRight}" Width="12" Height="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <ItemsControl ItemsSource="{Binding SaveManager.DashboardRecentProfiles}"
                                                  IsVisible="{Binding SaveManager.HasDashboardRecentProfiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="saveManagerModels:SaveProfileListItem">
                                                <Grid Height="56"
                                                      ColumnDefinitions="96,*"
                                                      ColumnSpacing="12"
                                                      Margin="0,0,0,2"
                                                      ToolTip.Tip="{Binding GameSaveTooltip}">
                                                    <controls:SmoothCornerBorder Width="90"
                                                                                 Height="50"
                                                                                 CornerRadius="6"
                                                                                 Background="#DCE7E9EA"
                                                                                 BorderBrush="#C8FFFFFF"
                                                                                 BorderThickness="1"
                                                                                 InsetStroke="True">
                                                        <Grid>
                                                            <Image Source="{Binding ThumbnailImage}"
                                                                   Stretch="UniformToFill"
                                                                   IsVisible="{Binding HasThumbnail}" />
                                                            <PathIcon Data="{StaticResource BmxIconBedSave}"
                                                                      Width="22"
                                                                      Height="22"
                                                                      Foreground="#64748B"
                                                                      IsVisible="{Binding HasNoThumbnail}"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                        </Grid>
                                                    </controls:SmoothCornerBorder>
                                                    <Grid Grid.Column="1"
                                                          RowDefinitions="Auto,Auto"
                                                          VerticalAlignment="Center">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <TextBlock Text="{Binding PrimaryTitle}"
                                                                       FontSize="13.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#18212F"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding PrimaryTitle}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding LastSavedText}"
                                                                       FontSize="11"
                                                                       Foreground="#64748B" />
                                                        </Grid>
                                                        <Grid Grid.Row="1"
                                                              ColumnDefinitions="*,Auto,Auto"
                                                              ColumnSpacing="10"
                                                              Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding LocationSubtitle}"
                                                                       FontSize="11"
                                                                       Foreground="#475569"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding LocationSubtitle}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding SaveTypeText}"
                                                                       FontSize="11"
                                                                       Foreground="#8A651C" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding PlayTimeText}"
                                                                       FontSize="11"
                                                                       Foreground="#64748B" />
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel IsVisible="{Binding SaveManager.HasNoDashboardRecentProfiles}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="8">
                                        <PathIcon Data="{StaticResource BmxIconBedSave}"
                                                  Width="26"
                                                  Height="26"
                                                  Foreground="#64748B"
                                                  HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding DashboardNoRecentSavesText}"
                                                   FontSize="12.5"
                                                   Foreground="#64748B" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            </Grid>
                            </Border>
                        </controls:SmoothCornerBorder>

                        <controls:SmoothCornerBorder Grid.Column="1" Classes="LauncherDashboardPanel">
                            <Border Background="Transparent">
                            <Grid>
                            <controls:BackdropReflection Source="{Binding MoreSettings.EffectiveBackdropReflectionSource}"
                                                          IsVisible="{Binding MoreSettings.ShowBackdropReflection}"
                                                         Margin="-24"
                                                         StripeOpacity="0"
                                                         IsHitTestVisible="False">
                                <controls:BackdropReflection.Effect>
                                    <BlurEffect Radius="18" />
                                </controls:BackdropReflection.Effect>
                            </controls:BackdropReflection>
                            <Border Background="#82FFFFFF" IsHitTestVisible="False" />
                            <Grid Margin="16,13" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="7">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource BmxIconPuzzle}"
                                                  Width="15"
                                                  Height="15"
                                                  Foreground="#8A651C" />
                                        <TextBlock Text="{Binding DashboardModStatusText}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#18212F" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            MinWidth="24"
                                            Height="22"
                                            CornerRadius="11"
                                            Background="#2EE85D68"
                                            BorderBrush="#55E85D68"
                                            BorderThickness="1"
                                            IsVisible="{Binding HasModConflicts}">
                                        <TextBlock Text="{Binding ConflictCount}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#C63F4D"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding DashboardModSummaryText}"
                                           FontSize="11.5"
                                           Foreground="#475569"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding DashboardModSummaryText}" />

                                <Grid Grid.Row="2"
                                      ClipToBounds="True">
                                    <ItemsControl ItemsSource="{Binding ModRows}"
                                                  IsVisible="{Binding HasMods}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ModListItemViewModel">
                                                <Border Classes="LauncherModRow"
                                                        Margin="0,0,0,2"
                                                        ToolTip.Tip="{Binding RootPath}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                                          ColumnSpacing="8">
                                                        <CheckBox Classes="LauncherModCheck"
                                                                  Width="22"
                                                                  Height="22"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CanToggleEnabled}"
                                                                  Command="{Binding #Root.DataContext.SetDashboardModEnabledCommand}"
                                                                  CommandParameter="{Binding}"
                                                                  ToolTip.Tip="{Binding #Root.DataContext.EnableText}" />
                                                        <StackPanel Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Spacing="1">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="11.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#18212F"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding FileSummary}"
                                                                       FontSize="9.5"
                                                                       Foreground="#64748B"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Version}"
                                                                   MaxWidth="64"
                                                                   FontSize="9.5"
                                                                   Foreground="#64748B"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel IsVisible="{Binding !HasMods}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="7">
                                        <PathIcon Data="{StaticResource BmxIconPackage}"
                                                  Width="15"
                                                  Height="15"
                                                  Foreground="#64748B" />
                                        <TextBlock Text="{Binding DashboardNoModsText}"
                                                   FontSize="12"
                                                   Foreground="#475569" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <Button Classes="LauncherDashboardCommand"
                                            HorizontalAlignment="Left"
                                            IsVisible="{Binding HasModConflicts}"
                                            Command="{Binding OpenDashboardModConflictsCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource BmxIconSearch}" Width="12" Height="12" />
                                            <TextBlock Text="{Binding DashboardReviewConflictsText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1"
                                            Classes="LauncherDashboardCommand"
                                            HorizontalAlignment="Right"
                                            Command="{Binding LoadModsCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding DashboardManageModsText}" />
                                            <PathIcon Data="{StaticResource BmxIconArrowRight}" Width="12" Height="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                            </Grid>
                            </Border>
                        </controls:SmoothCornerBorder>

                        <controls:SmoothCornerBorder Grid.Column="2" Classes="LauncherDashboardPanel">
                            <Border Background="Transparent">
                            <Grid>
                                <controls:BackdropReflection Source="{Binding MoreSettings.EffectiveBackdropReflectionSource}"
                                                              IsVisible="{Binding MoreSettings.ShowBackdropReflection}"
                                                             Margin="-24"
                                                             StripeOpacity="0"
                                                             IsHitTestVisible="False">
                                    <controls:BackdropReflection.Effect>
                                        <BlurEffect Radius="18" />
                                    </controls:BackdropReflection.Effect>
                                </controls:BackdropReflection>
                                <Border Background="#82FFFFFF" IsHitTestVisible="False" />
                                <Grid RowDefinitions="Auto,*" RowSpacing="0">
                                    <Border Grid.ColumnSpan="2"
                                            Margin="0"
                                            Padding="14,12,14,10"
                                            ZIndex="2">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                                <GradientStop Color="#E8FFFFFF" Offset="0" />
                                                <GradientStop Color="#D8FFFFFF" Offset="0.62" />
                                                <GradientStop Color="#74FFFFFF" Offset="0.84" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource BmxIconGift}"
                                                      Width="15"
                                                      Height="15"
                                                      Foreground="#8A651C" />
                                            <TextBlock Text="{Binding DailyModRecommendationTitleText}"
                                                       FontSize="14.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#18212F"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                CornerRadius="14"
                                                Background="#72FFFFFF"
                                                BorderBrush="#A8FFFFFF"
                                                BorderThickness="1"
                                                Command="{Binding OpenDailyModRecommendationsCommand}"
                                                ToolTip.Tip="{Binding DailyModRecommendationBrowseText}">
                                            <PathIcon Data="{StaticResource BmxIconArrowRight}"
                                                      Width="12"
                                                      Height="12"
                                                      Foreground="#334155" />
                                        </Button>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.RowSpan="2" ZIndex="1">
                                        <Button Classes="LauncherDailyMod"
                                                Margin="0"
                                                CornerRadius="10"
                                                BorderThickness="0"
                                                IsVisible="{Binding HasDailyModRecommendation}"
                                                Command="{Binding OpenDailyModRecommendationCommand}"
                                                ToolTip.Tip="{Binding DailyModRecommendation.Mod.Name}">
                                            <Grid ClipToBounds="True">
                                                <Border Background="#D8E4E8EB">
                                                    <PathIcon Data="{StaticResource BmxIconPuzzle}"
                                                              Width="30"
                                                              Height="30"
                                                              Foreground="#64748B"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                </Border>
                                                <Image Source="{Binding DailyModRecommendation.Mod.ThumbnailImage}"
                                                       Stretch="UniformToFill"
                                                       IsVisible="{Binding DailyModRecommendation.Mod.HasThumbnail}" />
                                                <Border VerticalAlignment="Top"
                                                        Height="72"
                                                        IsHitTestVisible="False">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                                            <GradientStop Color="#A8FFFFFF" Offset="0" />
                                                            <GradientStop Color="#48FFFFFF" Offset="0.42" />
                                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Border VerticalAlignment="Bottom"
                                                        Padding="26,34,26,12">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                                            <GradientStop Color="#30FFFFFF" Offset="0.38" />
                                                            <GradientStop Color="#68FFFFFF" Offset="0.72" />
                                                            <GradientStop Color="#8CFFFFFF" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <TextBlock Text="{Binding DailyModRecommendation.Mod.Name}"
                                                                   FontSize="18"
                                                                   FontWeight="ExtraBold"
                                                                   Foreground="#18212F"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding DailyModRecommendation.Mod.Name}" />
                                                        <Border Grid.Column="1"
                                                                Height="26"
                                                                Padding="10,0"
                                                                CornerRadius="15"
                                                                Background="#F02F7FC1"
                                                                BorderBrush="#FF77B4E3"
                                                                BorderThickness="1"
                                                                BoxShadow="0 3 10 0 #38205278"
                                                                VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal"
                                                                        Spacing="5"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DailyModRecommendationOpenText}"
                                                                           FontSize="10.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="White"
                                                                           VerticalAlignment="Center" />
                                                                <PathIcon Data="{StaticResource BmxIconExternal}"
                                                                          Width="10"
                                                                          Height="10"
                                                                          Foreground="White" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <Border HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="9,56,9,9"
                                                        Padding="7,3"
                                                        CornerRadius="14"
                                                        Background="#DFFFFFFF"
                                                        BorderBrush="#F2FFFFFF"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding DailyModRecommendationDateText}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="#795819" />
                                                </Border>
                                            </Grid>
                                        </Button>

                                        <StackPanel IsVisible="{Binding HasNoDailyModRecommendation}"
                                                    Margin="16,52,16,16"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="8">
                                            <ProgressBar Width="54"
                                                         Height="3"
                                                         IsIndeterminate="True"
                                                         IsVisible="{Binding IsDailyModRecommendationLoading}" />
                                            <PathIcon Data="{StaticResource BmxIconGift}"
                                                      Width="26"
                                                      Height="26"
                                                      Foreground="#64748B"
                                                      IsVisible="{Binding !IsDailyModRecommendationLoading}"
                                                      HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding DailyModRecommendationStatusText}"
                                                       MaxWidth="210"
                                                       FontSize="11.5"
                                                       LineHeight="16"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Foreground="#64748B" />
                                            <Button Classes="LauncherDashboardCommand"
                                                    Command="{Binding OpenDailyModRecommendationsCommand}"
                                                    HorizontalAlignment="Center"
                                                    IsVisible="{Binding !IsDailyModRecommendationLoading}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding DailyModRecommendationBrowseText}" />
                                                    <PathIcon Data="{StaticResource BmxIconArrowRight}" Width="11" Height="11" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                            </Border>
                        </controls:SmoothCornerBorder>
                    </Grid>

                    <controls:SmoothCornerBorder Grid.Row="2" Classes="LauncherDashboardPanel">
                        <Border Background="Transparent">
                        <Grid>
                        <controls:BackdropReflection Source="{Binding MoreSettings.EffectiveBackdropReflectionSource}"
                                                      IsVisible="{Binding MoreSettings.ShowBackdropReflection}"
                                                     Margin="-24"
                                                     StripeOpacity="0"
                                                     IsHitTestVisible="False">
                            <controls:BackdropReflection.Effect>
                                <BlurEffect Radius="18" />
                            </controls:BackdropReflection.Effect>
                        </controls:BackdropReflection>
                        <Border Background="#82FFFFFF" IsHitTestVisible="False" />
                        <Grid Margin="18,14" RowDefinitions="Auto,*" RowSpacing="12">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconSteam}"
                                              Width="16"
                                              Height="16"
                                              Foreground="#8A651C" />
                                    <TextBlock Text="{Binding DashboardOfficialNewsText}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#18212F" />
                                    <TextBlock Text="{Binding DashboardNewsStatusText}"
                                               FontSize="11"
                                               Foreground="#64748B"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <ProgressBar Grid.Column="1"
                                             Width="42"
                                             Height="3"
                                             IsIndeterminate="True"
                                             IsVisible="{Binding IsGameNewsLoading}"
                                             VerticalAlignment="Center" />
                                <Button Grid.Column="2"
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        CornerRadius="11"
                                        Background="#96FFFFFF"
                                        BorderBrush="#D8FFFFFF"
                                        BorderThickness="1"
                                        Command="{Binding RefreshGameNewsCommand}"
                                        ToolTip.Tip="{Binding DashboardNewsStatusText}">
                                    <PathIcon Data="{StaticResource BmxIconRefresh}"
                                              Width="13"
                                              Height="13"
                                              Foreground="#334155" />
                                </Button>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid IsVisible="{Binding HasGameNews}"
                                      ColumnDefinitions="1.15*,1*"
                                      ColumnSpacing="12">
                                    <Button Classes="LauncherNewsLead"
                                            Command="{Binding OpenGameNewsCommand}"
                                            CommandParameter="{Binding FeaturedGameNews}">
                                        <Grid Margin="8"
                                              ColumnDefinitions="Auto,*"
                                              ColumnSpacing="14">
                                            <controls:SmoothCornerBorder Width="220"
                                                                         CornerRadius="12"
                                                                         Background="#72FFFFFF"
                                                                         BorderBrush="#B8FFFFFF"
                                                                         BorderThickness="1"
                                                                         InsetStroke="True"
                                                                         IsVisible="{Binding FeaturedGameNews.HasImage}">
                                                <Image Source="{Binding FeaturedGameNews.Image}"
                                                       Stretch="UniformToFill" />
                                            </controls:SmoothCornerBorder>
                                            <Grid Grid.Column="1"
                                                  RowDefinitions="Auto,Auto,*,Auto"
                                                  Margin="2,4,10,4">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Border Padding="7,3"
                                                        CornerRadius="6"
                                                        Background="#29D8B871"
                                                        BorderBrush="#45D8B871"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding FeaturedGameNews.Source}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="#795819" />
                                                </Border>
                                                <TextBlock Text="{Binding FeaturedGameNews.PublishedText}"
                                                           FontSize="11"
                                                           Foreground="#64748B"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding FeaturedGameNews.Title}"
                                                       Margin="0,9,0,0"
                                                       FontSize="16.5"
                                                       FontWeight="SemiBold"
                                                       LineHeight="21"
                                                       Foreground="#18212F"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding FeaturedGameNews.Title}" />
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding FeaturedGameNews.Summary}"
                                                       Margin="0,7,0,0"
                                                       FontSize="11.5"
                                                       LineHeight="16"
                                                       Foreground="#475569"
                                                       TextWrapping="Wrap"
                                                       MaxLines="3"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Row="3"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        Margin="0,8,0,0">
                                                <TextBlock Text="{Binding DashboardOpenArticleText}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#72B8F0" />
                                                <PathIcon Data="{StaticResource BmxIconExternal}"
                                                          Width="12"
                                                          Height="12"
                                                          Foreground="#72B8F0" />
                                            </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Button>

                                    <ItemsControl Grid.Column="1"
                                                  ItemsSource="{Binding SecondaryGameNewsItems}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  ClipToBounds="True">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GameNewsItemViewModel">
                                                <Button Classes="LauncherNewsRow"
                                                        Height="45"
                                                        HorizontalAlignment="Stretch"
                                                        ClipToBounds="True"
                                                        Command="{Binding #Root.DataContext.OpenGameNewsCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                                          RowDefinitions="23,18"
                                                          ColumnSpacing="10"
                                                          Margin="6,2">
                                                        <Border Grid.RowSpan="2"
                                                                Width="72"
                                                                Height="41"
                                                                CornerRadius="5"
                                                                Background="#72FFFFFF"
                                                                ClipToBounds="True"
                                                                IsVisible="{Binding HasImage}">
                                                            <Image Source="{Binding Image}"
                                                                   Stretch="UniformToFill" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Title}"
                                                                   FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#253244"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding Title}" />
                                                        <PathIcon Grid.Column="2"
                                                                  Data="{StaticResource BmxIconExternal}"
                                                                  Width="11"
                                                                  Height="11"
                                                                  Foreground="#64748B"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,0,0" />
                                                        <StackPanel Grid.Row="1"
                                                                    Grid.Column="1"
                                                                    Orientation="Horizontal"
                                                                    Spacing="6"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Source}"
                                                                       FontSize="10.5"
                                                                       Foreground="#8A651C" />
                                                            <TextBlock Text="{Binding PublishedText}"
                                                                       FontSize="10.5"
                                                                       Foreground="#64748B" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <StackPanel IsVisible="{Binding !HasGameNews}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="9">
                                    <PathIcon Data="{StaticResource BmxIconNewspaper}"
                                              Width="28"
                                              Height="28"
                                              Foreground="#64748B"
                                              HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding DashboardNewsStatusText}"
                                               FontSize="12"
                                               Foreground="#64748B" />
                                    <Button Classes="LauncherDashboardCommand"
                                            Command="{Binding RefreshGameNewsCommand}"
                                            HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource BmxIconRefresh}" Width="12" Height="12" />
                                            <TextBlock Text="{Binding DashboardOfficialNewsText}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        </Grid>
                        </Border>
                    </controls:SmoothCornerBorder>
                                    </Grid>
                                </views:LauncherDetailsView>
                            </DataTemplate>
                        </controls:DisposableWorkspaceHost.LazyContentTemplate>
                    </controls:DisposableWorkspaceHost>
                </Grid>

                <controls:DisposableWorkspaceHost x:Name="SaveWorkspaceHost" Kind="Saves">
                    <controls:DisposableWorkspaceHost.LazyContentTemplate>
                        <DataTemplate x:DataType="vm:MainWindowViewModel">
                <Grid IsVisible="{Binding IsSavesActive}"
                      Margin="0,32,0,18"
                      ColumnDefinitions="*">
                    <controls:StripedCardBorder Classes="ModOpsWorkspacePanel"
                                                IsStripeMotionEnabled="{Binding !ReduceMotion}"
                                                StripeOpacity="0.13"
                                                StripeSpeed="14">
                        <saveManagerViews:SaveManagerView DataContext="{Binding SaveManager}" />
                    </controls:StripedCardBorder>

                </Grid>
                        </DataTemplate>
                    </controls:DisposableWorkspaceHost.LazyContentTemplate>
                </controls:DisposableWorkspaceHost>

                <controls:DisposableWorkspaceHost x:Name="ModWorkspaceHost" Kind="Mods">
                    <controls:DisposableWorkspaceHost.LazyContentTemplate>
                        <DataTemplate x:DataType="vm:MainWindowViewModel">
                            <Grid>
                <ScrollViewer x:Name="ModListPageScrollViewer"
                              IsVisible="{Binding IsModListPageVisible}"
                              Margin="0,32,0,18"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid ColumnDefinitions="*">
                    <controls:StripedCardBorder Classes="ModOpsWorkspacePanel"
                                                IsStripeMotionEnabled="{Binding !ReduceMotion}">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                            <controls:StripedCardBorder Classes="ModOpsHeaderStrip ModOpsCommandBar">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" CornerRadius="6" Background="#10253E" BorderBrush="#2563EB" BorderThickness="1" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource BmxIconPuzzle}" Width="15" Height="15" Foreground="#93C5FD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding ModManagerTitleText}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F8FAFC"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ModCount}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding InstalledText}" FontSize="11" Foreground="#A6ADBB" VerticalAlignment="Center" />
                                            <Border Width="1" Height="14" Background="#303640" Margin="4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding EnabledModCount}" FontSize="12" FontWeight="SemiBold" Foreground="#86EFAC" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding EnabledWithSeparatorText}" FontSize="11" Foreground="#A6ADBB" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DisabledModCount}" FontSize="12" FontWeight="SemiBold" Foreground="#93C5FD" Margin="4,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DisabledText}" FontSize="11" Foreground="#A6ADBB" VerticalAlignment="Center" />
                                            <Border Width="1" Height="14" Background="#303640" Margin="4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ConflictCount}" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ConflictsLabelText}" FontSize="11" Foreground="#A6ADBB" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Classes="ModOpsPrimaryButton"
                                                Command="{Binding AddModCommand}"
                                                ToolTip.Tip="{Binding AddLocalModTooltipText}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="{StaticResource BmxIconAdd}" Width="13" Height="13" />
                                                <TextBlock Text="{Binding AddText}" FontSize="11.5" />
                                                </StackPanel>
                                        </Button>
                                        <Button Classes="ModOpsFlatButton"
                                                Command="{Binding ImportLocalModPackCommand}"
                                                ToolTip.Tip="{Binding ImportModPackText}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="{StaticResource BmxIconArchive}" Width="13" Height="13" />
                                                <TextBlock Text="{Binding ImportModPackText}" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="ModOpsFlatButton"
                                                Command="{Binding OpenModsFolderCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="{StaticResource BmxIconFolder}" Width="13" Height="13" />
                                                <TextBlock Text="{Binding DirectoryText}" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="ModOpsFlatButton"
                                                Command="{Binding LoadModsCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="{StaticResource BmxIconRefresh}" Width="13" Height="13" />
                                                <TextBlock Text="{Binding RefreshText}" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </controls:StripedCardBorder>

                            <Grid Grid.Row="1" ColumnDefinitions="1.35*,0.65*" ColumnSpacing="10" MinHeight="0">
                                <controls:StripedCardBorder Classes="ModOpsSurface ModOpsListSurface">
                                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding ModListPageText}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Classes="ModOpsToolbarButton"
                                                        Command="{Binding CreateModGroupCommand}"
                                                        IsEnabled="{Binding !IsModGroupNameSaving}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <PathIcon Data="{StaticResource BmxIconFolderAdd}" Width="12" Height="12" />
                                                        <TextBlock Text="{Binding CreateModGroupText}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="ModOpsToolbarButton" Command="{Binding EnableAllModsCommand}" Content="{Binding EnableAllText}" />
                                                <Button Classes="ModOpsToolbarButton" Command="{Binding DisableAllModsCommand}" Content="{Binding DisableAllText}" />
                                                <Button Classes="ModOpsToolbarButton"
                                                        Command="{Binding AutoFixAllModConflictsCommand}"
                                                        IsEnabled="{Binding HasModConflicts}"
                                                        ToolTip.Tip="{Binding AutoFixAllModConflictsHintText}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <PathIcon Data="{StaticResource BmxIconRefresh}" Width="12" Height="12" />
                                                        <TextBlock Text="{Binding AutoFixAllModConflictsText}" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <controls:StripedCardBorder Grid.Row="1" Classes="ModOpsListHeader">
                                            <Grid ColumnDefinitions="58,76,*,68,96,96" ColumnSpacing="10">
                                                <TextBlock Text="{Binding OrderText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#A6ADBB" />
                                                <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#A6ADBB" />
                                                <TextBlock Grid.Column="2" Text="{Binding NameText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#A6ADBB" />
                                                <TextBlock Grid.Column="3" Text="{Binding VersionText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#A6ADBB" />
                                                <TextBlock Grid.Column="4" Text="{Binding IdText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#A6ADBB" />
                                                <TextBlock Grid.Column="5" Text="{Binding ActionsText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#A6ADBB" />
                                            </Grid>
                                        </controls:StripedCardBorder>

                                        <Grid Grid.Row="2"
                                              ColumnDefinitions="*,16"
                                              ColumnSpacing="8">
                                            <ListBox x:Name="ModListRowsListBox"
                                                     Grid.Column="0"
                                                     Classes="ModOpsListBox"
                                                     ItemsSource="{Binding InstalledModGroups}"
                                                     VerticalAlignment="Top"
                                                     MaxHeight="620"
                                                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.Template>
                                                    <ControlTemplate>
                                                        <Border x:Name="ModListRowsScrollHost"
                                                                ClipToBounds="{TemplateBinding ClipToBounds}"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="{TemplateBinding CornerRadius}">
                                                            <ScrollViewer Name="PART_ScrollViewer"
                                                                          HorizontalScrollBarVisibility="Disabled"
                                                                          VerticalScrollBarVisibility="Hidden"
                                                                          IsScrollChainingEnabled="False">
                                                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                                                                Margin="{TemplateBinding Padding}" />
                                                            </ScrollViewer>
                                                        </Border>
                                                    </ControlTemplate>
                                                </ListBox.Template>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:InstalledModGroupViewModel">
                                                        <StackPanel Margin="0,0,0,12"
                                                                     Spacing="6"
                                                                     DragDrop.AllowDrop="True"
                                                                     DragDrop.DragOver="ModGroup_OnDragOver"
                                                                     DragDrop.DragLeave="ModGroup_OnDragLeave"
                                                                     DragDrop.Drop="ModGroup_OnDrop">
                                                            <Border Classes="DownloadCenterQueueGroupHeader"
                                                                    Classes.modpack="{Binding IsModPack}"
                                                                    Classes.dragover="{Binding IsDropTargetActive}">
                                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                                                                    <StackPanel Spacing="2" MinWidth="0">
                                                                        <TextBlock Text="{Binding TitleText}"
                                                                                   FontSize="12.5"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#F8FAFC"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Cursor="IBeam"
                                                                                   ToolTip.Tip="{Binding #Root.DataContext.RenameModGroupTooltipText}"
                                                                                   DoubleTapped="ModGroupTitle_OnDoubleTapped"
                                                                                   IsVisible="{Binding !IsNameEditing}" />
                                                                        <TextBox Classes="ModOpsTextBox"
                                                                                 Text="{Binding #Root.DataContext.ModGroupNameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                 MaxLength="48"
                                                                                 MinWidth="180"
                                                                                 MaxWidth="300"
                                                                                 Height="30"
                                                                                 Padding="8,2"
                                                                                 FontSize="12.5"
                                                                                 VerticalContentAlignment="Center"
                                                                                 IsEnabled="{Binding !#Root.DataContext.IsModGroupNameSaving}"
                                                                                 IsVisible="{Binding IsNameEditing}"
                                                                                 KeyDown="ModGroupNameEditor_OnKeyDown"
                                                                                 LostFocus="ModGroupNameEditor_OnLostFocus" />
                                                                        <TextBlock Text="{Binding KindText}"
                                                                                   FontSize="10"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#60A5FA" />
                                                                    </StackPanel>
                                                                    <Border Grid.Column="1"
                                                                            Classes="ModOpsPill"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding CountText}"
                                                                                   FontSize="10.5"
                                                                                    Foreground="#B8C0CC" />
                                                                    </Border>
                                                                    <Button Grid.Column="2"
                                                                            Classes="ModOpsToolbarButton"
                                                                            Width="28"
                                                                            Padding="0"
                                                                            IsEnabled="{Binding HasItems}"
                                                                            Command="{Binding #Root.DataContext.EnableModGroupCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip.Tip="{Binding #Root.DataContext.EnableAllText}">
                                                                        <PathIcon Data="{StaticResource BmxIconPlay}" Width="12" Height="12" />
                                                                    </Button>
                                                                    <Button Grid.Column="3"
                                                                            Classes="ModOpsToolbarButton"
                                                                            Width="28"
                                                                            Padding="0"
                                                                            IsEnabled="{Binding HasItems}"
                                                                            Command="{Binding #Root.DataContext.DisableModGroupCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip.Tip="{Binding #Root.DataContext.DisableAllText}">
                                                                        <PathIcon Data="{StaticResource BmxIconStop}" Width="12" Height="12" />
                                                                    </Button>
                                                                    <Button Grid.Column="4"
                                                                            Classes="ModOpsToolbarButton"
                                                                            Width="28"
                                                                            Padding="0"
                                                                            IsVisible="{Binding IsCustom}"
                                                                            IsEnabled="{Binding !#Root.DataContext.IsModGroupNameSaving}"
                                                                            Click="ModGroupAddButton_OnClick"
                                                                            ToolTip.Tip="{Binding #Root.DataContext.AddModToGroupText}">
                                                                        <PathIcon Data="{StaticResource BmxIconAdd}" Width="12" Height="12" />
                                                                    </Button>
                                                                    <Button Grid.Column="5"
                                                                            Classes="ModOpsToolbarButton"
                                                                            Width="28"
                                                                            Padding="0"
                                                                            IsVisible="{Binding !IsNameEditing}"
                                                                            Command="{Binding #Root.DataContext.OpenModGroupNameEditorCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip.Tip="{Binding #Root.DataContext.RenameModGroupTooltipText}">
                                                                        <PathIcon Data="{StaticResource BmxIconEdit}" Width="12" Height="12" />
                                                                    </Button>
                                                                    <Button Grid.Column="6"
                                                                            Classes="ModOpsToolbarButton"
                                                                            Width="28"
                                                                            Padding="0"
                                                                            IsVisible="{Binding CanDelete}"
                                                                            IsEnabled="{Binding !#Root.DataContext.IsModGroupNameSaving}"
                                                                            Command="{Binding #Root.DataContext.DeleteModGroupCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip.Tip="{Binding #Root.DataContext.DeleteModGroupTooltipText}">
                                                                        <PathIcon Data="{StaticResource BmxIconDelete}" Width="12" Height="12" />
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                            <Border Classes="ModOpsNotice"
                                                                    Classes.dragover="{Binding IsDropTargetActive}"
                                                                    IsVisible="{Binding IsEmpty}"
                                                                    Height="42"
                                                                    Padding="10,0">
                                                                <TextBlock Text="{Binding #Root.DataContext.EmptyModGroupDropText}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#93C5FD"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <ItemsControl ItemsSource="{Binding Items}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:ModListItemViewModel">
                                                                        <controls:StripedCardBorder Classes="ModOpsListRow"
                                                                                                    controls:VisualResourceLifetime.IsEnabled="True"
                                                                                                    Classes.selected="{Binding IsSelected}"
                                                                                                    Classes.dragover="{Binding IsOrderDropTargetActive}"
                                                                                                    Cursor="Hand"
                                                                                                    PointerPressed="ModListRow_OnPointerPressed"
                                                                                                    PointerMoved="ModListRow_OnPointerMoved"
                                                                                                    PointerReleased="ModListRow_OnPointerReleased"
                                                                                                    PointerCaptureLost="ModListRow_OnPointerCaptureLost"
                                                                                                    DragDrop.AllowDrop="True"
                                                                                                    DragDrop.DragOver="ModListRow_OnDragOver"
                                                                                                    DragDrop.DragLeave="ModListRow_OnDragLeave"
                                                                                                    DragDrop.Drop="ModListRow_OnDrop"
                                                                                                    ToolTip.Tip="{Binding #Root.DataContext.DragModToGroupTooltipText}"
                                                                                                    Margin="0,0,0,7">
                                                            <Grid ColumnDefinitions="58,76,*,68,96,96" ColumnSpacing="10">
                                                            <Border Classes="ModOpsIconTile" VerticalAlignment="Center">
                                                                <Grid ClipToBounds="True">
                                                                    <Image Source="{Binding CoverImage}"
                                                                           Stretch="UniformToFill"
                                                                           IsVisible="{Binding HasCoverImage}" />
                                                                    <PathIcon Data="{StaticResource BmxIconPuzzle}"
                                                                              Width="18"
                                                                              Height="18"
                                                                              Foreground="#B8C0CC"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              IsVisible="{Binding HasNoCoverImage}" />
                                                                    <Border MinWidth="24"
                                                                            Height="18"
                                                                            CornerRadius="8"
                                                                            Background="#15243D"
                                                                            BorderBrush="#2563EB"
                                                                            BorderThickness="1"
                                                                            Padding="5,0"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Bottom"
                                                                            Margin="0,0,-4,-4">
                                                                        <TextBlock Text="{Binding LoadOrder}"
                                                                                   FontSize="10"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="#93C5FD"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" />
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                            <CheckBox Grid.Column="1"
                                                                      x:CompileBindings="False"
                                                                      IsChecked="{Binding IsEnabled}"
                                                                      IsEnabled="{Binding CanToggleEnabled}"
                                                                      Content="{Binding DataContext.EnableText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      FontSize="11"
                                                                      Foreground="#E5E7EB"
                                                                      VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               FontSize="13.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#F8FAFC"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <Border Classes="ModOpsPill"
                                                                            IsVisible="{Binding IsAssignedToCustomGroup}"
                                                                            Height="20"
                                                                            Padding="6,0"
                                                                            HorizontalAlignment="Left"
                                                                            Background="#15243D"
                                                                            BorderBrush="#2563EB">
                                                                        <TextBlock Text="{Binding DataContext.CustomGroupBadgeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                   x:CompileBindings="False"
                                                                                   FontSize="10"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#93C5FD"
                                                                                   VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding FileSummary}"
                                                                               FontSize="11"
                                                                               Foreground="#A6ADBB"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <StackPanel IsVisible="{Binding HasMissingRequirements}"
                                                                            Spacing="4">
                                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                                        <PathIcon Data="{StaticResource BmxIconWarning}"
                                                                                  Width="12"
                                                                                  Height="12"
                                                                                  Foreground="#FBBF24"
                                                                                  VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding MissingRequirementsSummary}"
                                                                                   FontSize="10.5"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#FCD34D"
                                                                                   TextWrapping="Wrap" />
                                                                    </Grid>
                                                                    <ItemsControl ItemsSource="{Binding MissingRequirements}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel Orientation="Horizontal" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:NexusModRequirementViewModel">
                                                                                <Button Classes="ModOpsFlatButton"
                                                                                        Height="28"
                                                                                        MaxWidth="220"
                                                                                        Margin="0,0,6,4"
                                                                                        Padding="8,0"
                                                                                        Command="{Binding #Root.DataContext.OpenNexusModRequirementDetailsCommand}"
                                                                                        CommandParameter="{Binding}"
                                                                                        IsEnabled="{Binding HasDetailsUrl}"
                                                                                        ToolTip.Tip="{Binding #Root.DataContext.NexusModRequirementDetailsText}">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                                        <TextBlock Text="{Binding Name}"
                                                                                                   MaxWidth="170"
                                                                                                   FontSize="10.5"
                                                                                                   TextTrimming="CharacterEllipsis"
                                                                                                   VerticalAlignment="Center" />
                                                                                        <PathIcon Data="{StaticResource BmxIconExternal}"
                                                                                                  Width="11"
                                                                                                  Height="11"
                                                                                                  VerticalAlignment="Center" />
                                                                                    </StackPanel>
                                                                                </Button>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding ConflictSummary}"
                                                                           IsVisible="{Binding IsConflicted}"
                                                                           FontSize="11"
                                                                           Foreground="#93C5FD"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding ConflictOutcomeSummary}"
                                                                           IsVisible="{Binding HasConflictOutcomeSummary}"
                                                                           FontSize="11"
                                                                           Foreground="#86EFAC"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding Version}"
                                                                       FontSize="11"
                                                                       Foreground="#A6ADBB"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Border Grid.Column="4"
                                                                    Classes="ModOpsPill"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Id}"
                                                                           FontSize="10.5"
                                                                           Foreground="#B8C0CC"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="112"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="5"
                                                                        x:CompileBindings="False"
                                                                        Orientation="Horizontal"
                                                                        Spacing="6"
                                                                        VerticalAlignment="Center">
                                                                <Button Classes="ModOpsToolbarButton"
                                                                        Width="28"
                                                                        Padding="0"
                                                                        IsVisible="{Binding IsAssignedToCustomGroup}"
                                                                        IsEnabled="{Binding !DataContext.IsModGroupNameSaving, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        Command="{Binding DataContext.ReturnModToAutomaticGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip.Tip="{Binding DataContext.ReturnToAutomaticGroupTooltipText, RelativeSource={RelativeSource AncestorType=Window}}">
                                                                    <PathIcon Data="{StaticResource BmxIconUndo}" Width="12" Height="12" />
                                                                </Button>
                                                                <Button Classes="ModOpsFlatButton"
                                                                        Height="28"
                                                                        Padding="10,0"
                                                                        Command="{Binding DataContext.ViewModDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="{Binding DataContext.DetailsText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <Button Classes="ModOpsDangerButton"
                                                                        IsVisible="{Binding CanDelete}"
                                                                        Height="28"
                                                                        Padding="10,0"
                                                                        Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip.Tip="{Binding DataContext.DeleteText, RelativeSource={RelativeSource AncestorType=Window}}">
                                                                    <PathIcon Data="{StaticResource BmxIconDelete}" Width="12" Height="12" />
                                                                </Button>
                                                                <Border IsVisible="{Binding IsBuiltIn}"
                                                                        Height="28"
                                                                        Padding="10,0"
                                                                        CornerRadius="6"
                                                                        Background="#22262E"
                                                                        BorderBrush="#3A404B"
                                                                        BorderThickness="1">
                                                                    <TextBlock Text="{Binding DataContext.BuiltInText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#A6ADBB"
                                                                               VerticalAlignment="Center" />
                                                                </Border>
                                                            </StackPanel>
                                                            </Grid>
                                                                        </controls:StripedCardBorder>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Border x:Name="ModListRowsScrollTrack"
                                                    Grid.Column="1"
                                                    Width="16"
                                                    CornerRadius="6"
                                                    Background="#14171D"
                                                    ClipToBounds="True"
                                                    PointerPressed="ModListRowsScrollTrack_OnPointerPressed"
                                                    PointerMoved="ModListRowsScrollTrack_OnPointerMoved"
                                                    PointerReleased="ModListRowsScrollTrack_OnPointerReleased"
                                                    PointerCaptureLost="ModListRowsScrollTrack_OnPointerCaptureLost">
                                                <Border x:Name="ModListRowsScrollThumb"
                                                        Width="12"
                                                        Height="56"
                                                        CornerRadius="6"
                                                        Background="#2563EB"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Top"
                                                        BoxShadow="0 2 8 0 #4D2563EB"
                                                        PointerPressed="ModListRowsScrollThumb_OnPointerPressed"
                                                        PointerMoved="ModListRowsScrollThumb_OnPointerMoved"
                                                        PointerReleased="ModListRowsScrollThumb_OnPointerReleased"
                                                        PointerCaptureLost="ModListRowsScrollThumb_OnPointerCaptureLost">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform Y="0" />
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </controls:StripedCardBorder>

                                <controls:StripedCardBorder Grid.Column="1"
                                                            Classes="ModOpsSurface ModOpsInspectorSurface"
                                                            MinHeight="0"
                                                            VerticalAlignment="Stretch">
                                    <ScrollViewer x:Name="ModInspectorScrollViewer"
                                                  VerticalScrollBarVisibility="Visible"
                                                  HorizontalScrollBarVisibility="Disabled">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                          RowSpacing="12"
                                          Margin="0,0,4,0">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding ModDetailText}" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                            <TextBlock Text="{Binding SelectedModDetailText}" FontSize="10.5" Foreground="#A6ADBB" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <ContentControl Grid.Row="1"
                                                        Height="150"
                                                        HorizontalContentAlignment="Stretch"
                                                        Content="{Binding SelectedMod}">
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate x:DataType="vm:ModListItemViewModel">
                                                    <Border CornerRadius="6"
                                                            Background="#272C34"
                                                            BorderBrush="#343943"
                                                            BorderThickness="1"
                                                            ClipToBounds="True"
                                                            controls:VisualResourceLifetime.IsEnabled="True">
                                                        <Grid>
                                                            <Image Source="{Binding CoverImage}"
                                                                   Stretch="UniformToFill"
                                                                   IsVisible="{Binding HasCoverImage}" />
                                                            <StackPanel Spacing="6"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        IsVisible="{Binding HasNoCoverImage}">
                                                                <PathIcon Data="{StaticResource BmxIconPuzzle}"
                                                                          Width="24"
                                                                          Height="24"
                                                                          Foreground="#B8C0CC"
                                                                          HorizontalAlignment="Center" />
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#A6ADBB"
                                                                           TextAlignment="Center"
                                                                           TextWrapping="Wrap"
                                                                           MaxWidth="260" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>

                                        <StackPanel Grid.Row="2" Spacing="8">
                                            <Border Classes="ModOpsConflictSummary"
                                                    IsVisible="{Binding IsSelectedModConflictStatusVisible}">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <Border Classes="ModOpsConflictStatusDot"
                                                            Background="{Binding SelectedModConflictIndicatorBrush}" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{Binding SelectedModConflictHeadingText}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                                        <TextBlock Text="{Binding SelectedModConflictText}" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <controls:StripedCardBorder Classes="ModOpsNotice InspectorSection">
                                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <TextBlock Text="{Binding ConflictDetailsText}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1"
                                                                Classes="ModOpsPrimaryButton"
                                                                Height="30"
                                                                MinWidth="96"
                                                                Padding="10,0"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding AutoFixSelectedModConflictsCommand}"
                                                                IsEnabled="{Binding HasSelectedModConflictRepairOpportunity}"
                                                                IsVisible="{Binding HasSelectedModConflictDetails}"
                                                                ToolTip.Tip="{Binding AutoFixSelectedModConflictsHintText}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                                <PathIcon Data="{StaticResource BmxIconRefresh}" Width="11" Height="11" />
                                                                <TextBlock Text="{Binding AutoFixSelectedModConflictsText}" FontSize="11" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>

                                                    <Border Grid.Row="1"
                                                            Classes="ModOpsConflictEmpty"
                                                            IsVisible="{Binding HasNoSelectedModConflictDetails}">
                                                        <TextBlock Text="{Binding SelectedModConflictDetailsEmptyText}"
                                                                   FontSize="10.5"
                                                                   Foreground="#94A3B8"
                                                                   TextWrapping="Wrap" />
                                                    </Border>

                                                    <ItemsControl Grid.Row="2"
                                                                  ItemsSource="{Binding SelectedModConflictDetails}"
                                                                  IsVisible="{Binding HasSelectedModConflictDetails}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ModConflictDetailViewModel">
                                                                    <Border Classes="ModOpsConflictDetail" Margin="0,0,0,6">
                                                                        <StackPanel Spacing="6">
                                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                                <TextBlock Text="{Binding OutcomeTitleText}"
                                                                                           FontSize="12"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="#F8FAFC"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           VerticalAlignment="Center" />
                                                                                <Border Grid.Column="1"
                                                                                        Classes="ModOpsConflictRolePill"
                                                                                        VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding SelectedModRoleText}"
                                                                                               FontSize="10"
                                                                                               FontWeight="SemiBold"
                                                                                               Foreground="#93C5FD"
                                                                                               VerticalAlignment="Center" />
                                                                                </Border>
                                                                            </Grid>

                                                                            <Border Classes="ModOpsConflictFlow">
                                                                                <Grid ColumnDefinitions="1*,28,1*" ColumnSpacing="6">
                                                                                    <StackPanel Spacing="2">
                                                                                        <TextBlock Text="{Binding OverriddenModsLabelText}" FontSize="9.5" FontWeight="SemiBold" Foreground="#FCA5A5" />
                                                                                        <TextBlock Text="{Binding OverriddenModsText}" FontSize="11" FontWeight="SemiBold" Foreground="#F8FAFC" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                                                    </StackPanel>
                                                                                    <PathIcon Grid.Column="1"
                                                                                              Data="{StaticResource BmxIconArrowRight}"
                                                                                              Width="12"
                                                                                              Height="12"
                                                                                              Foreground="#93C5FD"
                                                                                              HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center" />
                                                                                    <StackPanel Grid.Column="2" Spacing="2">
                                                                                        <TextBlock Text="{Binding EffectiveModLabelText}" FontSize="9.5" FontWeight="SemiBold" Foreground="#86EFAC" />
                                                                                        <TextBlock Text="{Binding EffectiveModText}" FontSize="11" FontWeight="SemiBold" Foreground="#F8FAFC" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </Border>

                                                                            <Border Classes="ModOpsConflictPath">
                                                                                <TextBlock Text="{Binding NormalizedVirtualPath}"
                                                                                           FontSize="10"
                                                                                           Foreground="#CBD5E1"
                                                                                           TextWrapping="NoWrap"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           ToolTip.Tip="{Binding NormalizedVirtualPath}" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </controls:StripedCardBorder>
                                        </StackPanel>

                                        <controls:StripedCardBorder Grid.Row="3" Classes="ModOpsNotice InspectorSection">
                                            <StackPanel Spacing="7">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <PathIcon Data="{StaticResource BmxIconFolderOpen}"
                                                              Width="13"
                                                              Height="13"
                                                              Foreground="#93C5FD"
                                                              VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ModGroupAssignmentLabelText}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#F8FAFC"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <ComboBox Classes="ModOpsComboBox"
                                                              Height="34"
                                                              ItemsSource="{Binding InstalledModGroupOptions}"
                                                              SelectedItem="{Binding SelectedModGroupOption}"
                                                              IsEnabled="{Binding HasMods}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:InstalledModGroupOptionViewModel">
                                                                <TextBlock Text="{Binding TitleText}"
                                                                           Foreground="#E5E7EB"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <Button Grid.Column="1"
                                                            Classes="ModOpsPrimaryButton"
                                                            Height="34"
                                                            MinWidth="64"
                                                            Padding="12,0"
                                                            Command="{Binding MoveSelectedModToGroupCommand}"
                                                            Content="{Binding MoveToModGroupText}" />
                                                </Grid>
                                            </StackPanel>
                                        </controls:StripedCardBorder>

                                        <Border Grid.Row="4" Height="1" Background="#2C3038" />

                                        <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                            <Button Classes="ModOpsPrimaryButton"
                                                    Height="38"
                                                    HorizontalAlignment="Stretch"
                                                    Command="{Binding ViewModDetailsCommand}"
                                                    CommandParameter="{Binding SelectedMod}"
                                                    IsEnabled="{Binding HasMods}">
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                    <PathIcon Data="{StaticResource BmxIconExternal}" Width="13" Height="13" />
                                                    <TextBlock Text="{Binding DetailsText}" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Classes="ModOpsFlatButton"
                                                    Height="36"
                                                    Width="38"
                                                    Padding="0"
                                                    ToolTip.Tip="{Binding OrderText}"
                                                    Command="{Binding MoveSelectedModUpCommand}">
                                                <PathIcon Data="{StaticResource BmxIconArrowUp}" Width="13" Height="13" Foreground="#B8C0CC" />
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Classes="ModOpsFlatButton"
                                                    Height="36"
                                                    Width="38"
                                                    Padding="0"
                                                    ToolTip.Tip="{Binding OrderText}"
                                                    Command="{Binding MoveSelectedModDownCommand}">
                                                <PathIcon Data="{StaticResource BmxIconArrowDown}" Width="13" Height="13" Foreground="#B8C0CC" />
                                            </Button>
                                            <Button Grid.Column="3"
                                                    Classes="ModOpsDangerButton"
                                                    Height="36"
                                                    Width="38"
                                                    Padding="0"
                                                    ToolTip.Tip="{Binding DeleteSelectedModTooltipText}"
                                                    Command="{Binding DeleteSelectedModCommand}"
                                                    IsEnabled="{Binding SelectedMod.CanDelete}">
                                                <PathIcon Data="{StaticResource BmxIconDelete}" Width="13" Height="13" Foreground="#FCA5A5" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                    </ScrollViewer>
                                </controls:StripedCardBorder>
                            </Grid>
                        </Grid>
                    </controls:StripedCardBorder>
                    </Grid>
                </ScrollViewer>

                <Grid IsVisible="{Binding IsModDownloadPageVisible}"
                      Margin="0,32,0,18"
                      ColumnDefinitions="*"
                      ColumnSpacing="8">
                <ScrollViewer x:Name="ModDownloadPageScrollViewer"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              PointerWheelChanged="ModDownloadPageScrollViewer_OnPointerWheelChanged">
                    <Grid x:Name="ModDownloadPageHost">
                        <controls:StripedCardBorder Classes="ModOpsWorkspacePanel"
                                                    IsStripeMotionEnabled="{Binding !ReduceMotion}">
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                            <controls:StripedCardBorder Classes="ModOpsHeaderStrip ModOpsCommandBar">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" CornerRadius="6" Background="#10253E" BorderBrush="#2563EB" BorderThickness="1" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource BmxIconDownload}" Width="15" Height="15" Foreground="#93C5FD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding ModDownloadPageText}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F8FAFC"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding NexusStatusText}"
                                                   FontSize="11"
                                                   Foreground="#A6ADBB"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="420" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="ModOpsPrimaryButton"
                                            Command="{Binding OpenModsFolderCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="{StaticResource BmxIconFolder}" Width="14" Height="14" />
                                            <TextBlock Text="{Binding OpenDirectoryText}" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </controls:StripedCardBorder>

                            <controls:StripedCardBorder Grid.Row="1" Classes="ModOpsHeaderStrip ModOpsSearchBar">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <WrapPanel ItemSpacing="10" LineSpacing="10">
                                        <ComboBox Classes="ModOpsComboBox"
                                                  ItemsSource="{Binding ModDownloadSources}"
                                                  SelectedItem="{Binding SelectedModDownloadSource}"
                                                  Width="170"
                                                  Height="38">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ModDownloadSourceOptionViewModel">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Grid Width="420" Height="38">
                                            <TextBox Classes="ModOpsTextBox"
                                                     Watermark="{Binding ModSearchWatermarkText}"
                                                     Text="{Binding NexusSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="38,0,42,0"
                                                     Height="38">
                                                <TextBox.KeyBindings>
                                                    <KeyBinding Gesture="Enter" Command="{Binding SubmitModDownloadSearchCommand}" />
                                                </TextBox.KeyBindings>
                                            </TextBox>
                                            <PathIcon Data="{StaticResource BmxIconSearch}"
                                                      Width="14"
                                                      Height="14"
                                                      Foreground="#6B7280"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Margin="14,0,0,0"
                                                      IsHitTestVisible="False" />
                                            <Button Classes="ModOpsSearchClearButton"
                                                    Width="28"
                                                    Height="28"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,5,0"
                                                    IsVisible="{Binding HasModSearchQuery}"
                                                    IsEnabled="{Binding CanSearchModDownloads}"
                                                    Command="{Binding ClearModDownloadSearchCommand}"
                                                    ToolTip.Tip="{Binding ClearText}">
                                                <PathIcon Data="{StaticResource BmxIconClose}"
                                                          Width="12"
                                                          Height="12"
                                                          Foreground="#EF4444"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Button>
                                        </Grid>
                                    </WrapPanel>
                                    <Button Grid.Column="1"
                                            Classes="ModOpsPrimaryButton"
                                            Height="38"
                                            Padding="16,0"
                                            IsEnabled="{Binding CanSearchModDownloads}"
                                            Command="{Binding SubmitModDownloadSearchCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <PathIcon Data="{StaticResource BmxIconRefresh}" Width="13" Height="13" />
                                            <TextBlock Text="{Binding SearchText}" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <ItemsControl ItemsSource="{Binding ModDownloadCategoryFilters}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel ItemSpacing="8" LineSpacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ModDownloadCategoryFilterViewModel">
                                                <Button Classes="ModOpsCategoryChip"
                                                        Classes.active="{Binding IsSelected}"
                                                        Command="{Binding #Root.DataContext.SelectModDownloadCategoryCommand}"
                                                        CommandParameter="{Binding Key}">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="8">
                                    <Button Classes="ModOpsFlatButton"
                                            Classes.active="{Binding IsModDownloadCardView}"
                                            Height="34"
                                            Padding="14,0"
                                            Command="{Binding SetModDownloadViewCommand}"
                                            CommandParameter="Cards"
                                            ToolTip.Tip="{Binding CardViewText}">
                                        <PathIcon Data="{StaticResource BmxIconDashboard}" Width="15" Height="15" />
                                    </Button>
                                    <Button Classes="ModOpsFlatButton"
                                            Classes.active="{Binding IsModDownloadListView}"
                                            Height="34"
                                            Padding="14,0"
                                            Command="{Binding SetModDownloadViewCommand}"
                                            CommandParameter="List"
                                            ToolTip.Tip="{Binding ListViewText}">
                                        <PathIcon Data="{StaticResource BmxIconNewspaper}" Width="15" Height="15" />
                                    </Button>
                                    </WrapPanel>
                                </Grid>
                            </Grid>
                            </controls:StripedCardBorder>

                            <Grid Grid.Row="2" ColumnDefinitions="1.42*,0.58*" ColumnSpacing="10">
                                <controls:StripedCardBorder Classes="ModOpsSurface ModOpsResultsSurface">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding SearchResultsText}" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding NexusStatusText}" FontSize="11" Foreground="#A6ADBB" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Grid.Row="1"
                                              RowDefinitions="*,Auto"
                                              ColumnDefinitions="*,16"
                                              ColumnSpacing="8"
                                              RowSpacing="10">
                                            <ScrollViewer x:Name="ModSearchResultsScrollViewer"
                                                          Grid.Row="0"
                                                          Grid.Column="0"
                                                          VerticalScrollBarVisibility="Hidden"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          ScrollChanged="ModSearchResultsScrollViewer_OnScrollChanged"
                                                          PointerPressed="ModSearchResultsScrollViewer_OnPointerPressed"
                                                          PointerMoved="ModSearchResultsScrollViewer_OnPointerMoved"
                                                          PointerReleased="ModSearchResultsScrollViewer_OnPointerReleased"
                                                          PointerCaptureLost="ModSearchResultsScrollViewer_OnPointerCaptureLost">
                                                <Grid>
                                                    <Grid>
                                                        <Border IsVisible="{Binding IsStandardModSearchEmpty}"
                                                                MinHeight="240"
                                                                CornerRadius="6"
                                                                BorderBrush="#2C3038"
                                                                BorderThickness="1"
                                                                Background="#14171D"
                                                                Padding="20">
                                                            <StackPanel Spacing="8"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center">
                                                                <PathIcon Data="{StaticResource BmxIconDownload}"
                                                                          Width="22"
                                                                          Height="22"
                                                                          Foreground="#A6ADBB"
                                                                          HorizontalAlignment="Center" />
                                                                <TextBlock Text="{Binding NexusResultEmptyText}"
                                                                           FontSize="12"
                                                                           Foreground="#A6ADBB"
                                                                           TextAlignment="Center"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ItemsRepeater ItemsSource="{Binding NexusModSearchRows}" IsVisible="{Binding IsModDownloadCardView}">
                                                    <ItemsRepeater.Layout>
                                                        <UniformGridLayout Orientation="Horizontal"
                                                                           MinItemWidth="258"
                                                                           MinItemHeight="330" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:NexusModSearchRowViewModel">
                                                            <Border Classes="ModCoverCard" Classes.selected="{Binding IsSelected}" Width="248" Height="320" Margin="0,0,10,10" Cursor="Hand" Tapped="NexusModResult_OnTapped" controls:VisualResourceLifetime.IsEnabled="True">
                                                                <Grid ClipToBounds="True">
                                                                    <Border Background="#10141B" />
                                                                    <Image Source="{Binding ThumbnailImage}"
                                                                           Stretch="UniformToFill"
                                                                           HorizontalAlignment="Stretch"
                                                                           VerticalAlignment="Stretch"
                                                                           IsVisible="{Binding HasThumbnail}" />
                                                                    <StackPanel IsVisible="{Binding HasNoThumbnail}"
                                                                                Spacing="4"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center">
                                                                        <PathIcon Data="{StaticResource BmxIconDownload}" Width="22" Height="22" Foreground="#A6ADBB" HorizontalAlignment="Center" />
                                                                        <TextBlock Text="{Binding SourceText}" FontSize="11" FontWeight="SemiBold" Foreground="#A6ADBB" HorizontalAlignment="Center" />
                                                                    </StackPanel>

                                                                    <StackPanel VerticalAlignment="Top">
                                                                        <Border Classes="ModCoverGlassPanel">
                                                                            <StackPanel Spacing="5">
                                                                                <TextBlock FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2">
                                                                                    <Run Text="{Binding NameHighlightPrefix}" Foreground="#F8FAFC" />
                                                                                    <Run Text="{Binding NameHighlightText}" Foreground="#60A5FA" />
                                                                                    <Run Text="{Binding NameHighlightSuffix}" Foreground="#F8FAFC" />
                                                                                </TextBlock>
                                                                                <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#D5DCE6" TextWrapping="Wrap" MaxLines="2" />
                                                                                <TextBlock Text="{Binding MetaText}" FontSize="10.5" Foreground="#B4BCC8" TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <Border Height="84" Classes="ModCoverFade">
                                                                            <Border.Background>
                                                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                                                    <GradientStop Color="#E00E1218" Offset="0" />
                                                                                    <GradientStop Color="#990E1218" Offset="0.32" />
                                                                                    <GradientStop Color="#400E1218" Offset="0.68" />
                                                                                    <GradientStop Color="#000E1218" Offset="1" />
                                                                                </LinearGradientBrush>
                                                                            </Border.Background>
                                                                        </Border>
                                                                    </StackPanel>

                                                                    <Border VerticalAlignment="Bottom" Padding="12,40,12,12">
                                                                        <Border.Background>
                                                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                                                <GradientStop Color="#00000000" Offset="0" />
                                                                                <GradientStop Color="#A00E1218" Offset="0.4" />
                                                                                <GradientStop Color="#E80E1218" Offset="1" />
                                                                            </LinearGradientBrush>
                                                                        </Border.Background>
                                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                            <Button Classes="ModOpsFlatButton"
                                                                                    Height="32"
                                                                                    Padding="12,0"
                                                                                    Command="{Binding #Root.DataContext.ViewNexusModDetailsCommand}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Content="{Binding #Root.DataContext.ModDetailText}" />
                                                                            <Button Grid.Column="1"
                                                                                    Classes="ModOpsPrimaryButton"
                                                                                    Classes.downloaded="{Binding IsDownloaded}"
                                                                                    MinWidth="76"
                                                                                    Height="32"
                                                                                    Padding="12,0"
                                                                                    IsEnabled="{Binding CanDownload}"
                                                                                    Command="{Binding #Root.DataContext.DownloadNexusModCommand}"
                                                                                    CommandParameter="{Binding}">
                                                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                                                    <PathIcon Data="{StaticResource BmxIconDownload}" Width="13" Height="13" />
                                                                                    <TextBlock Text="{Binding DownloadActionText}" FontSize="11" />
                                                                                </StackPanel>
                                                                            </Button>
                                                                        </Grid>
                                                                    </Border>

                                                                    <controls:SmoothCornerBorder Classes="ModCoverOutline"
                                                                                                  Classes.selected="{Binding IsSelected}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                        </ItemsRepeater>
                                                        <ItemsRepeater ItemsSource="{Binding NexusModSearchRows}" IsVisible="{Binding IsModDownloadListView}">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Orientation="Vertical" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:NexusModSearchRowViewModel">
                                                            <controls:StripedCardBorder Classes="ModOpsListRow" Classes.selected="{Binding IsSelected}" Margin="0,0,0,7" Cursor="Hand" Tapped="NexusModResult_OnTapped" controls:VisualResourceLifetime.IsEnabled="True">
                                                                <Grid ColumnDefinitions="70,1.4*,0.7*,0.55*,156" ColumnSpacing="12">
                                                                    <Border Width="70" Height="48" CornerRadius="8" Background="#272C34" ClipToBounds="True">
                                                                        <Grid>
                                                                            <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                                                                            <PathIcon Data="{StaticResource BmxIconDownload}"
                                                                                      Width="16"
                                                                                      Height="16"
                                                                                      Foreground="#A6ADBB"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      IsVisible="{Binding HasNoThumbnail}" />
                                                                        </Grid>
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                                        <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                                            <Run Text="{Binding NameHighlightPrefix}" Foreground="#F8FAFC" />
                                                                            <Run Text="{Binding NameHighlightText}" Foreground="#60A5FA" />
                                                                            <Run Text="{Binding NameHighlightSuffix}" Foreground="#F8FAFC" />
                                                                        </TextBlock>
                                                                        <TextBlock Text="{Binding Summary}" FontSize="10.5" Foreground="#A6ADBB" TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding SourceText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding DownloadStateText}" FontSize="10" Foreground="#A6ADBB" TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="3" Spacing="3" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DownloadsText}" FontSize="11" FontWeight="SemiBold" Foreground="#F8FAFC" TextAlignment="Right" />
                                                                        <TextBlock Text="{Binding UpdatedText}" FontSize="10" Foreground="#A6ADBB" TextAlignment="Right" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="4"
                                                                                Orientation="Horizontal"
                                                                                Spacing="6"
                                                                                HorizontalAlignment="Right"
                                                                                VerticalAlignment="Center">
                                                                        <Button Classes="ModOpsFlatButton" MinWidth="70" Height="30" Padding="10,0" Command="{Binding #Root.DataContext.ViewNexusModDetailsCommand}" CommandParameter="{Binding}" Content="{Binding #Root.DataContext.ModDetailText}" />
                                                                        <Button Classes="ModOpsPrimaryButton" Classes.downloaded="{Binding IsDownloaded}" MinWidth="64" Height="30" Padding="10,0" IsEnabled="{Binding CanDownload}" Command="{Binding #Root.DataContext.DownloadNexusModCommand}" CommandParameter="{Binding}" Content="{Binding DownloadActionText}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </controls:StripedCardBorder>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                        </ItemsRepeater>
                                                        <Grid IsVisible="{Binding IsModPackSourceSelected}">
                                                            <Border IsVisible="{Binding IsVisibleModPackSearchEmpty}"
                                                                    MinHeight="240"
                                                                    CornerRadius="6"
                                                                    BorderBrush="#2C3038"
                                                                    BorderThickness="1"
                                                                    Background="#14171D"
                                                                    Padding="20">
                                                                <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <PathIcon Data="{StaticResource BmxIconGift}" Width="22" Height="22" Foreground="#A6ADBB" HorizontalAlignment="Center" />
                                                                    <TextBlock Text="{Binding NexusResultEmptyText}" FontSize="12" Foreground="#A6ADBB" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
                                                                </StackPanel>
                                                            </Border>

                                                            <ItemsRepeater ItemsSource="{Binding ModPackRows}" IsVisible="{Binding IsModDownloadCardView}">
                                                                <ItemsRepeater.Layout>
                                                                    <UniformGridLayout Orientation="Horizontal"
                                                                                       MinItemWidth="258"
                                                                                       MinItemHeight="330" />
                                                                </ItemsRepeater.Layout>
                                                                <ItemsRepeater.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:ModPackRowViewModel">
                                                                        <Border Classes="ModCoverCard" Classes.selected="{Binding IsSelected}" Width="248" Height="320" Margin="0,0,10,10" Cursor="Hand" Tapped="NexusModResult_OnTapped" controls:VisualResourceLifetime.IsEnabled="True">
                                                                            <Grid ClipToBounds="True">
                                                                                <Border Background="#10141B" />
                                                                                <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                                                                                <ProgressBar Width="72" Height="3" IsIndeterminate="True" IsVisible="{Binding IsThumbnailLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                <Border IsVisible="{Binding HasNoThumbnail}" Background="#182A36">
                                                                                    <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                        <Path Data="{StaticResource IconSteam}" Width="34" Height="34" Stretch="Uniform" Fill="#7DD3FC" IsVisible="{Binding IsSteamWorkshop}" HorizontalAlignment="Center" />
                                                                                        <PathIcon Data="{StaticResource BmxIconGift}" Width="28" Height="28" Foreground="#F59E6B" IsVisible="{Binding IsNexusCollection}" HorizontalAlignment="Center" />
                                                                                        <TextBlock Text="{Binding PlatformText}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center" />
                                                                                        <TextBlock Text="{Binding RightsText}" FontSize="9.5" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                                                                    </StackPanel>
                                                                                </Border>

                                                                                <StackPanel VerticalAlignment="Top">
                                                                                    <Border Classes="ModCoverGlassPanel">
                                                                                        <StackPanel Spacing="5">
                                                                                            <TextBlock FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2">
                                                                                                <Run Text="{Binding NameHighlightPrefix}" Foreground="#F8FAFC" />
                                                                                                <Run Text="{Binding NameHighlightText}" Foreground="#60A5FA" />
                                                                                                <Run Text="{Binding NameHighlightSuffix}" Foreground="#F8FAFC" />
                                                                                            </TextBlock>
                                                                                            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#D5DCE6" TextWrapping="Wrap" MaxLines="2" />
                                                                                            <TextBlock Text="{Binding MetaText}" FontSize="10.5" Foreground="#B4BCC8" TextTrimming="CharacterEllipsis" />
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </StackPanel>

                                                                                <Border VerticalAlignment="Bottom" Padding="12,54,12,12">
                                                                                    <Border.Background>
                                                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                                                            <GradientStop Color="#00000000" Offset="0" />
                                                                                            <GradientStop Color="#D80E1218" Offset="0.48" />
                                                                                            <GradientStop Color="#F20E1218" Offset="1" />
                                                                                        </LinearGradientBrush>
                                                                                    </Border.Background>
                                                                                    <StackPanel Spacing="8">
                                                                                        <WrapPanel ItemSpacing="6" LineSpacing="6">
                                                                                            <Border Classes="ModPackPlatformTag" Classes.steam="{Binding IsSteamWorkshop}" Classes.nexus="{Binding IsNexusCollection}">
                                                                                                <TextBlock Text="{Binding PlatformText}" FontSize="10" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                                                                            </Border>
                                                                                            <Border Classes="ModOpsPill"><TextBlock Text="{Binding ItemCountText}" FontSize="10" Foreground="#B8C0CC" /></Border>
                                                                                            <Border Classes="ModOpsPill"><TextBlock Text="{Binding RightsText}" FontSize="10" Foreground="#86EFAC" /></Border>
                                                                                            <Border Classes="ModOpsPill" IsVisible="{Binding ThumbnailIsRepresentative}"><TextBlock Text="{Binding RepresentativeThumbnailText}" FontSize="10" Foreground="#FCD34D" /></Border>
                                                                                            <Border Classes="ModOpsPill" IsVisible="{Binding ContainsAdultContent}"><TextBlock Text="{Binding AdultContentText}" FontSize="10" FontWeight="SemiBold" Foreground="#FCA5A5" /></Border>
                                                                                        </WrapPanel>
                                                                                        <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                                                                                            <Button Classes="ModOpsFlatButton" Height="30" Padding="10,0" HorizontalAlignment="Stretch" Command="{Binding #Root.DataContext.ViewModPackOriginalPageCommand}" CommandParameter="{Binding}" Content="{Binding #Root.DataContext.ViewOriginalPageText}" />
                                                                                            <Button Grid.Row="1" Classes="ModOpsPrimaryButton" Height="30" Padding="10,0" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsInstalling}" Command="{Binding #Root.DataContext.InstallModPackCommand}" CommandParameter="{Binding}" Content="{Binding PrimaryActionText}" />
                                                                                        </Grid>
                                                                                    </StackPanel>
                                                                                </Border>
                                                                                <controls:SmoothCornerBorder Classes="ModCoverOutline" Classes.selected="{Binding IsSelected}" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsRepeater.ItemTemplate>
                                                            </ItemsRepeater>

                                                            <ItemsRepeater ItemsSource="{Binding ModPackRows}" IsVisible="{Binding IsModDownloadListView}">
                                                                <ItemsRepeater.Layout>
                                                                    <StackLayout Orientation="Vertical" />
                                                                </ItemsRepeater.Layout>
                                                                <ItemsRepeater.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:ModPackRowViewModel">
                                                                        <controls:StripedCardBorder Classes="ModOpsListRow" Classes.selected="{Binding IsSelected}" Margin="0,0,0,7" Cursor="Hand" Tapped="NexusModResult_OnTapped" controls:VisualResourceLifetime.IsEnabled="True">
                                                                            <Grid ColumnDefinitions="70,1.35*,0.75*,0.7*,160" ColumnSpacing="12">
                                                                                <Border Width="70" Height="48" CornerRadius="6" Background="#272C34" ClipToBounds="True">
                                                                                    <Grid>
                                                                                        <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                                                                                        <ProgressBar Width="36" Height="3" IsIndeterminate="True" IsVisible="{Binding IsThumbnailLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                        <StackPanel IsVisible="{Binding HasNoThumbnail}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                            <Path Data="{StaticResource IconSteam}" Width="18" Height="18" Stretch="Uniform" Fill="#7DD3FC" IsVisible="{Binding IsSteamWorkshop}" HorizontalAlignment="Center" />
                                                                                            <PathIcon Data="{StaticResource BmxIconGift}" Width="16" Height="16" Foreground="#F59E6B" IsVisible="{Binding IsNexusCollection}" HorizontalAlignment="Center" />
                                                                                        </StackPanel>
                                                                                    </Grid>
                                                                                </Border>
                                                                                <StackPanel Grid.Column="1" Spacing="3">
                                                                                    <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                                                        <Run Text="{Binding NameHighlightPrefix}" Foreground="#F8FAFC" />
                                                                                        <Run Text="{Binding NameHighlightText}" Foreground="#60A5FA" />
                                                                                        <Run Text="{Binding NameHighlightSuffix}" Foreground="#F8FAFC" />
                                                                                    </TextBlock>
                                                                                    <TextBlock Text="{Binding Summary}" FontSize="10.5" Foreground="#A6ADBB" TextTrimming="CharacterEllipsis" />
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                                                                    <Border Classes="ModPackPlatformTag" Classes.steam="{Binding IsSteamWorkshop}" Classes.nexus="{Binding IsNexusCollection}" HorizontalAlignment="Left">
                                                                                        <TextBlock Text="{Binding PlatformText}" FontSize="10" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                                                                    </Border>
                                                                                    <TextBlock Text="{Binding RightsText}" FontSize="10" Foreground="#86EFAC" TextTrimming="CharacterEllipsis" />
                                                                                    <TextBlock Text="{Binding RepresentativeThumbnailText}" IsVisible="{Binding ThumbnailIsRepresentative}" FontSize="10" Foreground="#FCD34D" TextTrimming="CharacterEllipsis" />
                                                                                    <TextBlock Text="{Binding AdultContentText}" IsVisible="{Binding ContainsAdultContent}" FontSize="10" FontWeight="SemiBold" Foreground="#FCA5A5" TextTrimming="CharacterEllipsis" />
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="3" Spacing="3" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding ItemCountText}" FontSize="11" FontWeight="SemiBold" Foreground="#F8FAFC" TextAlignment="Right" />
                                                                                    <TextBlock Text="{Binding UpdatedText}" FontSize="10" Foreground="#A6ADBB" TextAlignment="Right" />
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="4" Spacing="5" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                                                    <Button Classes="ModOpsFlatButton" Height="28" Padding="9,0" HorizontalAlignment="Stretch" Command="{Binding #Root.DataContext.ViewModPackOriginalPageCommand}" CommandParameter="{Binding}" Content="{Binding #Root.DataContext.ViewOriginalPageText}" />
                                                                                    <Button Classes="ModOpsPrimaryButton" Height="28" Padding="9,0" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsInstalling}" Command="{Binding #Root.DataContext.InstallModPackCommand}" CommandParameter="{Binding}" Content="{Binding PrimaryActionText}" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </controls:StripedCardBorder>
                                                                    </DataTemplate>
                                                                </ItemsRepeater.ItemTemplate>
                                                            </ItemsRepeater>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </ScrollViewer>
                                            <Border x:Name="ModSearchResultsScrollTrack"
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Width="16"
                                                    CornerRadius="6"
                                                    Background="#14171D"
                                                    ClipToBounds="True"
                                                    PointerPressed="ModSearchResultsScrollTrack_OnPointerPressed"
                                                    PointerMoved="ModSearchResultsScrollTrack_OnPointerMoved"
                                                    PointerReleased="ModSearchResultsScrollTrack_OnPointerReleased"
                                                    PointerCaptureLost="ModSearchResultsScrollTrack_OnPointerCaptureLost">
                                                <Border x:Name="ModSearchResultsScrollThumb"
                                                        Width="12"
                                                        Height="56"
                                                        CornerRadius="6"
                                                        Background="#2563EB"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Top"
                                                        BoxShadow="0 2 8 0 #4D2563EB"
                                                        PointerPressed="ModSearchResultsScrollThumb_OnPointerPressed">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform Y="0" />
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Border>
                                            <Button Grid.Row="1"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Classes="ModOpsFlatButton"
                                                    IsVisible="{Binding HasVisibleModDownloadSearchResults}"
                                                    IsEnabled="{Binding HasMoreModSearchResults}"
                                                    HorizontalAlignment="Stretch"
                                                    Height="36"
                                                    Padding="16,0"
                                                    Command="{Binding LoadMoreModSearchResultsCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                                                    <PathIcon Data="{StaticResource BmxIconRefresh}" Width="13" Height="13" />
                                                    <TextBlock Text="{Binding LoadMoreModSearchResultsText}" FontSize="12" />
                                                    </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </controls:StripedCardBorder>

                                <controls:StripedCardBorder Grid.Column="1"
                                                            Classes="ModOpsSurface ModOpsQueueInspectorSurface"
                                                            ClipToBounds="True"
                                                            MinWidth="360"
                                                            IsVisible="{Binding !IsSearchingNexusMods}">
                                    <StackPanel Spacing="12">
                                        <controls:StripedCardBorder Classes="ModOpsNotice DownloadDetailPanel"
                                                IsVisible="{Binding IsModDownloadDetailVisible}"
                                                Padding="10">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="9">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <TextBlock Text="{Binding ModDetailText}" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                                <Button Grid.Column="1"
                                                        Classes="ModOpsFlatButton"
                                                        Width="132"
                                                        Height="28"
                                                        Padding="9,0"
                                                        IsEnabled="{Binding SelectedNexusMod.CanTranslateSummary}"
                                                        Command="{Binding TranslateModSummaryCommand}"
                                                        CommandParameter="{Binding SelectedNexusMod}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                        <PathIcon Data="{StaticResource BmxIconLanguage}"
                                                                  Width="12"
                                                                  Height="12"
                                                                  IsVisible="{Binding !SelectedNexusMod.IsSummaryTranslationBusy}" />
                                                        <ProgressBar Width="14"
                                                                     Height="3"
                                                                     IsIndeterminate="True"
                                                                     IsVisible="{Binding SelectedNexusMod.IsSummaryTranslationBusy}" />
                                                        <TextBlock Text="{Binding SelectedNexusMod.SummaryTranslationActionText}" FontSize="11" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="2" Classes="ModOpsFlatButton" Height="28" Padding="10,0" Command="{Binding CloseNexusModDetailsCommand}" Content="{Binding CloseText}" />
                                            </Grid>
                                            <Border Grid.Row="1" Height="106" CornerRadius="6" Background="#272C34" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding SelectedNexusMod.ThumbnailImage}" Stretch="UniformToFill" IsVisible="{Binding SelectedNexusMod.HasThumbnail}" />
                                                    <StackPanel IsVisible="{Binding SelectedNexusMod.HasNoThumbnail}"
                                                                Spacing="5"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <PathIcon Data="{StaticResource BmxIconDownload}" Width="18" Height="18" Foreground="#A6ADBB" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding SelectedNexusMod.SourceText}" FontSize="11" FontWeight="SemiBold" Foreground="#A6ADBB" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Row="2" Spacing="4">
                                                <TextBlock Text="{Binding SelectedNexusMod.Name}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" TextWrapping="Wrap" MaxLines="2" />
                                                <TextBlock Text="{Binding SelectedNexusMod.MetaText}" FontSize="11" Foreground="#A6ADBB" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SelectedNexusMod.SummaryDisplayText}" FontSize="10.5" Foreground="#A6ADBB" TextWrapping="Wrap" MaxLines="5" />
                                                <TextBlock Text="{Binding SelectedNexusMod.SummaryTranslationNoticeText}"
                                                           IsVisible="{Binding SelectedNexusMod.HasSummaryTranslationNotice}"
                                                           FontSize="10"
                                                           Foreground="#93C5FD"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SelectedNexusMod.SummaryTranslationErrorText}"
                                                           IsVisible="{Binding SelectedNexusMod.HasSummaryTranslationError}"
                                                           FontSize="10"
                                                           Foreground="#FCA5A5"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SelectedNexusMod.MetricText}" FontSize="10.5" Foreground="#A6ADBB" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Row="3"
                                                    Classes="ModOpsPrimaryButton"
                                                    MinWidth="86"
                                                    Height="34"
                                                    HorizontalAlignment="Stretch"
                                                    IsEnabled="{Binding SelectedNexusMod.CanDownload}"
                                                    Command="{Binding DownloadNexusModCommand}"
                                                    CommandParameter="{Binding SelectedNexusMod}"
                                                    Content="{Binding SelectedNexusMod.DownloadActionText}" />
                                        </Grid>
                                        </controls:StripedCardBorder>
                                        <controls:StripedCardBorder Classes="ModOpsNotice DownloadDetailPanel"
                                                IsVisible="{Binding IsModPackDetailVisible}"
                                                Padding="10">
                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="9">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding ModDetailText}" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                                    <Button Grid.Column="1" Classes="ModOpsFlatButton" Height="28" Padding="10,0" Command="{Binding CloseModPackDetailsCommand}" Content="{Binding CloseText}" />
                                                </Grid>
                                                <Border Grid.Row="1" Height="106" CornerRadius="6" Background="#272C34" ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding SelectedModPack.ThumbnailImage}" Stretch="UniformToFill" IsVisible="{Binding SelectedModPack.HasThumbnail}" />
                                                        <ProgressBar Width="52" Height="3" IsIndeterminate="True" IsVisible="{Binding SelectedModPack.IsThumbnailLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <StackPanel IsVisible="{Binding SelectedModPack.HasNoThumbnail}" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Path Data="{StaticResource IconSteam}" Width="24" Height="24" Stretch="Uniform" Fill="#7DD3FC" IsVisible="{Binding SelectedModPack.IsSteamWorkshop}" HorizontalAlignment="Center" />
                                                            <PathIcon Data="{StaticResource BmxIconGift}" Width="20" Height="20" Foreground="#F59E6B" IsVisible="{Binding SelectedModPack.IsNexusCollection}" HorizontalAlignment="Center" />
                                                            <TextBlock Text="{Binding SelectedModPack.PlatformText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Row="2" Spacing="5">
                                                    <TextBlock Text="{Binding SelectedModPack.Name}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" TextWrapping="Wrap" MaxLines="2" />
                                                    <TextBlock Text="{Binding SelectedModPack.MetaText}" FontSize="11" Foreground="#A6ADBB" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SelectedModPack.Summary}" FontSize="10.5" Foreground="#A6ADBB" TextWrapping="Wrap" MaxLines="3" />
                                                    <TextBlock Text="{Binding SelectedModPack.CompatibilityText}" FontSize="10.5" Foreground="#D5DCE6" TextWrapping="Wrap" MaxLines="2" />
                                                    <TextBlock Text="{Binding SelectedModPack.TagsText}" FontSize="10" Foreground="#93C5FD" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <WrapPanel Grid.Row="3" ItemSpacing="7" LineSpacing="7">
                                                    <Border Classes="ModPackPlatformTag" Classes.steam="{Binding SelectedModPack.IsSteamWorkshop}" Classes.nexus="{Binding SelectedModPack.IsNexusCollection}"><TextBlock Text="{Binding SelectedModPack.PlatformText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#F8FAFC" /></Border>
                                                    <Border Classes="ModOpsPill"><TextBlock Text="{Binding SelectedModPack.ItemCountText}" FontSize="10.5" Foreground="#B8C0CC" /></Border>
                                                    <Border Classes="ModOpsPill"><TextBlock Text="{Binding SelectedModPack.UpdatedText}" FontSize="10.5" Foreground="#B8C0CC" /></Border>
                                                    <Border Classes="ModOpsPill"><TextBlock Text="{Binding SelectedModPack.RightsText}" FontSize="10.5" Foreground="#86EFAC" /></Border>
                                                    <Border Classes="ModOpsPill" IsVisible="{Binding SelectedModPack.ThumbnailIsRepresentative}"><TextBlock Text="{Binding SelectedModPack.RepresentativeThumbnailText}" FontSize="10.5" Foreground="#FCD34D" /></Border>
                                                    <Border Classes="ModOpsPill" IsVisible="{Binding SelectedModPack.ContainsAdultContent}"><TextBlock Text="{Binding SelectedModPack.AdultContentText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#FCA5A5" /></Border>
                                                </WrapPanel>
                                                <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <Button Classes="ModOpsFlatButton" Height="34" Command="{Binding ViewModPackOriginalPageCommand}" CommandParameter="{Binding SelectedModPack}" Content="{Binding ViewOriginalPageText}" />
                                                    <Button Grid.Column="1" Classes="ModOpsPrimaryButton" Height="34" IsEnabled="{Binding !SelectedModPack.IsInstalling}" Command="{Binding InstallModPackCommand}" CommandParameter="{Binding SelectedModPack}" Content="{Binding SelectedModPack.PrimaryActionText}" />
                                                </Grid>
                                            </Grid>
                                        </controls:StripedCardBorder>
                                        <controls:StripedCardBorder Classes="ModOpsNotice QueueInspectorPanel"
                                                IsVisible="False"
                                                Padding="10"
                                                Margin="0,2,0,0"
                                                MinHeight="0"
                                                ClipToBounds="True">
                                        <Grid RowDefinitions="Auto,*" RowSpacing="10" MinHeight="0">
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                <Button Classes="ModOpsQueueSegment"
                                                        Classes.active="{Binding IsDownloadingQueueSectionActive}"
                                                        Command="{Binding SetModDownloadQueueSectionCommand}"
                                                        CommandParameter="Downloading">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <TextBlock Text="{Binding DownloadingQueueText}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" MinWidth="32" Height="26" CornerRadius="6" Background="#1F2937" Padding="8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ActiveModDownloadQueueCountText}" FontSize="12" FontWeight="SemiBold" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                                <Button Grid.Column="1"
                                                        Classes="ModOpsQueueSegment"
                                                        Classes.active="{Binding IsDownloadedQueueSectionActive}"
                                                        Command="{Binding SetModDownloadQueueSectionCommand}"
                                                        CommandParameter="Downloaded">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <TextBlock Text="{Binding DownloadedQueueText}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" MinWidth="32" Height="26" CornerRadius="6" Background="#1F2937" Padding="8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DownloadedModDownloadQueueCountText}" FontSize="12" FontWeight="SemiBold" Foreground="#86EFAC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </Grid>

                                            <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="10" MinHeight="0">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBlock Text="{Binding VisibleDownloadQueueSectionTitleText}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ActionsText}" FontSize="10" FontWeight="SemiBold" Foreground="#A6ADBB" VerticalAlignment="Center" />
                                                </Grid>

                                                <ScrollViewer x:Name="ModDownloadQueueScrollViewer"
                                                              Grid.Row="1"
                                                              MaxHeight="280"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel Spacing="8">
                                                        <Border Classes="ModOpsQueueEmpty" IsVisible="{Binding IsVisibleModDownloadQueueEmpty}">
                                                            <StackPanel Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding VisibleDownloadQueueSectionTitleText}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                                                                <TextBlock Text="{Binding VisibleDownloadQueueEmptyText}" FontSize="12" Foreground="#A6ADBB" TextAlignment="Center" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>

                                                        <ItemsControl ItemsSource="{Binding VisibleModDownloadQueueGroups}" IsVisible="{Binding HasVisibleModDownloadQueueItems}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ModDownloadQueueGroupViewModel">
                                                                    <StackPanel Margin="0,0,0,12">
                                                                        <Border Classes="DownloadCenterQueueGroupHeader"
                                                                                Classes.modpack="{Binding IsModPack}">
                                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                                                <StackPanel Spacing="3" MinWidth="0">
                                                                                    <TextBlock Text="{Binding TitleText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                        <TextBlock Text="{Binding KindText}" FontSize="10" FontWeight="SemiBold" Foreground="#60A5FA" />
                                                                                        <TextBlock Text="{Binding SummaryText}" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                                                                                    </StackPanel>
                                                                                </StackPanel>
                                                                                <Border Grid.Column="1" MinWidth="46" Height="25" CornerRadius="5" Background="#1F2937" Padding="8,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding CountText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                        <ItemsControl ItemsSource="{Binding Items}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:ModDownloadQueueRowViewModel">
                                                                    <Border Classes="ModOpsQueueTaskRow" Margin="0,0,0,8" controls:VisualResourceLifetime.IsEnabled="True">
                                                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                                                <StackPanel Spacing="3">
                                                                                    <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                                                                    <TextBlock Text="{Binding ModText}" FontSize="10.5" Foreground="#A6ADBB" TextTrimming="CharacterEllipsis" />
                                                                                    <TextBlock Text="{Binding SourceText}" FontSize="10.5" Foreground="#A6ADBB" TextTrimming="CharacterEllipsis" />
                                                                                </StackPanel>
                                                                                <Border Grid.Column="1"
                                                                                        MinWidth="76"
                                                                                        Height="26"
                                                                                        CornerRadius="6"
                                                                                        Background="{Binding StatusBadgeBackground}"
                                                                                        Padding="9,0"
                                                                                        VerticalAlignment="Top">
                                                                                    <TextBlock Text="{Binding StatusBadgeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding StatusBadgeForeground}" TextAlignment="Center" VerticalAlignment="Center" />
                                                                                </Border>
                                                                            </Grid>

                                                                            <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="6">
                                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                                    <TextBlock Text="{Binding ProgressText}" FontSize="10.5" Foreground="#A6ADBB" TextTrimming="CharacterEllipsis" />
                                                                                    <TextBlock Grid.Column="1" Text="{Binding ProgressPercentText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                                                                </Grid>
                                                                                <ProgressBar Grid.Row="1" Classes="ModOpsProgress" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" />
                                                                            </Grid>

                                                                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                                                        <TextBlock Text="{Binding SizeText}" FontSize="10.5" Foreground="#A6ADBB" TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Text="{Binding SpeedText}" FontSize="10.5" Foreground="#A6ADBB" TextTrimming="CharacterEllipsis" />
                                                                                    </StackPanel>
                                                                                    <TextBlock Text="{Binding InstallText}" FontSize="10" Foreground="#A6ADBB" TextTrimming="CharacterEllipsis" />
                                                                                </StackPanel>
                                                                                <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
                                                                                    <Button Classes="ModOpsFlatButton"
                                                                                            Height="26"
                                                                                            Padding="8,0"
                                                                                            IsVisible="{Binding CanPause}"
                                                                                            Command="{Binding #Root.DataContext.PauseModDownloadCommand}"
                                                                                            CommandParameter="{Binding}"
                                                                                            Content="{Binding #Root.DataContext.PauseText}" />
                                                                                    <Button Classes="ModOpsFlatButton"
                                                                                            Height="26"
                                                                                            Padding="8,0"
                                                                                            IsVisible="{Binding CanResume}"
                                                                                            Command="{Binding #Root.DataContext.ResumeModDownloadCommand}"
                                                                                            CommandParameter="{Binding}"
                                                                                            Content="{Binding #Root.DataContext.ResumeText}" />
                                                                                    <Button Classes="ModOpsFlatButton"
                                                                                            Height="26"
                                                                                            Padding="8,0"
                                                                                            IsVisible="{Binding CanRetry}"
                                                                                            Command="{Binding #Root.DataContext.RetryModDownloadCommand}"
                                                                                            CommandParameter="{Binding}"
                                                                                            Content="{Binding #Root.DataContext.RetryText}" />
                                                                                    <Button Classes="ModOpsFlatButton"
                                                                                            Height="26"
                                                                                            Padding="8,0"
                                                                                            IsVisible="{Binding CanOpenFolder}"
                                                                                            Command="{Binding #Root.DataContext.OpenModDownloadFolderCommand}"
                                                                                            CommandParameter="{Binding}"
                                                                                            Content="{Binding #Root.DataContext.OpenFolderText}" />
                                                                                    <Button Classes="ModOpsDangerButton"
                                                                                            Height="26"
                                                                                            Padding="8,0"
                                                                                            IsVisible="{Binding CanCancel}"
                                                                                            Command="{Binding #Root.DataContext.CancelModDownloadCommand}"
                                                                                            CommandParameter="{Binding}"
                                                                                            Content="{Binding #Root.DataContext.CancelText}" />
                                                                                </WrapPanel>
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Grid>
                                        </Grid>
                                        </controls:StripedCardBorder>
                                    </StackPanel>
                                </controls:StripedCardBorder>
                                <Grid IsVisible="{Binding IsModDownloadLoading}"
                                      ZIndex="10"
                                      IsHitTestVisible="True">
                                    <Border Background="#E80B1018"
                                            CornerRadius="7"
                                            ClipToBounds="True" />
                                    <StackPanel Width="280"
                                                Spacing="12"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Image Width="256"
                                               Height="128"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Stretch="Uniform"
                                               anim:ImageBehavior.AnimatedSource="avares://BohemiX.App/Assets/kcd2-bunny-loading-transparent.gif"
                                               anim:ImageBehavior.RepeatBehavior="Forever" />
                                        <TextBlock Text="{Binding ModManagerLoadingText}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F8FAFC"
                                                   HorizontalAlignment="Center" />
                                        <ProgressBar Classes="ModOpsProgress"
                                                     Height="3"
                                                     IsIndeterminate="True" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                        </controls:StripedCardBorder>
                    </Grid>
                </ScrollViewer>
                </Grid>

                <Grid x:Name="ModRecommendationPageHost"
                      IsVisible="{Binding IsModRecommendationPageVisible}"
                      Margin="0,32,0,18"
                      MinHeight="0"
                      VerticalAlignment="Stretch">
                    <controls:StripedCardBorder Classes="ModOpsWorkspacePanel"
                                                IsStripeMotionEnabled="{Binding !ReduceMotion}"
                                                MinHeight="0"
                                                VerticalAlignment="Stretch">
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12" MinHeight="0">
                            <controls:StripedCardBorder Classes="ModOpsHeaderStrip ModOpsCommandBar">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" CornerRadius="7" Background="#10253E" BorderBrush="#2563EB" BorderThickness="1" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource BmxIconGift}" Width="15" Height="15" Foreground="#93C5FD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding ModRecommendationPageText}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F8FAFC"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ModRecommendationStatusText}"
                                                   FontSize="11"
                                                   Foreground="#A6ADBB"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="420" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="ModOpsPrimaryButton"
                                            Height="36"
                                            Padding="14,0"
                                            IsEnabled="{Binding !IsLoadingModRecommendations}"
                                            Command="{Binding RefreshModRecommendationsCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <PathIcon Data="{StaticResource BmxIconRefresh}" Width="13" Height="13" />
                                            <TextBlock Text="{Binding RefreshRecommendationsText}" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </controls:StripedCardBorder>

                            <controls:StripedCardBorder Grid.Row="1" Classes="ModOpsHeaderStrip ModOpsSearchBar">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                    <StackPanel Spacing="3" Width="138" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding RecommendationQualifierText}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F8FAFC" />
                                        <TextBlock Text="{Binding ModRecommendationStatusText}"
                                                   FontSize="10.5"
                                                   Foreground="#8F98A8"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <WrapPanel ItemSpacing="8" LineSpacing="8" HorizontalAlignment="Left">
                                            <ItemsControl ItemsSource="{Binding ModRecommendationStrategyFilters}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel ItemSpacing="8" LineSpacing="8" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ModDownloadCategoryFilterViewModel">
                                                        <Button Classes="ModOpsCategoryChip RecommendationStrategyChip"
                                                                Classes.active="{Binding IsSelected}"
                                                                Command="{Binding #Root.DataContext.SelectModRecommendationStrategyCommand}"
                                                                CommandParameter="{Binding Key}">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Classes="ModOpsCategoryChip RecommendationQualifierButton"
                                                    Width="34"
                                                    Height="30"
                                                    Padding="0"
                                                    ToolTip.Tip="{Binding RecommendationQualifierText}">
                                                <TextBlock Text="+"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="#BFDBFE"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Button.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedLeft"
                                                            FlyoutPresenterClasses="RecommendationQualifierFlyout">
                                                        <Border Padding="10"
                                                                Width="306"
                                                                Background="#1B2331"
                                                                BorderBrush="#335C9DFF"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                BoxShadow="0 12 28 0 #66050A14">
                                                            <StackPanel Spacing="8">
                                                                <ItemsControl ItemsSource="{Binding AvailableModRecommendationQualifiers}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel ItemSpacing="8" LineSpacing="8" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:ModRecommendationQualifierViewModel">
                                                                            <Button Classes="ModOpsCategoryChip"
                                                                                    Classes.active="{Binding IsSelected}"
                                                                                    Height="30"
                                                                                    Padding="11,0"
                                                                                    Command="{Binding #Root.DataContext.ToggleModRecommendationQualifierCommand}"
                                                                                    CommandParameter="{Binding}">
                                                                                <TextBlock Text="{Binding DisplayName}" FontSize="11" />
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                                    <Button Classes="ModOpsFlatButton"
                                                                            Height="30"
                                                                            HorizontalAlignment="Stretch"
                                                                            IsEnabled="{Binding HasRecommendationQualifiers}"
                                                                            Command="{Binding ClearModRecommendationQualifiersCommand}"
                                                                            Content="{Binding ClearText}" />
                                                                    <Button Grid.Column="1"
                                                                            Classes="ModOpsPrimaryButton"
                                                                            Height="30"
                                                                            HorizontalAlignment="Stretch"
                                                                            IsEnabled="{Binding !IsLoadingModRecommendations}"
                                                                            Command="{Binding RefreshModRecommendationsCommand}"
                                                                            Content="{Binding RefreshRecommendationsText}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </WrapPanel>
                                        <ItemsControl ItemsSource="{Binding ModRecommendationQualifiers}"
                                                      IsVisible="{Binding HasRecommendationQualifiers}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel ItemSpacing="8" LineSpacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ModRecommendationQualifierViewModel">
                                                    <Border Classes="ModOpsPill RecommendationActiveQualifier" Padding="10,0,4,0" Height="28">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="#BFDBFE" VerticalAlignment="Center" />
                                                            <Button Classes="ModOpsSearchClearButton"
                                                                    Width="20"
                                                                    Height="20"
                                                                    Command="{Binding #Root.DataContext.RemoveModRecommendationQualifierCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <PathIcon Data="{StaticResource BmxIconClose}" Width="8" Height="8" Foreground="#FCA5A5" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </controls:StripedCardBorder>

                            <Grid Grid.Row="2" ColumnDefinitions="1.12*,0.88*" ColumnSpacing="10" MinHeight="0" VerticalAlignment="Stretch">
                                <controls:StripedCardBorder Classes="ModOpsSurface ModOpsResultsSurface" MinHeight="0" VerticalAlignment="Stretch">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="10" MinHeight="0">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding RecommendationListText}" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                                <TextBlock Text="{Binding ModRecommendationStatusText}" FontSize="11" Foreground="#A6ADBB" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="8">
                                                <Button Classes="ModOpsFlatButton"
                                                        Classes.active="{Binding IsModRecommendationCardView}"
                                                        Height="34"
                                                        Padding="14,0"
                                                        Command="{Binding SetModRecommendationViewCommand}"
                                                        CommandParameter="Cards"
                                                        ToolTip.Tip="{Binding CardViewText}">
                                                    <PathIcon Data="{StaticResource BmxIconDashboard}" Width="15" Height="15" />
                                                </Button>
                                                <Button Classes="ModOpsFlatButton"
                                                        Classes.active="{Binding IsModRecommendationListView}"
                                                        Height="34"
                                                        Padding="14,0"
                                                        Command="{Binding SetModRecommendationViewCommand}"
                                                        CommandParameter="List"
                                                        ToolTip.Tip="{Binding ListViewText}">
                                                    <PathIcon Data="{StaticResource BmxIconNewspaper}" Width="15" Height="15" />
                                                </Button>
                                            </WrapPanel>
                                        </Grid>

                                        <Grid Grid.Row="1"
                                              ColumnDefinitions="*,16"
                                              ColumnSpacing="8"
                                              MinHeight="0">
                                            <ScrollViewer x:Name="ModRecommendationRowsScrollViewer"
                                                          Grid.Column="0"
                                                          MaxHeight="560"
                                                          ClipToBounds="True"
                                                          VerticalScrollBarVisibility="Hidden"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                           VerticalContentAlignment="Top"
                                                           VerticalAlignment="Stretch"
                                                           PointerWheelChanged="ModRecommendationRowsScrollViewer_OnPointerWheelChanged"
                                                           ScrollChanged="ModRecommendationRowsScrollViewer_OnScrollChanged">
                                                <Grid VerticalAlignment="Top">
                                                <Border IsVisible="{Binding IsModRecommendationEmpty}"
                                                        MinHeight="260"
                                                        CornerRadius="6"
                                                        BorderBrush="#2C3038"
                                                        BorderThickness="1"
                                                        Background="#14171D"
                                                        Padding="20">
                                                    <StackPanel Spacing="8"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <PathIcon Data="{StaticResource BmxIconStar}"
                                                                  Width="22"
                                                                  Height="22"
                                                                  Foreground="#A6ADBB"
                                                                  HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding ModRecommendationStatusText}"
                                                                   FontSize="12"
                                                                   Foreground="#A6ADBB"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <ItemsRepeater ItemsSource="{Binding ModRecommendationRows}"
                                                              IsVisible="{Binding IsModRecommendationCardView}"
                                                              VerticalAlignment="Top">
                                                    <ItemsRepeater.Layout>
                                                        <UniformGridLayout Orientation="Horizontal"
                                                                           ItemsStretch="Fill"
                                                                           MaximumRowsOrColumns="2"
                                                                           MinItemWidth="248"
                                                                           MinItemHeight="370" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ModRecommendationRowViewModel">
                                                            <Border Classes="ModCoverCard" Classes.selected="{Binding IsSelected}" Height="360" Margin="0,0,10,10" Cursor="Hand" Tapped="NexusModResult_OnTapped" controls:VisualResourceLifetime.IsEnabled="True">
                                                                <Grid ClipToBounds="True">
                                                                    <Border Background="#10141B" />
                                                                    <Image Source="{Binding Mod.ThumbnailImage}"
                                                                           Stretch="UniformToFill"
                                                                           HorizontalAlignment="Stretch"
                                                                           VerticalAlignment="Stretch"
                                                                           IsVisible="{Binding Mod.HasThumbnail}" />
                                                                    <StackPanel IsVisible="{Binding Mod.HasNoThumbnail}"
                                                                                Spacing="4"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center">
                                                                        <PathIcon Data="{StaticResource BmxIconStar}" Width="22" Height="22" Foreground="#A6ADBB" HorizontalAlignment="Center" />
                                                                        <TextBlock Text="{Binding StrategyText}" FontSize="11" FontWeight="SemiBold" Foreground="#A6ADBB" HorizontalAlignment="Center" />
                                                                    </StackPanel>

                                                                    <StackPanel VerticalAlignment="Top">
                                                                        <Border Classes="ModCoverGlassPanel">
                                                                            <StackPanel Spacing="5">
                                                                                <Border Classes="RecommendationRankPlate" MinWidth="88" Height="28" HorizontalAlignment="Left">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0">
                                                                                        <TextBlock Text="{Binding RankText}" FontSize="11" FontWeight="Bold" Foreground="#BFDBFE" />
                                                                                        <Border Width="1" Height="14" Background="#5060A5FA" />
                                                                                        <PathIcon Data="{StaticResource BmxIconFlame}" Width="12" Height="12" Foreground="#FB923C" />
                                                                                        <TextBlock Text="{Binding HeatLevelText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#FDBA74" />
                                                                                    </StackPanel>
                                                                                </Border>
                                                                                <TextBlock Classes="RecommendationCardTitle" Text="{Binding Mod.Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FAFC" TextWrapping="Wrap" MaxLines="2" />
                                                                                <TextBlock Text="{Binding Mod.Summary}" FontSize="11" Foreground="#D5DCE6" TextWrapping="Wrap" MaxLines="2" />
                                                                                <WrapPanel ItemSpacing="7" LineSpacing="5">
                                                                                    <Border Classes="ModOpsPill">
                                                                                        <TextBlock Text="{Binding StrategyText}" FontSize="10.5" Foreground="#B8C0CC" />
                                                                                    </Border>
                                                                                    <Border Classes="ModOpsPill">
                                                                                        <TextBlock Text="{Binding CategoryText}" FontSize="10.5" Foreground="#B8C0CC" />
                                                                                    </Border>
                                                                                </WrapPanel>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <Border Height="88" Classes="ModCoverFade">
                                                                            <Border.Background>
                                                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                                                    <GradientStop Color="#E00E1218" Offset="0" />
                                                                                    <GradientStop Color="#990E1218" Offset="0.32" />
                                                                                    <GradientStop Color="#400E1218" Offset="0.68" />
                                                                                    <GradientStop Color="#000E1218" Offset="1" />
                                                                                </LinearGradientBrush>
                                                                            </Border.Background>
                                                                        </Border>
                                                                    </StackPanel>

                                                                    <Border VerticalAlignment="Bottom" Padding="12,44,12,12">
                                                                        <Border.Background>
                                                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                                                <GradientStop Color="#00000000" Offset="0" />
                                                                                <GradientStop Color="#A00E1218" Offset="0.4" />
                                                                                <GradientStop Color="#E80E1218" Offset="1" />
                                                                            </LinearGradientBrush>
                                                                        </Border.Background>
                                                                        <StackPanel Spacing="8">
                                                                            <TextBlock Text="{Binding ReasonText}" FontSize="10.5" Foreground="#E8EEF6" TextWrapping="Wrap" MaxLines="2" />
                                                                            <Grid Classes="RecommendationCardFooter" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                                <Button Classes="ModOpsFlatButton"
                                                                                        Height="32"
                                                                                        Padding="12,0"
                                                                                        Command="{Binding #Root.DataContext.ViewNexusModDetailsCommand}"
                                                                                        CommandParameter="{Binding Mod}"
                                                                                        Content="{Binding #Root.DataContext.ModDetailText}" />
                                                                                <Button Grid.Column="1"
                                                                                        Classes="ModOpsPrimaryButton"
                                                                                        Classes.downloaded="{Binding Mod.IsDownloaded}"
                                                                                        MinWidth="76"
                                                                                        Height="32"
                                                                                        Padding="12,0"
                                                                                        Command="{Binding #Root.DataContext.DownloadNexusModCommand}"
                                                                                        CommandParameter="{Binding Mod}">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                                                        <PathIcon Data="{StaticResource BmxIconDownload}" Width="13" Height="13" />
                                                                                        <TextBlock Text="{Binding Mod.DownloadActionText}" FontSize="11" />
                                                                                    </StackPanel>
                                                                                </Button>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </Border>

                                                                    <controls:SmoothCornerBorder Classes="ModCoverOutline"
                                                                                                  Classes.selected="{Binding IsSelected}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                                <ItemsRepeater ItemsSource="{Binding ModRecommendationRows}"
                                                              IsVisible="{Binding IsModRecommendationListView}"
                                                              VerticalAlignment="Top">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Orientation="Vertical" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ModRecommendationRowViewModel">
                                                            <controls:StripedCardBorder Classes="ModOpsListRow" Classes.selected="{Binding IsSelected}" Margin="0,0,0,7" Cursor="Hand" Tapped="NexusModResult_OnTapped" controls:VisualResourceLifetime.IsEnabled="True">
                                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                                                    <Border Width="70" Height="52" CornerRadius="6" Background="#272C34" ClipToBounds="True">
                                                                        <Grid>
                                                                            <Image Source="{Binding Mod.ThumbnailImage}" Stretch="UniformToFill" IsVisible="{Binding Mod.HasThumbnail}" />
                                                                            <StackPanel IsVisible="{Binding Mod.HasNoThumbnail}"
                                                                                        Spacing="2"
                                                                                        HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center">
                                                                                <PathIcon Data="{StaticResource BmxIconStar}" Width="16" Height="16" Foreground="#A6ADBB" HorizontalAlignment="Center" />
                                                                                <TextBlock Text="{Binding StrategyText}" FontSize="9.5" FontWeight="SemiBold" Foreground="#A6ADBB" HorizontalAlignment="Center" />
                                                                            </StackPanel>
                                                                            <Border MinWidth="28" Height="20" CornerRadius="0,0,5,0" Background="#D910253E" BorderBrush="#502563EB" BorderThickness="0,0,1,1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                                                <TextBlock Text="{Binding RankText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#93C5FD" />
                                                                            </Border>
                                                                            <Border MinWidth="48" Height="20" CornerRadius="5,0,0,0" Background="#D91F130A" BorderBrush="#66F97316" BorderThickness="1,1,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0">
                                                                                    <PathIcon Data="{StaticResource BmxIconFlame}" Width="10" Height="10" Foreground="#FB923C" />
                                                                                    <TextBlock Text="{Binding HeatLevelText}" FontSize="9.5" FontWeight="SemiBold" Foreground="#FDBA74" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Mod.Name}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding Mod.Summary}" FontSize="10.5" Foreground="#A6ADBB" TextTrimming="CharacterEllipsis" />
                                                                        <WrapPanel ItemSpacing="7" LineSpacing="5">
                                                                            <Border Classes="ModOpsPill">
                                                                                <TextBlock Text="{Binding StrategyText}" FontSize="10.5" Foreground="#B8C0CC" />
                                                                            </Border>
                                                                            <Border Classes="ModOpsPill">
                                                                                <TextBlock Text="{Binding CategoryText}" FontSize="10.5" Foreground="#B8C0CC" />
                                                                            </Border>
                                                                            <Border Classes="ModOpsPill">
                                                                                <TextBlock Text="{Binding ReasonText}" FontSize="10.5" Foreground="#B8C0CC" />
                                                                            </Border>
                                                                        </WrapPanel>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" Spacing="2" Width="92" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Mod.DownloadsText}" FontSize="11" FontWeight="SemiBold" Foreground="#F8FAFC" TextAlignment="Right" />
                                                                        <TextBlock Text="{Binding Mod.UpdatedText}" FontSize="10" Foreground="#A6ADBB" TextAlignment="Right" />
                                                                        <TextBlock Text="{Binding Mod.SourceText}" FontSize="10" Foreground="#A6ADBB" TextAlignment="Right" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="3"
                                                                                Orientation="Horizontal"
                                                                                Spacing="6"
                                                                                HorizontalAlignment="Right"
                                                                                VerticalAlignment="Center">
                                                                        <Button Classes="ModOpsFlatButton" MinWidth="70" Height="30" Padding="10,0" Command="{Binding #Root.DataContext.ViewNexusModDetailsCommand}" CommandParameter="{Binding Mod}" Content="{Binding #Root.DataContext.ModDetailText}" />
                                                                        <Button Classes="ModOpsPrimaryButton" Classes.downloaded="{Binding Mod.IsDownloaded}" MinWidth="64" Height="30" Padding="10,0" Command="{Binding #Root.DataContext.DownloadNexusModCommand}" CommandParameter="{Binding Mod}" Content="{Binding Mod.DownloadActionText}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </controls:StripedCardBorder>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                                </Grid>
                                            </ScrollViewer>
                                            <Border x:Name="ModRecommendationRowsScrollTrack"
                                                    Grid.Column="1"
                                                    Width="16"
                                                    CornerRadius="8"
                                                    Background="#14171D"
                                                    ClipToBounds="True"
                                                    PointerPressed="ModRecommendationRowsScrollTrack_OnPointerPressed"
                                                    PointerMoved="ModRecommendationRowsScrollTrack_OnPointerMoved"
                                                    PointerReleased="ModRecommendationRowsScrollTrack_OnPointerReleased"
                                                    PointerCaptureLost="ModRecommendationRowsScrollTrack_OnPointerCaptureLost">
                                                <Border x:Name="ModRecommendationRowsScrollThumb"
                                                        Width="12"
                                                        Height="56"
                                                        CornerRadius="6"
                                                        Background="#2563EB"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Top"
                                                        BoxShadow="0 2 8 0 #4D2563EB"
                                                        PointerPressed="ModRecommendationRowsScrollThumb_OnPointerPressed"
                                                        PointerMoved="ModRecommendationRowsScrollThumb_OnPointerMoved"
                                                        PointerReleased="ModRecommendationRowsScrollThumb_OnPointerReleased"
                                                        PointerCaptureLost="ModRecommendationRowsScrollThumb_OnPointerCaptureLost">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform Y="0" />
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </controls:StripedCardBorder>

                                <Grid IsVisible="{Binding IsLoadingModRecommendations}"
                                      ZIndex="10"
                                      IsHitTestVisible="True">
                                    <Border Background="#E80B1018"
                                            CornerRadius="7"
                                            ClipToBounds="True" />
                                    <StackPanel Width="280"
                                                Spacing="12"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Image Width="256"
                                               Height="128"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Stretch="Uniform"
                                               anim:ImageBehavior.AnimatedSource="avares://BohemiX.App/Assets/kcd2-bunny-loading-transparent.gif"
                                               anim:ImageBehavior.RepeatBehavior="Forever" />
                                        <TextBlock Text="{Binding ModRecommendationStatusText}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F8FAFC"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <ProgressBar Classes="ModOpsProgress"
                                                     Height="3"
                                                     IsIndeterminate="True" />
                                    </StackPanel>
                                </Grid>

                                <controls:StripedCardBorder Grid.Column="1" Classes="ModOpsSurface ModOpsInspectorSurface" MinHeight="0" VerticalAlignment="Stretch">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Spacing="12" Margin="0,0,4,0">
                                        <controls:StripedCardBorder Classes="ModOpsNotice RecommendationDecisionPanel"
                                                IsVisible="{Binding HasModRecommendations}"
                                                Padding="10">
                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="9">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="{Binding RecommendationReasonText}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                                    <Border Grid.Column="1" Classes="RecommendationHeatBadge" MinWidth="86" Height="28">
                                                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0">
                                                            <PathIcon Data="{StaticResource BmxIconFlame}" Width="13" Height="13" Foreground="#FB923C" />
                                                            <TextBlock Text="{Binding SelectedModRecommendation.HotnessText}" FontSize="11" FontWeight="SemiBold" Foreground="#FDBA74" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <Border Grid.Row="1" Height="132" CornerRadius="6" Background="#272C34" ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding SelectedModRecommendation.Mod.ThumbnailImage}" Stretch="UniformToFill" IsVisible="{Binding SelectedModRecommendation.Mod.HasThumbnail}" />
                                                        <StackPanel IsVisible="{Binding SelectedModRecommendation.Mod.HasNoThumbnail}"
                                                                    Spacing="5"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                            <PathIcon Data="{StaticResource BmxIconStar}" Width="18" Height="18" Foreground="#A6ADBB" HorizontalAlignment="Center" />
                                                            <TextBlock Text="{Binding SelectedModRecommendation.StrategyText}" FontSize="11" FontWeight="SemiBold" Foreground="#A6ADBB" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Row="2" Spacing="4">
                                                    <TextBlock Text="{Binding SelectedModRecommendation.Mod.Name}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" TextWrapping="Wrap" MaxLines="2" />
                                                    <TextBlock Text="{Binding SelectedModRecommendation.ReasonText}" FontSize="11" Foreground="#D8E0EA" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SelectedModRecommendation.ReasonDetailText}" FontSize="10.5" Foreground="#A6ADBB" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="3"
                                                            Spacing="6"
                                                            IsVisible="{Binding SelectedModRecommendation.Mod.HasSummary}">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <TextBlock Text="{Binding ModSummaryText}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#E5E7EB"
                                                                   VerticalAlignment="Center" />
                                                        <Button Grid.Column="1"
                                                                Classes="ModOpsFlatButton"
                                                                Height="28"
                                                                MinWidth="104"
                                                                Padding="9,0"
                                                                IsEnabled="{Binding SelectedModRecommendation.Mod.CanTranslateSummary}"
                                                                Command="{Binding TranslateModSummaryCommand}"
                                                                CommandParameter="{Binding SelectedModRecommendation.Mod}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                                <PathIcon Data="{StaticResource BmxIconLanguage}"
                                                                          Width="12"
                                                                          Height="12"
                                                                          IsVisible="{Binding !SelectedModRecommendation.Mod.IsSummaryTranslationBusy}" />
                                                                <ProgressBar Width="14"
                                                                             Height="3"
                                                                             IsIndeterminate="True"
                                                                             IsVisible="{Binding SelectedModRecommendation.Mod.IsSummaryTranslationBusy}" />
                                                                <TextBlock Text="{Binding SelectedModRecommendation.Mod.SummaryTranslationActionText}" FontSize="11" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                    <TextBlock Text="{Binding SelectedModRecommendation.Mod.SummaryDisplayText}"
                                                               FontSize="10.5"
                                                               LineHeight="15"
                                                               Foreground="#B8C0CC"
                                                               TextWrapping="Wrap"
                                                               MaxLines="6" />
                                                    <TextBlock Text="{Binding SelectedModRecommendation.Mod.SummaryTranslationNoticeText}"
                                                               IsVisible="{Binding SelectedModRecommendation.Mod.HasSummaryTranslationNotice}"
                                                               FontSize="10"
                                                               Foreground="#93C5FD"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SelectedModRecommendation.Mod.SummaryTranslationErrorText}"
                                                               IsVisible="{Binding SelectedModRecommendation.Mod.HasSummaryTranslationError}"
                                                               FontSize="10"
                                                               Foreground="#FCA5A5"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Border Grid.Row="4"
                                                        Classes="RecommendationHeatScale"
                                                        AutomationProperties.Name="{Binding SelectedModRecommendation.HeatExplanationText}">
                                                    <ToolTip.Tip>
                                                        <Border Classes="RecommendationSignalTooltip">
                                                            <StackPanel Spacing="5">
                                                                <TextBlock Text="{Binding RecommendationScoreText}" FontSize="12" FontWeight="SemiBold" Foreground="#FED7AA" />
                                                                <TextBlock Text="{Binding SelectedModRecommendation.HeatExplanationText}" FontSize="11" Foreground="#D8E0EA" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </ToolTip.Tip>
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                        <TextBlock Text="{Binding RecommendationScoreText}"
                                                                   FontSize="10.5"
                                                                   Foreground="#A6ADBB"
                                                                   VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1"
                                                                    Orientation="Horizontal"
                                                                    Spacing="5"
                                                                    HorizontalAlignment="Center">
                                                            <PathIcon Classes="RecommendationHeatGlyph" Classes.active="{Binding SelectedModRecommendation.IsHeatLevel1Active}" Data="{StaticResource BmxIconFlame}" />
                                                            <PathIcon Classes="RecommendationHeatGlyph" Classes.active="{Binding SelectedModRecommendation.IsHeatLevel2Active}" Data="{StaticResource BmxIconFlame}" />
                                                            <PathIcon Classes="RecommendationHeatGlyph" Classes.active="{Binding SelectedModRecommendation.IsHeatLevel3Active}" Data="{StaticResource BmxIconFlame}" />
                                                            <PathIcon Classes="RecommendationHeatGlyph" Classes.active="{Binding SelectedModRecommendation.IsHeatLevel4Active}" Data="{StaticResource BmxIconFlame}" />
                                                            <PathIcon Classes="RecommendationHeatGlyph" Classes.active="{Binding SelectedModRecommendation.IsHeatLevel5Active}" Data="{StaticResource BmxIconFlame}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding SelectedModRecommendation.HeatLevelText}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#FDBA74"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                                <Button Grid.Row="5"
                                                        Classes="ModOpsPrimaryButton"
                                                        Classes.downloaded="{Binding SelectedModRecommendation.Mod.IsDownloaded}"
                                                        MinWidth="86"
                                                        Height="34"
                                                        HorizontalAlignment="Stretch"
                                                        Command="{Binding DownloadNexusModCommand}"
                                                        CommandParameter="{Binding SelectedModRecommendation.Mod}"
                                                        Content="{Binding SelectedModRecommendation.Mod.DownloadActionText}" />
                                            </Grid>
                                        </controls:StripedCardBorder>
                                        <Border Classes="RecommendationBasisPanel">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBlock Text="{Binding RecommendationBasisText}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                                <WrapPanel Grid.Column="1" ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
                                                    <Border Classes="ModOpsPill"><TextBlock Text="{Binding CompatibilityFirstText}" FontSize="10" Foreground="#B8C0CC" /></Border>
                                                    <Border Classes="ModOpsPill"><TextBlock Text="{Binding StableText}" FontSize="10" Foreground="#B8C0CC" /></Border>
                                                    <Border Classes="ModOpsPill"><TextBlock Text="{Binding VisualsText}" FontSize="10" Foreground="#B8C0CC" /></Border>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                        <controls:StripedCardBorder Classes="ModOpsNotice QueueInspectorPanel"
                                                IsVisible="False"
                                                Padding="10"
                                                Margin="0,2,0,0"
                                                MinHeight="0"
                                                ClipToBounds="True">
                                            <Grid RowDefinitions="Auto,*" RowSpacing="10" MinHeight="0">
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                    <Button Classes="ModOpsQueueSegment"
                                                            Classes.active="{Binding IsDownloadingQueueSectionActive}"
                                                            Command="{Binding SetModDownloadQueueSectionCommand}"
                                                            CommandParameter="Downloading">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                            <TextBlock Text="{Binding DownloadingQueueText}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            <Border Grid.Column="1" MinWidth="32" Height="26" CornerRadius="6" Background="#1F2937" Padding="8,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ActiveModDownloadQueueCountText}" FontSize="12" FontWeight="SemiBold" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                    <Button Grid.Column="1"
                                                            Classes="ModOpsQueueSegment"
                                                            Classes.active="{Binding IsDownloadedQueueSectionActive}"
                                                            Command="{Binding SetModDownloadQueueSectionCommand}"
                                                            CommandParameter="Downloaded">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                            <TextBlock Text="{Binding DownloadedQueueText}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            <Border Grid.Column="1" MinWidth="32" Height="26" CornerRadius="6" Background="#1F2937" Padding="8,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DownloadedModDownloadQueueCountText}" FontSize="12" FontWeight="SemiBold" Foreground="#86EFAC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </Grid>

                                                <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="10" MinHeight="0">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <TextBlock Text="{Binding VisibleDownloadQueueSectionTitleText}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ActionsText}" FontSize="10" FontWeight="SemiBold" Foreground="#A6ADBB" VerticalAlignment="Center" />
                                                    </Grid>

                                                    <ScrollViewer Grid.Row="1"
                                                                  MaxHeight="220"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled">
                                                        <StackPanel Spacing="8">
                                                            <Border Classes="ModOpsQueueEmpty" IsVisible="{Binding IsVisibleModDownloadQueueEmpty}">
                                                                <StackPanel Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding VisibleDownloadQueueSectionTitleText}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                                                                    <TextBlock Text="{Binding VisibleDownloadQueueEmptyText}" FontSize="12" Foreground="#A6ADBB" TextAlignment="Center" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Border>

                                                            <ItemsControl ItemsSource="{Binding VisibleModDownloadQueueGroups}" IsVisible="{Binding HasVisibleModDownloadQueueItems}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:ModDownloadQueueGroupViewModel">
                                                                        <StackPanel Margin="0,0,0,12">
                                                                            <Border Classes="DownloadCenterQueueGroupHeader"
                                                                                    Classes.modpack="{Binding IsModPack}">
                                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                                                    <StackPanel Spacing="3" MinWidth="0">
                                                                                        <TextBlock Text="{Binding TitleText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                            <TextBlock Text="{Binding KindText}" FontSize="10" FontWeight="SemiBold" Foreground="#60A5FA" />
                                                                                            <TextBlock Text="{Binding SummaryText}" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                                                                                        </StackPanel>
                                                                                    </StackPanel>
                                                                                    <Border Grid.Column="1" MinWidth="46" Height="25" CornerRadius="5" Background="#1F2937" Padding="8,0" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding CountText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                    </Border>
                                                                                </Grid>
                                                                            </Border>
                                                                            <ItemsControl ItemsSource="{Binding Items}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:ModDownloadQueueRowViewModel">
                                                                        <Border Classes="ModOpsQueueTaskRow" Margin="0,0,0,8" controls:VisualResourceLifetime.IsEnabled="True">
                                                                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                                                    <StackPanel Spacing="3">
                                                                                        <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Text="{Binding ModText}" FontSize="10.5" Foreground="#A6ADBB" TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Text="{Binding SourceText}" FontSize="10.5" Foreground="#A6ADBB" TextTrimming="CharacterEllipsis" />
                                                                                    </StackPanel>
                                                                                    <Border Grid.Column="1"
                                                                                            MinWidth="76"
                                                                                            Height="26"
                                                                                            CornerRadius="6"
                                                                                            Background="{Binding StatusBadgeBackground}"
                                                                                            Padding="9,0"
                                                                                            VerticalAlignment="Top">
                                                                                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding StatusBadgeForeground}" TextAlignment="Center" VerticalAlignment="Center" />
                                                                                    </Border>
                                                                                </Grid>

                                                                                <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="6">
                                                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                                        <TextBlock Text="{Binding ProgressText}" FontSize="10.5" Foreground="#A6ADBB" TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Grid.Column="1" Text="{Binding ProgressPercentText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                                                                    </Grid>
                                                                                    <ProgressBar Grid.Row="1" Classes="ModOpsProgress" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" />
                                                                                </Grid>

                                                                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                                                            <TextBlock Text="{Binding SizeText}" FontSize="10.5" Foreground="#A6ADBB" TextTrimming="CharacterEllipsis" />
                                                                                            <TextBlock Text="{Binding SpeedText}" FontSize="10.5" Foreground="#A6ADBB" TextTrimming="CharacterEllipsis" />
                                                                                        </StackPanel>
                                                                                        <TextBlock Text="{Binding InstallText}" FontSize="10" Foreground="#A6ADBB" TextTrimming="CharacterEllipsis" />
                                                                                    </StackPanel>
                                                                                    <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
                                                                                        <Button Classes="ModOpsFlatButton"
                                                                                                Height="26"
                                                                                                Padding="8,0"
                                                                                                IsVisible="{Binding CanPause}"
                                                                                                Command="{Binding #Root.DataContext.PauseModDownloadCommand}"
                                                                                                CommandParameter="{Binding}"
                                                                                                Content="{Binding #Root.DataContext.PauseText}" />
                                                                                        <Button Classes="ModOpsFlatButton"
                                                                                                Height="26"
                                                                                                Padding="8,0"
                                                                                                IsVisible="{Binding CanResume}"
                                                                                                Command="{Binding #Root.DataContext.ResumeModDownloadCommand}"
                                                                                                CommandParameter="{Binding}"
                                                                                                Content="{Binding #Root.DataContext.ResumeText}" />
                                                                                        <Button Classes="ModOpsFlatButton"
                                                                                                Height="26"
                                                                                                Padding="8,0"
                                                                                                IsVisible="{Binding CanRetry}"
                                                                                                Command="{Binding #Root.DataContext.RetryModDownloadCommand}"
                                                                                                CommandParameter="{Binding}"
                                                                                                Content="{Binding #Root.DataContext.RetryText}" />
                                                                                        <Button Classes="ModOpsFlatButton"
                                                                                                Height="26"
                                                                                                Padding="8,0"
                                                                                                IsVisible="{Binding CanOpenFolder}"
                                                                                                Command="{Binding #Root.DataContext.OpenModDownloadFolderCommand}"
                                                                                                CommandParameter="{Binding}"
                                                                                                Content="{Binding #Root.DataContext.OpenFolderText}" />
                                                                                        <Button Classes="ModOpsDangerButton"
                                                                                                Height="26"
                                                                                                Padding="8,0"
                                                                                                IsVisible="{Binding CanCancel}"
                                                                                                Command="{Binding #Root.DataContext.CancelModDownloadCommand}"
                                                                                                CommandParameter="{Binding}"
                                                                                                Content="{Binding #Root.DataContext.CancelText}" />
                                                                                    </WrapPanel>
                                                                                </Grid>
                                                                            </Grid>
                                                                        </Border>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Grid>
                                            </Grid>
                                        </controls:StripedCardBorder>
                                    </StackPanel>
                                    </ScrollViewer>
                                </controls:StripedCardBorder>
                            </Grid>
                        </Grid>
                    </controls:StripedCardBorder>
                </Grid>
                            </Grid>
                        </DataTemplate>
                    </controls:DisposableWorkspaceHost.LazyContentTemplate>
                </controls:DisposableWorkspaceHost>
            </StackPanel>

            <Button x:Name="LauncherToggleButton"
                    IsVisible="{Binding IsLauncherDashboardVisible}"
                    Width="48"
                    Height="48"
                    Padding="0"
                    CornerRadius="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,24,0,0"
                    Background="#26FFFFFF"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="1"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    ToolTip.Tip="{Binding ScrollForDetailsText}"
                    PointerEntered="LauncherToggleButton_OnPointerEntered"
                    PointerExited="LauncherToggleButton_OnPointerExited"
                    Click="LauncherToggleButton_OnClick">
                <Button.RenderTransform>
                    <TranslateTransform Y="612" />
                </Button.RenderTransform>
                <PathIcon x:Name="LauncherToggleIcon"
                          Data="{StaticResource BmxIconChevronDown}"
                          Width="20"
                          Height="20"
                          Foreground="White"
                          RenderTransformOrigin="50%,50%">
                    <PathIcon.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                            <RotateTransform Angle="0" />
                            <TranslateTransform Y="0" />
                        </TransformGroup>
                    </PathIcon.RenderTransform>
                </PathIcon>
            </Button>
        </Grid>

        <Grid x:Name="SettingsSurface"
              Margin="184,56,0,0"
              ClipToBounds="True"
              Background="Transparent"
              IsVisible="{Binding IsSettingsView}"
              ZIndex="10">
            <controls:DisposableWorkspaceHost x:Name="SettingsWorkspaceHost" Kind="Settings">
                <controls:DisposableWorkspaceHost.LazyContentTemplate>
                    <DataTemplate x:DataType="vm:MainWindowViewModel">
            <ScrollViewer Margin="32,34,28,32"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding SettingsWorkspaceTitle}"
                                   FontSize="34"
                                   FontWeight="ExtraBold"
                                   Foreground="White" />
                        <TextBlock Text="{Binding SettingsCategoryDescription}"
                                   MaxWidth="680"
                                   FontSize="13.5"
                                   LineHeight="22"
                                   Foreground="#B3FFFFFF"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <controls:StripedCardBorder Classes="SettingsPanel"
                                                IsVisible="{Binding IsSettingsConfigurationActive}"
                                                IsStripeMotionEnabled="{Binding !ReduceMotion}">
                        <controls:StripedCardBorder.Resources>
                            <SolidColorBrush x:Key="GlyphInkBrush" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="GlyphMutedBrush" Color="#D7D7D7" />
                        </controls:StripedCardBorder.Resources>
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding SettingsCategoryTitle}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource GlyphInkBrush}" />
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="12"
                                               Foreground="{StaticResource GlyphMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Top">
                                    <Button Classes="GlyphGlassButton"
                                            Height="34"
                                            Padding="16,0"
                                            Foreground="{StaticResource GlyphInkBrush}"
                                            Command="{Binding ResetSettingsCommand}"
                                            Content="{Binding ResetButtonText}" />
                                    <Button Classes="GlyphPrimaryButton"
                                            Height="34"
                                            Padding="16,0"
                                            Command="{Binding ApplySettingsCommand}"
                                            Content="{Binding ApplyButtonText}" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Height="1" Background="#24FFFFFF" />

                            <StackPanel Grid.Row="2"
                                        Spacing="12"
                                        IsVisible="{Binding IsSettingsNavigationActive}">
                                <controls:StripedCardBorder Classes="SettingRow">
                                    <Grid ColumnDefinitions="*,260" ColumnSpacing="16">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding LanguageSettingText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GlyphInkBrush}" />
                                            <TextBlock Text="{Binding LanguageSettingDescriptionText}" FontSize="11.5" Foreground="{StaticResource GlyphMutedBrush}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  Classes="SettingsComboBox"
                                                  ItemsSource="{Binding AvailableLanguages}"
                                                  SelectedItem="{Binding SelectedLanguage}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{StaticResource GlyphInkBrush}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </controls:StripedCardBorder>

                                <controls:StripedCardBorder Classes="SettingRow">
                                    <Grid ColumnDefinitions="*,260" ColumnSpacing="16">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding DefaultPageSettingText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GlyphInkBrush}" />
                                            <TextBlock Text="{Binding DefaultPageSettingDescriptionText}" FontSize="11.5" Foreground="{StaticResource GlyphMutedBrush}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  Classes="SettingsComboBox"
                                                  ItemsSource="{Binding DefaultNavigationTargets}"
                                                  SelectedItem="{Binding DefaultNavigationTarget}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{StaticResource GlyphInkBrush}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </controls:StripedCardBorder>

                                <controls:StripedCardBorder Classes="SettingRow">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding TopNavigationTooltipsText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GlyphInkBrush}" />
                                            <TextBlock Text="{Binding TopNavigationTooltipsDescriptionText}" FontSize="11.5" Foreground="{StaticResource GlyphMutedBrush}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Classes="SettingsToggle" IsChecked="{Binding ShowNavigationTooltips}" VerticalAlignment="Center" />
                                    </Grid>
                                </controls:StripedCardBorder>

                                <controls:StripedCardBorder Classes="SettingRow">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding KeepTopNavigationVisibleText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GlyphInkBrush}" />
                                            <TextBlock Text="{Binding KeepTopNavigationVisibleDescriptionText}" FontSize="11.5" Foreground="{StaticResource GlyphMutedBrush}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Classes="SettingsToggle" IsChecked="{Binding KeepTopNavigationVisible}" VerticalAlignment="Center" />
                                    </Grid>
                                </controls:StripedCardBorder>

                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Spacing="12"
                                        IsVisible="{Binding IsSettingsLaunchActive}">
                                <controls:StripedCardBorder Classes="SettingRow">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding ScanOnStartupText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GlyphInkBrush}" />
                                            <TextBlock Text="{Binding ScanOnStartupDescriptionText}" FontSize="11.5" Foreground="{StaticResource GlyphMutedBrush}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Classes="SettingsToggle" IsChecked="{Binding AutoDiscoverOnStartup}" VerticalAlignment="Center" />
                                    </Grid>
                                </controls:StripedCardBorder>

                                <controls:StripedCardBorder Classes="SettingRow">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding PrepareVfsText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GlyphInkBrush}" />
                                            <TextBlock Text="{Binding PrepareVfsDescriptionText}" FontSize="11.5" Foreground="{StaticResource GlyphMutedBrush}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Classes="SettingsToggle" IsChecked="{Binding EnableVfsBeforeLaunch}" VerticalAlignment="Center" />
                                    </Grid>
                                </controls:StripedCardBorder>

                                <controls:StripedCardBorder Classes="SettingRow">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding LaunchArgumentsText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GlyphInkBrush}" />
                                                <TextBlock Text="{Binding LaunchArgumentsDescriptionText}" FontSize="11.5" Foreground="{StaticResource GlyphMutedBrush}" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Classes="SettingsToggle" Content="{Binding UseSteamProtocolText}" IsChecked="{Binding UseSteamProtocol}" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBox Text="{Binding LaunchArguments}"
                                                 Watermark="-devmode"
                                                 FontSize="12"
                                                 CornerRadius="10"
                                                 BorderThickness="1"
                                                 Foreground="#FFFFFFFF"
                                                 Background="#0F1116"
                                                 BorderBrush="#30343D" />
                                    </StackPanel>
                                </controls:StripedCardBorder>

                                <controls:StripedCardBorder Classes="SettingRow">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding WindowBehaviorText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GlyphInkBrush}" />
                                            <TextBlock Text="{Binding WindowBehaviorDescriptionText}" FontSize="11.5" Foreground="{StaticResource GlyphMutedBrush}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Classes="SettingsToggle" Content="{Binding MinimizeText}" IsChecked="{Binding MinimizeOnLaunch}" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="2" Classes="SettingsToggle" Content="{Binding CloseText}" IsChecked="{Binding CloseAfterLaunch}" VerticalAlignment="Center" />
                                    </Grid>
                                </controls:StripedCardBorder>
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Spacing="12"
                                        IsVisible="{Binding IsSettingsModsActive}">
                                <controls:StripedCardBorder Classes="SettingRow">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding CheckConflictsBeforeLaunchText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GlyphInkBrush}" />
                                            <TextBlock Text="{Binding CheckConflictsBeforeLaunchDescriptionText}" FontSize="11.5" Foreground="{StaticResource GlyphMutedBrush}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Classes="SettingsToggle" IsChecked="{Binding CheckModConflictsBeforeLaunch}" VerticalAlignment="Center" />
                                    </Grid>
                                </controls:StripedCardBorder>

                                <controls:StripedCardBorder Classes="SettingRow">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding InstalledModsText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GlyphInkBrush}" />
                                            <TextBlock Text="{Binding SelectedSection.Detail}" FontSize="11.5" Foreground="{StaticResource GlyphMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Classes="GlyphPrimaryButton"
                                                Height="34"
                                                Padding="14,0"
                                                Command="{Binding LoadModsCommand}"
                                                Content="{Binding RefreshText}" />
                                    </Grid>
                                </controls:StripedCardBorder>

                                <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
                                    <controls:StripedCardBorder Classes="SettingRow">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding ModCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource GlyphInkBrush}" />
                                            <TextBlock Text="{Binding RegisteredModsText}" FontSize="11.5" Foreground="{StaticResource GlyphMutedBrush}" />
                                        </StackPanel>
                                    </controls:StripedCardBorder>
                                    <controls:StripedCardBorder Grid.Column="1" Classes="SettingRow">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding ConflictCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource GlyphInkBrush}" />
                                            <TextBlock Text="{Binding DetectedConflictsText}" FontSize="11.5" Foreground="{StaticResource GlyphMutedBrush}" />
                                        </StackPanel>
                                    </controls:StripedCardBorder>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Spacing="12"
                                        IsVisible="{Binding IsSettingsAppearanceActive}">
                                <controls:StripedCardBorder Classes="SettingRow">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding AcrylicGlassEffectsText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GlyphInkBrush}" />
                                            <TextBlock Text="{Binding AcrylicGlassEffectsDescriptionText}" FontSize="11.5" Foreground="{StaticResource GlyphMutedBrush}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Classes="SettingsToggle" IsChecked="{Binding EnableAcrylicEffects}" VerticalAlignment="Center" />
                                    </Grid>
                                </controls:StripedCardBorder>

                                <controls:StripedCardBorder Classes="SettingRow">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding ReduceMotionText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GlyphInkBrush}" />
                                            <TextBlock Text="{Binding ReduceMotionDescriptionText}" FontSize="11.5" Foreground="{StaticResource GlyphMutedBrush}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Classes="SettingsToggle" IsChecked="{Binding ReduceMotion}" VerticalAlignment="Center" />
                                    </Grid>
                                </controls:StripedCardBorder>

                                <controls:StripedCardBorder Classes="SettingRow">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding BackdropDimStrengthText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GlyphInkBrush}" />
                                                <TextBlock Text="{Binding BackdropDimStrengthDescriptionText}" FontSize="11.5" Foreground="{StaticResource GlyphMutedBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding BackgroundDimLevel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GlyphPrimaryBrush}" />
                                        </Grid>
                                        <Slider Minimum="30" Maximum="90" Value="{Binding BackgroundDimLevel}" />
                                    </StackPanel>
                                </controls:StripedCardBorder>

                                <controls:StripedCardBorder Classes="SettingRow">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding CompactLeftNavigationText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GlyphInkBrush}" />
                                            <TextBlock Text="{Binding CompactLeftNavigationDescriptionText}" FontSize="11.5" Foreground="{StaticResource GlyphMutedBrush}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Classes="SettingsToggle" IsChecked="{Binding CompactSidebar}" VerticalAlignment="Center" />
                                    </Grid>
                                </controls:StripedCardBorder>
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Spacing="12"
                                        IsVisible="{Binding IsSettingsGraphicsActive}">
                                <controls:StripedCardBorder Classes="SettingRow">
                                    <Grid ColumnDefinitions="*,260" ColumnSpacing="16">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding ForgeRenderQualityText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GlyphInkBrush}" />
                                            <TextBlock Text="{Binding ForgeRenderQualityDescriptionText}" FontSize="11.5" Foreground="{StaticResource GlyphMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  Classes="SettingsComboBox"
                                                  ItemsSource="{Binding ForgeQualityOptions}"
                                                  SelectedIndex="{Binding ForgeRenderQualityIndex}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{StaticResource GlyphInkBrush}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </controls:StripedCardBorder>

                                <controls:StripedCardBorder Classes="SettingRow">
                                    <Grid ColumnDefinitions="*,260" ColumnSpacing="16">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding ForgeTextureQualityText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GlyphInkBrush}" />
                                            <TextBlock Text="{Binding ForgeTextureQualityDescriptionText}" FontSize="11.5" Foreground="{StaticResource GlyphMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  Classes="SettingsComboBox"
                                                  ItemsSource="{Binding ForgeQualityOptions}"
                                                  SelectedIndex="{Binding ForgeTextureQualityIndex}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{StaticResource GlyphInkBrush}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </controls:StripedCardBorder>

                                <TextBlock Text="{Binding ForgeSettingsApplyNextEntryText}"
                                           Margin="4,0"
                                           FontSize="11.5"
                                           Foreground="{StaticResource GlyphMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Spacing="12"
                                        IsVisible="{Binding IsSettingsStorageActive}">
                                <controls:StripedCardBorder Classes="SettingRow">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding DataDirectoryText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GlyphInkBrush}" />
                                            <Button Grid.Column="1" Classes="GlyphPrimaryButton" Height="32" Padding="14,0" Command="{Binding OpenDataFolderCommand}" Content="{Binding OpenText}" />
                                        </Grid>
                                        <TextBox Text="{Binding DataDirectory}" IsReadOnly="True" FontSize="12" CornerRadius="10" Foreground="#FFFFFFFF" Background="#0F1116" BorderBrush="#30343D" />
                                    </StackPanel>
                                </controls:StripedCardBorder>

                                <controls:StripedCardBorder Classes="SettingRow">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding ModsDirectoryText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GlyphInkBrush}" />
                                            <Button Grid.Column="1" Classes="GlyphPrimaryButton" Height="32" Padding="14,0" Command="{Binding OpenModsFolderCommand}" Content="{Binding OpenText}" />
                                        </Grid>
                                        <TextBox Text="{Binding ModsDirectory}" IsReadOnly="True" FontSize="12" CornerRadius="10" Foreground="#FFFFFFFF" Background="#0F1116" BorderBrush="#30343D" />
                                    </StackPanel>
                                </controls:StripedCardBorder>

                                <controls:StripedCardBorder Classes="SettingRow">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding DatabaseLabelText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GlyphInkBrush}" />
                                        <TextBox Text="{Binding DatabasePath}" IsReadOnly="True" FontSize="12" CornerRadius="10" Foreground="#FFFFFFFF" Background="#0F1116" BorderBrush="#30343D" />
                                    </StackPanel>
                                </controls:StripedCardBorder>
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Spacing="12"
                                        IsVisible="{Binding IsSettingsAdvancedActive}">
                                <controls:StripedCardBorder Classes="SettingRow">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding RuntimeStateText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GlyphInkBrush}" />
                                            <TextBlock Text="{Binding StorageText}" FontSize="11.5" Foreground="{StaticResource GlyphMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding VfsStateText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GlyphPrimaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </controls:StripedCardBorder>

                                <controls:StripedCardBorder Classes="SettingRow">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Kcd2ExecutableText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GlyphInkBrush}" />
                                            <TextBlock Text="{Binding Kcd2ExecutablePath}" FontSize="11.5" Foreground="{StaticResource GlyphMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding VerificationText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GlyphPrimaryBrush}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2"
                                                Classes="GlyphDangerButton"
                                                Height="32"
                                                Padding="14,0"
                                                Command="{Binding ResetKcd2GameDirectoryCommand}"
                                                Content="{Binding ResetKcd2GameDirectoryText}" />
                                    </Grid>
                                </controls:StripedCardBorder>

                                <controls:StripedCardBorder Classes="SettingRow">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding LastActionLabelText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource GlyphInkBrush}" />
                                        <TextBlock Text="{Binding LastActionText}" FontSize="11.5" Foreground="{StaticResource GlyphMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </controls:StripedCardBorder>
                            </StackPanel>
                        </Grid>
                    </controls:StripedCardBorder>

                    <Grid IsVisible="{Binding IsSettingsMoreActive}">
                        <community:MoreSettingsView DataContext="{Binding MoreSettings}"
                                                    Title="{Binding #Root.DataContext.SettingsCategoryTitle}"
                                                    IsStripeMotionEnabled="{Binding !#Root.DataContext.ReduceMotion}" />
                    </Grid>

                    <Grid IsVisible="{Binding IsSettingsPlayerProfilesActive}">
                        <playerProfiles:PlayerProfileSettingsView DataContext="{Binding PlayerProfiles}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
                    </DataTemplate>
                </controls:DisposableWorkspaceHost.LazyContentTemplate>
            </controls:DisposableWorkspaceHost>

        </Grid>

        <Button Classes="DownloadCenterLauncher"
                IsVisible="{Binding IsDownloadLauncherVisible}"
                Command="{Binding OpenDownloadCenterCommand}"
                ToolTip.Tip="{Binding DownloadCenterLauncherTooltipText}"
                AutomationProperties.Name="{Binding DownloadCenterLauncherTooltipText}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,28,28"
                ZIndex="75">
            <Grid Width="54" Height="54">
                <PathIcon Data="{StaticResource BmxIconDownload}"
                          Width="21"
                          Height="21"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                <Border MinWidth="22"
                        Height="22"
                        Padding="6,0"
                        CornerRadius="11"
                        Background="#F8FAFC"
                        BorderBrush="#2563EB"
                        BorderThickness="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-4,-4,0">
                    <TextBlock Text="{Binding ActiveModDownloadQueueCountText}"
                               FontSize="10.5"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Button>

        <Grid x:Name="DownloadCenterSurface"
              IsVisible="{Binding IsDownloadCenterVisible}"
              Margin="184,56,0,0"
              Background="Transparent"
              ClipToBounds="True"
              ZIndex="10">
            <controls:StripedCardBorder Classes="ModOpsWorkspacePanel"
                                        Margin="32,32,28,18"
                                        Padding="0"
                                        Background="#101114"
                                        StripeOpacity="0.12"
                                        StripeSpeed="8"
                                        IsStripeMotionEnabled="{Binding !ReduceMotion}"
                                        ClipToBounds="True">
                <Grid RowDefinitions="Auto,1,*"
                      MinHeight="0">
                <Grid Margin="20,16"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="16">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="6"
                                    Background="#10253E"
                                    BorderBrush="#2563EB"
                                    BorderThickness="1">
                                <PathIcon Data="{StaticResource BmxIconDownload}"
                                          Width="15"
                                          Height="15"
                                          Foreground="#93C5FD"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding DownloadQueueText}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#F8FAFC"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding ModDownloadQueueSummaryText}"
                                   FontSize="11.5"
                                   Foreground="#A6ADBB" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="DownloadCenterIconButton"
                            VerticalAlignment="Center"
                            Command="{Binding OpenModDownloadDirectoryCommand}"
                            ToolTip.Tip="{Binding OpenDownloadDirectoryText}"
                            AutomationProperties.Name="{Binding OpenDownloadDirectoryText}">
                        <PathIcon Data="{StaticResource BmxIconFolder}" Width="15" Height="15" />
                    </Button>
                </Grid>

                <Border Grid.Row="1" Background="#303640" />

                    <Grid Grid.Row="2" ColumnDefinitions="0.9*,1.1*" MinHeight="0">
                        <Grid Margin="26"
                              RowDefinitions="Auto,Auto,*"
                              RowSpacing="16"
                              MinWidth="350"
                              MinHeight="0">
                            <Border Height="168"
                                    CornerRadius="6"
                                    Background="#171A20"
                                    BorderBrush="#38404B"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    IsVisible="{Binding HasSelectedDownloadQueueItem}"
                                    ToolTip.Tip="{Binding SelectedDownloadQueueItem.ModName}">
                                <Image Source="{Binding SelectedDownloadQueueItem.CoverImage}"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch" />
                            </Border>

                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding CurrentDownloadText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#94A3B8" />
                                    <TextBlock Text="{Binding SelectedDownloadQueueItem.FileName}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="#F8FAFC"
                                               TextWrapping="Wrap"
                                               MaxLines="2" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        MinWidth="76"
                                        Height="27"
                                        CornerRadius="5"
                                        Background="{Binding SelectedDownloadQueueItem.StatusBadgeBackground}"
                                        Padding="9,0"
                                        VerticalAlignment="Top"
                                        IsVisible="{Binding HasSelectedDownloadQueueItem}">
                                    <TextBlock Text="{Binding SelectedDownloadQueueItem.StatusBadgeText}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding SelectedDownloadQueueItem.StatusBadgeForeground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="2"
                                       Text="{Binding DownloadCenterEmptyText}"
                                       FontSize="13"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !HasSelectedDownloadQueueItem}" />

                            <Grid Grid.Row="2"
                                  RowDefinitions="Auto,Auto,Auto,*"
                                  RowSpacing="18"
                                  IsVisible="{Binding HasSelectedDownloadQueueItem}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding ProgressColumnText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#94A3B8" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SelectedDownloadQueueItem.ProgressPercentText}"
                                                   FontSize="30"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F8FAFC" />
                                    </Grid>
                                    <ProgressBar Classes="ModOpsProgress"
                                                 Height="8"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding SelectedDownloadQueueItem.ProgressPercent}" />
                                    <TextBlock Text="{Binding SelectedDownloadQueueItem.ProgressText}"
                                               FontSize="11.5"
                                               Foreground="#94A3B8" />
                                </StackPanel>

                                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="24">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding SpeedColumnText}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#64748B" />
                                        <TextBlock Text="{Binding SelectedDownloadQueueItem.SpeedText}"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"
                                                   Foreground="#60A5FA" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{Binding SizeColumnText}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#64748B" />
                                        <TextBlock Text="{Binding SelectedDownloadQueueItem.SizeText}"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"
                                                   Foreground="#E2E8F0" />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="2" Height="1" Background="#27303B" />

                                <StackPanel Grid.Row="3" Spacing="8">
                                    <TextBlock Text="{Binding SelectedDownloadQueueItem.ModText}"
                                               FontSize="11.5"
                                               Foreground="#94A3B8" />
                                    <TextBlock Text="{Binding SelectedDownloadQueueItem.StatusText}"
                                               FontSize="11.5"
                                               Foreground="#CBD5E1"
                                               TextWrapping="Wrap"
                                               MaxLines="3" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Border Grid.Column="1"
                                Background="#B812151A"
                                BorderBrush="#303640"
                                BorderThickness="1,0,0,0"
                                Padding="18">
                            <Grid RowDefinitions="Auto,*" RowSpacing="14" MinHeight="0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding DownloadQueueText}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F8FAFC" />
                                        <TextBlock Text="{Binding ModDownloadQueueThroughputText}"
                                                   FontSize="10.5"
                                                   Foreground="#94A3B8" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            MinWidth="34"
                                            Height="26"
                                            Padding="8,0"
                                            CornerRadius="5"
                                            Background="#1F2937"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ActiveModDownloadQueueCountText}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#60A5FA"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1" MinHeight="0">
                                    <Border Classes="ModOpsQueueEmpty"
                                            IsVisible="{Binding IsModDownloadQueueEmpty}">
                                        <TextBlock Text="{Binding NoTasksText}"
                                                   FontSize="12.5"
                                                   Foreground="#64748B"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <ScrollViewer IsVisible="{Binding HasModDownloadQueueItems}"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding ModDownloadQueueGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ModDownloadQueueGroupViewModel">
                                                    <StackPanel Margin="0,0,0,14">
                                                        <Border Classes="DownloadCenterQueueGroupHeader"
                                                                Classes.modpack="{Binding IsModPack}">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                                <StackPanel Spacing="3" MinWidth="0">
                                                                    <TextBlock Text="{Binding TitleText}"
                                                                               FontSize="12.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#F8FAFC"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <TextBlock Text="{Binding KindText}"
                                                                                   FontSize="10"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#60A5FA" />
                                                                        <TextBlock Text="{Binding SummaryText}"
                                                                                   FontSize="10"
                                                                                   Foreground="#94A3B8"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <Border Grid.Column="1"
                                                                        MinWidth="46"
                                                                        Height="25"
                                                                        CornerRadius="5"
                                                                        Background="#1F2937"
                                                                        Padding="8,0"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding CountText}"
                                                                               FontSize="10.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#CBD5E1"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <ListBox Classes="DownloadCenterQueueList"
                                                                 ItemsSource="{Binding Items}"
                                                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ModDownloadQueueRowViewModel">
                                                <Border Classes="DownloadCenterQueueRow" controls:VisualResourceLifetime.IsEnabled="True">
                                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="9">
                                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                            <StackPanel Spacing="3" MinWidth="0">
                                                                <TextBlock Text="{Binding FileName}"
                                                                           FontSize="12.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#F8FAFC"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Border Background="{Binding StatusBadgeBackground}"
                                                                            CornerRadius="4"
                                                                            Padding="6,2">
                                                                        <TextBlock Text="{Binding StatusBadgeText}"
                                                                                   FontSize="9.5"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{Binding StatusBadgeForeground}" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding SpeedText}"
                                                                               FontSize="10"
                                                                               Foreground="#94A3B8" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <Grid Grid.Column="1" Width="30" Height="30">
                                                                <Button Classes="DownloadCenterIconButton DownloadCenterHoverAction"
                                                                        IsVisible="{Binding CanPause}"
                                                                        Command="{Binding #Root.DataContext.PauseModDownloadCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip.Tip="{Binding #Root.DataContext.PauseText}"
                                                                        AutomationProperties.Name="{Binding #Root.DataContext.PauseText}">
                                                                    <PathIcon Data="{StaticResource BmxIconPause}" Width="13" Height="13" />
                                                                </Button>
                                                                <Button Classes="DownloadCenterIconButton DownloadCenterHoverAction"
                                                                        IsVisible="{Binding CanResume}"
                                                                        Command="{Binding #Root.DataContext.ResumeModDownloadCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip.Tip="{Binding #Root.DataContext.ResumeText}"
                                                                        AutomationProperties.Name="{Binding #Root.DataContext.ResumeText}">
                                                                    <PathIcon Data="{StaticResource BmxIconPlay}" Width="13" Height="13" />
                                                                </Button>
                                                                <Button Classes="DownloadCenterIconButton DownloadCenterHoverAction"
                                                                        IsVisible="{Binding CanRetry}"
                                                                        Command="{Binding #Root.DataContext.RetryModDownloadCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip.Tip="{Binding #Root.DataContext.RetryText}"
                                                                        AutomationProperties.Name="{Binding #Root.DataContext.RetryText}">
                                                                    <PathIcon Data="{StaticResource BmxIconRefresh}" Width="13" Height="13" />
                                                                </Button>
                                                            </Grid>

                                                            <Button Grid.Column="2"
                                                                    Classes="DownloadCenterCancelButton"
                                                                    IsVisible="{Binding CanCancel}"
                                                                    Command="{Binding #Root.DataContext.CancelModDownloadCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="{Binding #Root.DataContext.CancelText}"
                                                                    AutomationProperties.Name="{Binding #Root.DataContext.CancelText}">
                                                                <TextBlock Text="×" FontSize="18" LineHeight="18" VerticalAlignment="Center" />
                                                            </Button>
                                                        </Grid>

                                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                            <TextBlock Text="{Binding ProgressText}"
                                                                       FontSize="10.5"
                                                                       Foreground="#94A3B8"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding ProgressPercentText}"
                                                                       FontSize="10.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#E2E8F0" />
                                                        </Grid>

                                                        <ProgressBar Grid.Row="2"
                                                                     Classes="ModOpsProgress"
                                                                     Height="5"
                                                                     Minimum="0"
                                                                     Maximum="100"
                                                                     Value="{Binding ProgressPercent}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </controls:StripedCardBorder>
        </Grid>

        <controls:DisposableWorkspaceHost x:Name="InstallVerificationDialogHost"
                                          Kind="Home"
                                          ZIndex="110"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch">
            <controls:DisposableWorkspaceHost.LazyContentTemplate>
                <DataTemplate x:DataType="vm:MainWindowViewModel">
                    <Grid>
        <Grid IsVisible="{Binding IsInstallVerificationDialogOpen}"
              ZIndex="100">
            <Button Command="{Binding CloseInstallVerificationDialogCommand}"
                    Background="#CC050A14"
                    BorderBrush="Transparent"
                    BorderThickness="0" />

            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="640"
                  IsHitTestVisible="True">
                <controls:StripedCardBorder Classes="ModOpsWorkspacePanel"
                                            IsStripeMotionEnabled="{Binding !ReduceMotion}"
                                            BoxShadow="0 24 64 0 #90000000">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <controls:StripedCardBorder Classes="ModOpsHeaderStrip">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="12">
                            <Border Width="38"
                                    Height="38"
                                    CornerRadius="6"
                                    Background="#15243D"
                                    BorderBrush="#2563EB"
                                    BorderThickness="1">
                                <PathIcon Data="{StaticResource BmxIconVerified}"
                                          Width="18"
                                          Height="18"
                                          Foreground="#93C5FD"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding VerificationDialogTitleText}"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="#F8FAFC" />
                                <TextBlock Text="{Binding VerificationDialogIntroText}"
                                           FontSize="12.5"
                                           Foreground="#A6ADBB" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Classes="ModOpsFlatButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Command="{Binding CloseInstallVerificationDialogCommand}"
                                    ToolTip.Tip="{Binding CloseText}"
                                    AutomationProperties.Name="{Binding CloseText}">
                                <PathIcon Data="{StaticResource BmxIconClose}"
                                          Width="15"
                                          Height="15" />
                            </Button>
                            </Grid>
                        </controls:StripedCardBorder>

                        <Border Grid.Row="1"
                                Classes="ModOpsSurface">
                            <Grid>
                                <StackPanel Spacing="16"
                                            IsVisible="{Binding IsOwnershipChoiceVisible}">
                                    <TextBlock Text="{Binding VerificationDialogQuestionText}"
                                               FontSize="15"
                                               FontWeight="Medium"
                                               Foreground="#F8FAFC" />

                                    <Grid ColumnDefinitions="1*,1*" ColumnSpacing="10">
                                        <Button Classes="ModOpsFlatButton"
                                                Height="44"
                                                Command="{Binding OpenSteamPurchaseCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <PathIcon Data="{StaticResource BmxIconExternal}" Width="15" Height="15" />
                                                <TextBlock Text="{Binding VerificationDialogPurchaseText}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1"
                                                Classes="ModOpsPrimaryButton"
                                                Height="44"
                                                Command="{Binding ShowOwnedGameOptionsCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <PathIcon Data="{StaticResource BmxIconCheck}" Width="15" Height="15" />
                                                <TextBlock Text="{Binding VerificationDialogOwnedText}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="18"
                                            IsVisible="{Binding IsOwnedGameOptionsVisible}">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="{Binding AutomaticSearchTitleText}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F8FAFC" />
                                        <Button Classes="ModOpsPrimaryButton"
                                                Height="44"
                                                HorizontalContentAlignment="Center"
                                                Command="{Binding AutoSearchFromDialogCommand}"
                                                IsEnabled="{Binding IsAutoSearchButtonEnabled}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <PathIcon Data="{StaticResource BmxIconSearch}" Width="16" Height="16" />
                                                <TextBlock Text="{Binding AutoSearchButtonText}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="ModOpsFlatButton"
                                                Height="40"
                                                HorizontalContentAlignment="Center"
                                                Command="{Binding DeepSearchFromDialogCommand}"
                                                IsEnabled="{Binding IsAutoSearchButtonEnabled}"
                                                IsVisible="{Binding IsDeepGameSearchAvailable}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <PathIcon Data="{StaticResource BmxIconSearch}" Width="15" Height="15" />
                                                <TextBlock Text="{Binding DeepSearchButtonText}" />
                                            </StackPanel>
                                        </Button>
                                        <ProgressBar Classes="ModOpsProgress"
                                                     Height="3"
                                                     IsIndeterminate="True"
                                                     IsVisible="{Binding IsAutoSearchInProgress}" />
                                    </StackPanel>

                                    <Border Classes="ModOpsNotice">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                            <PathIcon Data="{StaticResource BmxIconInfo}"
                                                      Width="15"
                                                      Height="15"
                                                      Foreground="#60A5FA"
                                                      VerticalAlignment="Top"
                                                      Margin="0,1,0,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding VerificationDialogMessage}"
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Foreground="#B8C0CC" />
                                        </Grid>
                                    </Border>

                                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                                        <Border Height="1" Background="#303640" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ManualSelectionTitleText}"
                                                   FontSize="11"
                                                   Foreground="#7F8794" />
                                        <Border Grid.Column="2" Height="1" Background="#303640" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,40,40"
                                          ColumnSpacing="8">
                                        <TextBox Text="{Binding ManualGamePath, Mode=TwoWay}"
                                                 Classes="ModOpsTextBox"
                                                 Watermark="{Binding ManualGamePathWatermarkText}"
                                                 FontSize="12" />
                                        <Button Grid.Column="1"
                                                Classes="ModOpsFlatButton"
                                                Width="40"
                                                Height="38"
                                                Padding="0"
                                                Command="{Binding BrowseGameDirectoryCommand}"
                                                ToolTip.Tip="{Binding GameDirectoryText}"
                                                AutomationProperties.Name="{Binding GameDirectoryText}">
                                            <PathIcon Data="{StaticResource BmxIconFolderOpen}" Width="16" Height="16" />
                                        </Button>
                                        <Button Grid.Column="2"
                                                Classes="ModOpsFlatButton"
                                                Width="40"
                                                Height="38"
                                                Padding="0"
                                                Command="{Binding BrowseGameExecutableCommand}"
                                                ToolTip.Tip="EXE"
                                                AutomationProperties.Name="EXE">
                                            <PathIcon Data="{StaticResource BmxIconFile}" Width="16" Height="16" />
                                        </Button>
                                    </Grid>

                                    <Button Classes="ModOpsFlatButton"
                                            Height="40"
                                            HorizontalAlignment="Right"
                                            Command="{Binding VerifyManualGamePathCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="{StaticResource BmxIconVerified}" Width="15" Height="15" />
                                            <TextBlock Text="{Binding AddPathText}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </controls:StripedCardBorder>
            </Grid>
        </Grid>

                    </Grid>
                </DataTemplate>
            </controls:DisposableWorkspaceHost.LazyContentTemplate>
        </controls:DisposableWorkspaceHost>

        <Grid x:Name="LabSurface"
              Margin="184,56,0,0"
              ClipToBounds="True"
              Background="Transparent"
              IsVisible="{Binding IsLabView}"
              ZIndex="10">
            <!-- Alchemy is a game surface, not a dashboard section. It receives the full Lab viewport. -->
            <Grid IsVisible="{Binding IsLabAlchemyActive}">
                <ContentControl x:Name="AlchemyModuleHost" />
            </Grid>

            <Grid IsVisible="{Binding IsLabForgingActive}">
                <ContentControl x:Name="ForgeModuleHost" />
            </Grid>

        </Grid>

        <controls:DisposableWorkspaceHost x:Name="DialogWorkspaceHost"
                                          Kind="Home"
                                          ZIndex="110"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch">
            <controls:DisposableWorkspaceHost.LazyContentTemplate>
                <DataTemplate x:DataType="vm:MainWindowViewModel">
                    <Grid>
        <Grid IsVisible="{Binding IsNexusModFilePickerVisible}"
              ZIndex="109">
            <Border Background="#C9080B10" />

            <controls:StripedCardBorder Classes="NexusModFilePickerSurface"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="720"
                                        MaxHeight="690"
                                        Margin="24"
                                        BoxShadow="0 22 62 0 #90000000"
                                        IsStripeMotionEnabled="{Binding !ReduceMotion}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                      RowSpacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding NexusModFilePickerTitleText}"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="#F8FAFC" />
                            <TextBlock Text="{Binding NexusModFilePickerMod.Name}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#93C5FD"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding NexusModFilePickerDescriptionText}"
                                       FontSize="11.5"
                                       Foreground="#A6ADBB"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="ModOpsFlatButton NexusModFilePickerCloseButton"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Command="{Binding CloseNexusModFilePickerCommand}"
                                ToolTip.Tip="{Binding NexusModFilePickerCancelText}">
                            <Grid Width="14" Height="14" RenderTransformOrigin="50%,50%">
                                <Border Width="16"
                                        Height="1.6"
                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RenderTransformOrigin="50%,50%">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="45" />
                                    </Border.RenderTransform>
                                </Border>
                                <Border Width="16"
                                        Height="1.6"
                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RenderTransformOrigin="50%,50%">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="-45" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#12243A"
                            BorderBrush="#294766"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,7"
                            IsVisible="{Binding IsLoadingNexusModFileOptions}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressBar Width="72" Height="3" IsIndeterminate="True" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NexusModFilePickerLoadingText}"
                                       FontSize="11"
                                       Foreground="#BFDBFE"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Spacing="8">
                        <Border IsVisible="{Binding HasNexusModRequirements}"
                                Background="#2B2617"
                                BorderBrush="#7A5A26"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8">
                            <StackPanel Spacing="7">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="{StaticResource BmxIconPackage}" Width="13" Height="13" Foreground="#FCD34D" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding NexusModRequirementsTitleText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#FDE68A" />
                                </StackPanel>
                                <TextBlock Text="{Binding NexusModRequirementsSummaryText}"
                                           FontSize="10.5"
                                           Foreground="#FDE68A"
                                           TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding NexusModRequirementOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NexusModRequirementViewModel">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,1">
                                                <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding SourceText}" FontSize="10" Foreground="#FCD34D" />
                                                <Button Grid.Column="2"
                                                        IsVisible="{Binding HasDetailsUrl}"
                                                        Classes="ModOpsFlatButton"
                                                        Width="24"
                                                        Height="24"
                                                        Padding="0"
                                                        Command="{Binding #Root.DataContext.OpenNexusModRequirementDetailsCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="{Binding #Root.DataContext.NexusModRequirementDetailsText}">
                                                    <PathIcon Data="{StaticResource BmxIconExternal}" Width="12" Height="12" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <CheckBox IsChecked="{Binding AutoDownloadNexusModRequirements, Mode=TwoWay}"
                                          Content="{Binding NexusModRequirementsAutoDownloadText}"
                                          FontSize="10.5"
                                          Foreground="#F8FAFC" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding NexusModFilePickerPresetsText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#DCE5F0" />
                        <ItemsControl ItemsSource="{Binding NexusModDownloadPresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NexusModDownloadPresetViewModel">
                                    <Button Classes="NexusDownloadPreset"
                                            Classes.selected="{Binding IsSelected}"
                                            Margin="0,0,8,0"
                                            Command="{Binding #Root.DataContext.ApplyNexusModDownloadPresetCommand}"
                                            CommandParameter="{Binding}">
                                            <Grid RowDefinitions="Auto,*" RowSpacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <PathIcon Data="{StaticResource BmxIconPackage}" Width="13" Height="13" Foreground="#93C5FD" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding FileCountText}" FontSize="9.5" Foreground="#93C5FD" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="10" Foreground="#AAB6C6" TextWrapping="Wrap" MaxLines="3" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Button Grid.Row="3"
                            Classes="ModOpsFlatButton"
                            Classes.active="{Binding IsNexusModFileAdvancedSelectionVisible}"
                            Height="30"
                            HorizontalAlignment="Left"
                            Padding="11,0"
                            Command="{Binding ToggleNexusModFileAdvancedSelectionCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Data="{StaticResource BmxIconSettings}" Width="12" Height="12" />
                            <TextBlock Text="{Binding NexusModFilePickerAdvancedText}" FontSize="11" />
                        </StackPanel>
                    </Button>

                    <Grid Grid.Row="4" MinHeight="0" IsVisible="{Binding IsNexusModFileAdvancedSelectionVisible}">
                        <ListBox Classes="ModFilePickerList"
                                 ItemsSource="{Binding NexusModFileOptions}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:NexusModFileOptionViewModel">
                                    <Grid Margin="12,10" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                        <Border Width="28" Height="28" CornerRadius="5" Background="#12243A" BorderBrush="#315070" BorderThickness="1" VerticalAlignment="Top">
                                            <PathIcon Data="{StaticResource BmxIconPackage}" Width="14" Height="14" Foreground="#93C5FD" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" IsVisible="{Binding IsPrimary}" Background="#1D3A28" BorderBrush="#3C6B4B" BorderThickness="1" CornerRadius="5" Padding="7,2">
                                                    <TextBlock Text="{Binding #Root.DataContext.NexusModFilePickerPrimaryText}" FontSize="10" FontWeight="SemiBold" Foreground="#86EFAC" />
                                                </Border>
                                                <Border Grid.Column="2" IsVisible="{Binding IsLegacyVersion}" Background="#3A2515" BorderBrush="#8B5A2B" BorderThickness="1" CornerRadius="5" Padding="7,2">
                                                    <TextBlock Text="{Binding LegacyVersionText}" FontSize="10" FontWeight="SemiBold" Foreground="#FCD34D" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding FileName}" FontSize="10.5" Foreground="#A6ADBB" TextTrimming="CharacterEllipsis" />
                                            <Border IsVisible="{Binding IsLegacyVersion}" Background="#2E2117" BorderBrush="#704B27" BorderThickness="1" CornerRadius="5" Padding="7,5">
                                                <TextBlock Text="{Binding CompatibilityWarning}" FontSize="10" Foreground="#FCD34D" TextWrapping="Wrap" />
                                            </Border>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="10.5"
                                                       Foreground="#C6D0DD"
                                                       TextWrapping="Wrap"
                                                       MaxLines="3" />
                                            <StackPanel Orientation="Horizontal" Spacing="9">
                                                <TextBlock Text="{Binding VersionText}" FontSize="10" Foreground="#CBD5E1" />
                                                <TextBlock Text="{Binding CategoryText}" FontSize="10" Foreground="#CBD5E1" />
                                                <TextBlock Text="{Binding SizeText}" FontSize="10" Foreground="#CBD5E1" />
                                                <TextBlock Text="{Binding UploadedText}" FontSize="10" Foreground="#94A3B8" />
                                            </StackPanel>
                                        </StackPanel>
                                        <PathIcon Grid.Column="3" Data="{StaticResource BmxIconChevronRight}" Width="14" Height="14" Foreground="#93C5FD" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Background="#BE12151B"
                                CornerRadius="7"
                                IsVisible="{Binding IsLoadingNexusModFileOptions}">
                            <ProgressBar Width="126" Height="4" IsIndeterminate="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NexusModFilePickerSelectionText}" FontSize="11" FontWeight="SemiBold" Foreground="#BFDBFE" />
                            <TextBlock Text="{Binding NexusModFilePickerStatusText}" FontSize="10.5" Foreground="#FBBF24" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="ModOpsFlatButton"
                                Height="34"
                                Padding="14,0"
                                Command="{Binding CloseNexusModFilePickerCommand}"
                                Content="{Binding NexusModFilePickerCancelText}" />
                        <Button Grid.Column="2"
                                Classes="ModOpsPrimaryButton"
                                Height="34"
                                Padding="14,0"
                                Command="{Binding ConfirmNexusModFileDownloadCommand}"
                                Content="{Binding NexusModFilePickerConfirmText}" />
                    </Grid>
                </Grid>
            </controls:StripedCardBorder>
        </Grid>

        <Grid IsVisible="{Binding IsModPackPreflightOpen}"
              ZIndex="113">
            <Border Background="#DD050A14" />

            <controls:SmoothCornerBorder HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Width="760"
                                         MaxWidth="760"
                                         MaxHeight="720"
                                         CornerRadius="8"
                                         Background="#FA171B22"
                                         BorderBrush="#3B424D"
                                         BorderThickness="1"
                                         InsetStroke="True">
                <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding ModPackPreflightTitleText}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#F8FAFC"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ModPackPreflightSummaryText}"
                                       FontSize="11"
                                       Foreground="#A6ADBB"
                                       TextWrapping="Wrap"
                                       MaxLines="3" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="ModOpsFlatButton"
                                Width="34"
                                Height="30"
                                Command="{Binding CloseModPackPreflightCommand}"
                                Content="×"
                                ToolTip.Tip="关闭" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding ModPackPreflightCountsText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#BFDBFE" />
                            <TextBlock Text="{Binding ModPackPreflightCompatibilityText}" FontSize="10.5" Foreground="#CBD5E1" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ModPackPreflightSizeText}" FontSize="11" Foreground="#86EFAC" VerticalAlignment="Top" />
                    </Grid>

                    <Border Grid.Row="2"
                            IsVisible="{Binding ModPackPreflightContainsAdultContent}"
                            Background="#321F1418"
                            BorderBrush="#7F3D4A"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8">
                        <CheckBox IsChecked="{Binding IsModPackAdultContentConfirmed, Mode=TwoWay}"
                                  IsEnabled="{Binding !IsModPackPreflightBusy}"
                                  Content="此整合包含成人内容。我已确认当前 Nexus 账号有权访问，并同意继续安装。"
                                  FontSize="10.5"
                                  Foreground="#FCA5A5" />
                    </Border>

                    <Grid Grid.Row="3" MinHeight="240">
                        <ListBox ItemsSource="{Binding ModPackInstallOptions}"
                                 Background="#0F1218"
                                 BorderBrush="#303640"
                                 BorderThickness="1"
                                 CornerRadius="6"
                                 IsEnabled="{Binding !IsModPackPreflightBusy}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModPackInstallOptionViewModel">
                                    <Grid Margin="10,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  VerticalAlignment="Top"
                                                  Margin="0,3,0,0" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding RequirementText}" FontSize="9.5" Foreground="#93C5FD" />
                                                <TextBlock Text="{Binding SourceText}" FontSize="9.5" Foreground="#C4B5FD" />
                                                <TextBlock Text="{Binding PhaseText}" FontSize="9.5" Foreground="#94A3B8" />
                                                <TextBlock Text="{Binding SizeText}" FontSize="9.5" Foreground="#94A3B8" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding SupportText}"
                                                       IsVisible="{Binding !IsSupported}"
                                                       FontSize="10"
                                                       Foreground="#FBBF24"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                IsVisible="{Binding IsSupported}"
                                                Background="#1D3A28"
                                                BorderBrush="#3C6B4B"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="7,2"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="软件内安装" FontSize="9.5" Foreground="#86EFAC" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <StackPanel Grid.Row="4" Spacing="9">
                        <TextBlock Text="{Binding ModPackPreflightStatusText}" FontSize="10.5" Foreground="#FBBF24" TextWrapping="Wrap" />
                        <StackPanel IsVisible="{Binding IsModPackPreflightBusy}" Spacing="4">
                            <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding ModPackInstallProgressPercent}" />
                            <TextBlock Text="{Binding ModPackInstallProgressText}" FontSize="10" Foreground="#CBD5E1" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                            <Button Grid.Column="1"
                                    Classes="ModOpsFlatButton"
                                    Height="34"
                                    Padding="12,0"
                                    Command="{Binding ViewModPackManualItemsCommand}"
                                    Content="查看手动项目" />
                            <Button Grid.Column="2"
                                    Classes="ModOpsFlatButton"
                                    Height="34"
                                    Padding="12,0"
                                    IsVisible="{Binding IsModPackPreflightBusy}"
                                    Command="{Binding PauseModPackInstallCommand}"
                                    Content="暂停整合包" />
                            <Button Grid.Column="3"
                                    Classes="ModOpsPrimaryButton"
                                    Height="34"
                                    Padding="14,0"
                                    IsEnabled="{Binding CanConfirmModPackInstall}"
                                    Command="{Binding ConfirmModPackInstallCommand}"
                                    Content="在软件内安装" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </controls:SmoothCornerBorder>
        </Grid>

        <Grid IsVisible="{Binding IsLocalModPackImportOpen}"
              ZIndex="114">
            <Border Background="#DD050A14" />

            <controls:SmoothCornerBorder HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Width="760"
                                         MaxWidth="760"
                                         MaxHeight="720"
                                         Background="#FA1D2027"
                                         BorderBrush="#3B424D"
                                         BorderThickness="1"
                                         InsetStroke="True">
                <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding LocalModPackImportTitleText}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#F8FAFC"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LocalModPackImportSummaryText}"
                                       FontSize="11"
                                       Foreground="#A6ADBB"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="ModOpsFlatButton"
                                Width="34"
                                Height="30"
                                Content="×"
                                Command="{Binding CloseLocalModPackImportCommand}"
                                ToolTip.Tip="{Binding LocalModPackCancelText}" />
                    </Grid>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="10"
                          IsVisible="{Binding IsLocalModPackImportPasswordRequired}">
                        <TextBox Text="{Binding LocalModPackImportPassword, Mode=TwoWay}"
                                 PasswordChar="*"
                                 Watermark="{Binding LocalModPackPasswordText}"
                                 VerticalContentAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="ModOpsFlatButton"
                                Content="{Binding LocalModPackRetryText}"
                                Command="{Binding RetryLocalModPackImportCommand}" />
                    </Grid>

                    <StackPanel Grid.Row="2" Spacing="6">
                        <TextBlock Text="{Binding LocalModPackImportStatusText}"
                                   FontSize="11"
                                   Foreground="#FBBF24"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LocalModPackImportWarningsText}"
                                   FontSize="10.5"
                                   Foreground="#CBD5E1"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding LocalModPackImportItems}"
                             Background="#0F1218"
                             BorderBrush="#303640"
                             BorderThickness="1"
                             CornerRadius="6"
                             MinHeight="250">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LocalModPackImportItemViewModel">
                                <Grid Margin="10,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding CanSelect}"
                                              VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Spacing="2" MinWidth="0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F8FAFC"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StateText}"
                                                       FontSize="10"
                                                       Foreground="#93C5FD" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding DetailText}"
                                                   FontSize="10"
                                                   Foreground="#A6ADBB"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="10"
                                                   Foreground="#FCA5A5"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding IsInvalid}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2"
                                              Content="{Binding #Root.DataContext.LocalModPackReplaceText}"
                                              IsVisible="{Binding IsExisting}"
                                              IsChecked="{Binding IsReplace, Mode=TwoWay}"
                                              FontSize="10"
                                              Foreground="#FBBF24" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="4" Spacing="8">
                        <CheckBox IsChecked="{Binding UseLocalModPackAuthorLoadOrder, Mode=TwoWay}"
                                  Content="{Binding LocalModPackUseAuthorOrderText}"
                                  FontSize="10.5"
                                  Foreground="#CBD5E1" />
                        <StackPanel IsVisible="{Binding IsLocalModPackImportBusy}" Spacing="4">
                            <ProgressBar Height="4"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding LocalModPackImportProgressPercent}" />
                            <TextBlock Text="{Binding LocalModPackImportProgressText}"
                                       FontSize="10"
                                       Foreground="#CBD5E1"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Button Grid.Column="1"
                                    Classes="ModOpsFlatButton"
                                    Height="34"
                                    Padding="12,0"
                                    Content="{Binding LocalModPackCancelText}"
                                    Command="{Binding CloseLocalModPackImportCommand}" />
                            <Button Grid.Column="2"
                                    Classes="ModOpsPrimaryButton"
                                    Height="34"
                                    Padding="14,0"
                                    Content="{Binding LocalModPackConfirmText}"
                                    IsEnabled="{Binding CanConfirmLocalModPackImport}"
                                    Command="{Binding ConfirmLocalModPackImportCommand}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </controls:SmoothCornerBorder>
        </Grid>

        <Grid IsVisible="{Binding IsNexusAccountBindingDialogOpen}"
              ZIndex="112">
            <Border Background="#D9050A14" />

            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="620"
                  MaxWidth="620"
                  IsHitTestVisible="True">
                <controls:SmoothCornerBorder CornerRadius="8"
                                             Background="#FA1D2027"
                                             BorderBrush="#3B424D"
                                             BorderThickness="1"
                                             InsetStroke="True">
                    <StackPanel Spacing="0">
                        <Grid Margin="24,22,24,18"
                              ColumnDefinitions="44,*"
                              ColumnSpacing="14">
                            <Border Width="42"
                                    Height="42"
                                    CornerRadius="14"
                                    Background="#321F1712"
                                    BorderBrush="#6B9C4A2E"
                                    BorderThickness="1">
                                <Path Data="{StaticResource BmxIconExternal}"
                                      Width="20"
                                      Height="20"
                                      Stroke="#F59E0B"
                                      StrokeThickness="1.8"
                                      StrokeLineCap="Round"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Spacing="4"
                                        VerticalAlignment="Center">
                                <TextBlock Text="需要登录并绑定 Nexus Mods"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="#F8FAFC" />
                                <TextBlock Text="当前账号尚未绑定。继续下载前，请先完成 Nexus Mods 登录与绑定。"
                                           FontSize="11.5"
                                           Foreground="#9CA3AF"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#303640" />

                        <StackPanel Margin="24,0" Spacing="0">
                            <Grid MinHeight="58"
                                  ColumnDefinitions="128,*"
                                  ColumnSpacing="16">
                                <TextBlock Text="当前玩家"
                                           FontSize="11"
                                           Foreground="#9CA3AF"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding PlayerProfiles.CurrentPlayer.DisplayName}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#E8CB76"
                                           TextWrapping="Wrap"
                                           TextAlignment="Right"
                                           MaxLines="2" />
                            </Grid>

                            <Border Height="1" Background="#303640" />

                            <Grid MinHeight="76"
                                  ColumnDefinitions="128,*"
                                  ColumnSpacing="16">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <Path Data="{StaticResource BmxIconExternal}"
                                          Width="15"
                                          Height="15"
                                          Stroke="#F59E0B"
                                          StrokeThickness="1.8"
                                          StrokeLineCap="Round"
                                          Stretch="Uniform" />
                                    <TextBlock Text="Nexus Mods"
                                               FontSize="11"
                                               Foreground="#9CA3AF"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="登录后可搜索和下载 Nexus 来源的 Mod"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#F8FAFC"
                                           TextAlignment="Right"
                                           TextWrapping="Wrap"
                                           MaxWidth="390" />
                            </Grid>

                            <Border Height="1" Background="#303640" />

                            <StackPanel Margin="0,14,0,14" Spacing="7">
                                <TextBlock Text="个人下载密钥（备用）"
                                           FontSize="11"
                                           Foreground="#9CA3AF" />
                                <TextBlock Text="如果无法通过浏览器登录，可在 Nexus API Access 页面创建个人密钥，再粘贴到这里。"
                                           FontSize="10.5"
                                           Foreground="#8E9AAE"
                                           TextWrapping="Wrap" />
                                <TextBox Text="{Binding NexusAccountBindingDialogApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="粘贴个人密钥"
                                         PasswordChar="*"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Padding="11,8"
                                         Foreground="#E5E7EB"
                                         Background="#0F1116"
                                         BorderBrush="#303640"
                                         CornerRadius="9" />
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="#303640" />

                        <StackPanel Margin="24,15,24,16" Spacing="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Ellipse Width="6"
                                         Height="6"
                                         Fill="#F59E0B"
                                         Margin="0,5,0,0"
                                         VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding NexusAccountBindingDialogStatusText}"
                                           FontSize="11.5"
                                           Foreground="#C7CED8"
                                           TextWrapping="Wrap" />
                            </Grid>
                            <ProgressBar Height="3"
                                         IsIndeterminate="True"
                                         IsVisible="{Binding IsNexusAccountBindingDialogBusy}" />
                        </StackPanel>

                        <Border Height="1" Background="#303640" />

                        <Grid Margin="24,17,24,20"
                              ColumnDefinitions="*,Auto,Auto,Auto"
                              ColumnSpacing="9">
                            <Button Grid.Column="1"
                                    Classes="GlyphGlassButton"
                                    Height="38"
                                    Padding="18,0"
                                    Command="{Binding CancelNexusAccountBindingCommand}"
                                    Content="取消" />
                            <Button Grid.Column="2"
                                    Classes="GlyphGlassButton"
                                    Height="38"
                                    Padding="18,0"
                                    IsEnabled="{Binding CanBindNexusAccountWithApiKey}"
                                    Command="{Binding BindNexusAccountWithApiKeyCommand}"
                                    Content="使用个人密钥" />
                            <Button Grid.Column="3"
                                    Classes="GlyphPrimaryButton"
                                    Height="38"
                                    Padding="18,0"
                                    IsEnabled="{Binding CanConfirmNexusAccountBinding}"
                                    Command="{Binding ConfirmNexusAccountBindingCommand}"
                                    Content="登录并绑定" />
                        </Grid>
                    </StackPanel>
                </controls:SmoothCornerBorder>
            </Grid>
        </Grid>

        <Grid IsVisible="{Binding IsSteamAccountBindingDialogOpen}"
              ZIndex="112">
            <Border Background="#D9050A14" />

            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="620"
                  MaxWidth="620"
                  IsHitTestVisible="True">
                <controls:SmoothCornerBorder CornerRadius="8"
                                             Background="#FA1D2027"
                                             BorderBrush="#3B424D"
                                             BorderThickness="1"
                                             InsetStroke="True">
                    <StackPanel Spacing="0">
                        <Grid Margin="24,22,24,18"
                              ColumnDefinitions="44,*"
                              ColumnSpacing="14">
                            <Border Width="42"
                                    Height="42"
                                    CornerRadius="14"
                                    Background="#17191F"
                                    BorderBrush="#3B424D"
                                    BorderThickness="1">
                                <Path Data="{StaticResource IconSteam}"
                                      Width="20"
                                      Height="20"
                                      Fill="#66C0F4"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Spacing="4"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding SteamAccountBindingDialogTitleText}"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="#F8FAFC"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SteamAccountBindingDialogDescriptionText}"
                                           FontSize="11.5"
                                           Foreground="#9CA3AF"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#303640" />

                        <StackPanel Margin="24,0" Spacing="0">
                            <Grid MinHeight="58"
                                  ColumnDefinitions="128,*"
                                  ColumnSpacing="16">
                                <TextBlock Text="{Binding SteamAccountBindingOfflineAccountLabelText}"
                                           FontSize="11"
                                           Foreground="#9CA3AF"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SteamAccountBindingOfflineAccountNameText}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#E8CB76"
                                           TextWrapping="Wrap"
                                           TextAlignment="Right"
                                           MaxLines="2" />
                            </Grid>

                            <Border Height="1" Background="#303640" />

                            <Grid MinHeight="76"
                                  ColumnDefinitions="128,*"
                                  ColumnSpacing="16">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconSteam}"
                                          Width="15"
                                          Height="15"
                                          Fill="#66C0F4"
                                          Stretch="Uniform" />
                                    <TextBlock Text="{Binding SteamAccountBindingSteamAccountLabelText}"
                                               FontSize="11"
                                               Foreground="#9CA3AF"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Spacing="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SteamAccountBindingSteamAccountNameText}"
                                               MaxWidth="390"
                                               HorizontalAlignment="Right"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#F8FAFC"
                                               TextWrapping="Wrap"
                                               TextAlignment="Right"
                                               MaxLines="2" />
                                    <TextBlock Text="{Binding SteamAccountBindingSteamAccountIdText}"
                                               MaxWidth="390"
                                               HorizontalAlignment="Right"
                                               FontFamily="Consolas"
                                               FontSize="10"
                                               Foreground="#8E9AAE"
                                               TextWrapping="Wrap"
                                               TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="#303640" />

                        <StackPanel Margin="24,15,24,16" Spacing="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Ellipse Width="6"
                                         Height="6"
                                         Fill="#E8CB76"
                                         Margin="0,5,0,0"
                                         VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SteamAccountBindingStatusText}"
                                           FontSize="11.5"
                                           Foreground="#C7CED8"
                                           TextWrapping="Wrap" />
                            </Grid>
                            <ProgressBar Height="3"
                                         IsIndeterminate="True"
                                         IsVisible="{Binding IsSteamAccountBindingBusy}" />
                        </StackPanel>

                        <Border Height="1" Background="#303640" />

                        <Grid Margin="24,17,24,20"
                              ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="9">
                            <Button Grid.Column="1"
                                    Classes="GlyphGlassButton"
                                    Height="38"
                                    Padding="18,0"
                                    Command="{Binding CancelSteamAccountBindingCommand}"
                                    Content="{Binding SteamAccountBindingCancelText}" />
                            <Button Grid.Column="2"
                                    Classes="GlyphPrimaryButton"
                                    Height="38"
                                    Padding="18,0"
                                    IsEnabled="{Binding CanConfirmSteamAccountBinding}"
                                    Command="{Binding ConfirmSteamAccountBindingCommand}"
                                    Content="{Binding SteamAccountBindingConfirmText}" />
                        </Grid>
                    </StackPanel>
                </controls:SmoothCornerBorder>
            </Grid>
        </Grid>

                    </Grid>
                </DataTemplate>
            </controls:DisposableWorkspaceHost.LazyContentTemplate>
        </controls:DisposableWorkspaceHost>

        <controls:DisposableWorkspaceHost x:Name="PlayerProfileOverlayHost"
                                          Kind="Home"
                                          ZIndex="180"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch">
            <controls:DisposableWorkspaceHost.LazyContentTemplate>
                <DataTemplate x:DataType="playerProfiles:PlayerProfileManagerViewModel">
                    <playerProfiles:PlayerProfileHost />
                </DataTemplate>
            </controls:DisposableWorkspaceHost.LazyContentTemplate>
        </controls:DisposableWorkspaceHost>

        </Grid>
    </Grid>
        </controls:SmoothCornerBorder>
    </Grid>
    <Border x:Name="StartupImpactFlash"
            CornerRadius="18"
            Opacity="0"
            IsHitTestVisible="False">
        <Border.Background>
            <RadialGradientBrush Center="50%,48%" GradientOrigin="50%,48%" RadiusX="72%" RadiusY="72%">
                <GradientStop Color="#80D4AF37" Offset="0" />
                <GradientStop Color="#3DD4AF37" Offset="0.38" />
                <GradientStop Color="#00000000" Offset="1" />
            </RadialGradientBrush>
        </Border.Background>
    </Border>
    </Grid>
</Window>

