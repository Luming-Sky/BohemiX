<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BohemiX.App.Views.BackgroundCropWindow"
        Width="920"
        Height="700"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Title="Free crop">
    <Grid RowDefinitions="*,Auto" RowSpacing="14" Margin="18">
        <Border Background="#10141B"
                BorderBrush="#303A4A"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <Canvas x:Name="PreviewCanvas"
                    Background="#080B12"
                    ClipToBounds="True"
                    PointerPressed="PreviewCanvas_OnPointerPressed"
                    PointerMoved="PreviewCanvas_OnPointerMoved"
                    PointerReleased="PreviewCanvas_OnPointerReleased">
                <Image x:Name="PreviewImage"
                       IsHitTestVisible="False"
                       Stretch="Uniform" />
                <Border x:Name="SelectionOverlay"
                        Background="#450284C7"
                        BorderBrush="#A8D8FF"
                        BorderThickness="2"
                        IsHitTestVisible="False" />
                <Border x:Name="HandleTopLeft"
                        Width="12" Height="12"
                        Background="#EAF6FF"
                        BorderBrush="#1976B8"
                        BorderThickness="1"
                        CornerRadius="2"
                        IsHitTestVisible="False" />
                <Border x:Name="HandleTop"
                        Width="24" Height="8"
                        Background="#EAF6FF"
                        BorderBrush="#1976B8"
                        BorderThickness="1"
                        CornerRadius="2"
                        IsHitTestVisible="False" />
                <Border x:Name="HandleTopRight"
                        Width="12" Height="12"
                        Background="#EAF6FF"
                        BorderBrush="#1976B8"
                        BorderThickness="1"
                        CornerRadius="2"
                        IsHitTestVisible="False" />
                <Border x:Name="HandleRight"
                        Width="8" Height="24"
                        Background="#EAF6FF"
                        BorderBrush="#1976B8"
                        BorderThickness="1"
                        CornerRadius="2"
                        IsHitTestVisible="False" />
                <Border x:Name="HandleBottomRight"
                        Width="12" Height="12"
                        Background="#EAF6FF"
                        BorderBrush="#1976B8"
                        BorderThickness="1"
                        CornerRadius="2"
                        IsHitTestVisible="False" />
                <Border x:Name="HandleBottom"
                        Width="24" Height="8"
                        Background="#EAF6FF"
                        BorderBrush="#1976B8"
                        BorderThickness="1"
                        CornerRadius="2"
                        IsHitTestVisible="False" />
                <Border x:Name="HandleBottomLeft"
                        Width="12" Height="12"
                        Background="#EAF6FF"
                        BorderBrush="#1976B8"
                        BorderThickness="1"
                        CornerRadius="2"
                        IsHitTestVisible="False" />
                <Border x:Name="HandleLeft"
                        Width="8" Height="24"
                        Background="#EAF6FF"
                        BorderBrush="#1976B8"
                        BorderThickness="1"
                        CornerRadius="2"
                        IsHitTestVisible="False" />
            </Canvas>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
            <TextBlock Text="Drag on the image to choose any crop rectangle."
                       VerticalAlignment="Center"
                       Foreground="#AEB8C7"
                       FontSize="12" />
            <Button Grid.Column="1"
                    Classes="GlyphGlassButton"
                    Padding="16,0"
                    Height="36"
                    Click="NewSelectionButton_OnClick"
                    Content="New selection" />
            <Button Grid.Column="2"
                    Classes="GlyphGlassButton"
                    Padding="16,0"
                    Height="36"
                    Click="CancelButton_OnClick"
                    Content="Cancel" />
            <Button Grid.Column="3"
                    Classes="GlyphPrimaryButton"
                    Padding="16,0"
                    Height="36"
                    Click="ConfirmButton_OnClick"
                    Content="Apply crop" />
        </Grid>
    </Grid>
</Window>
