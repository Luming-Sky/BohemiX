<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="BohemiX.App.App"
             xmlns:local="using:BohemiX.App"
             xmlns:controls="using:BohemiX.App.Controls"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <Color x:Key="NebulaBackgroundColor">#0B0D12</Color>
        <Color x:Key="NebulaSurfaceColor">#08FFFFFF</Color>
        <Color x:Key="NebulaSurfaceStrongColor">#12FFFFFF</Color>
        <Color x:Key="NebulaBorderColor">#14FFFFFF</Color>
        <Color x:Key="NebulaTextColor">#F4F8FF</Color>
        <Color x:Key="NebulaMutedTextColor">#8E9AAE</Color>
        <Color x:Key="NebulaAccentColor">#00E5FF</Color>
        <Color x:Key="NebulaAccentSoftColor">#3300E5FF</Color>
        <Color x:Key="GlyphPrimaryColor">#2563EB</Color>
        <Color x:Key="GlyphPrimaryHoverColor">#1D4ED8</Color>
        <Color x:Key="GlyphSkyColor">#60A5FA</Color>
        <Color x:Key="GlyphInkColor">#111827</Color>
        <Color x:Key="GlyphMutedColor">#667085</Color>
        <Color x:Key="GlyphCardColor">#EEF8FAFC</Color>
        <Color x:Key="GlyphCardBorderColor">#33FFFFFF</Color>

        <SolidColorBrush x:Key="NebulaBackgroundBrush" Color="{StaticResource NebulaBackgroundColor}" />
        <SolidColorBrush x:Key="NebulaSurfaceBrush" Color="{StaticResource NebulaSurfaceColor}" />
        <SolidColorBrush x:Key="NebulaSurfaceStrongBrush" Color="{StaticResource NebulaSurfaceStrongColor}" />
        <SolidColorBrush x:Key="NebulaBorderBrush" Color="{StaticResource NebulaBorderColor}" />
        <SolidColorBrush x:Key="NebulaTextBrush" Color="{StaticResource NebulaTextColor}" />
        <SolidColorBrush x:Key="NebulaMutedTextBrush" Color="{StaticResource NebulaMutedTextColor}" />
        <SolidColorBrush x:Key="NebulaAccentBrush" Color="{StaticResource NebulaAccentColor}" />
        <SolidColorBrush x:Key="NebulaAccentSoftBrush" Color="{StaticResource NebulaAccentSoftColor}" />
        <SolidColorBrush x:Key="GlyphPrimaryBrush" Color="{StaticResource GlyphPrimaryColor}" />
        <SolidColorBrush x:Key="GlyphSkyBrush" Color="{StaticResource GlyphSkyColor}" />
        <SolidColorBrush x:Key="GlyphInkBrush" Color="{StaticResource GlyphInkColor}" />
        <SolidColorBrush x:Key="GlyphMutedBrush" Color="{StaticResource GlyphMutedColor}" />
        <SolidColorBrush x:Key="GlyphCardBrush" Color="{StaticResource GlyphCardColor}" />
        <SolidColorBrush x:Key="GlyphCardBorderBrush" Color="{StaticResource GlyphCardBorderColor}" />

        <ExperimentalAcrylicMaterial x:Key="TopNavAcrylic"
                                     BackgroundSource="Digger"
                                     TintColor="#111721"
                                     TintOpacity="0.82"
                                     MaterialOpacity="0.62"
                                     FallbackColor="#D9111721" />
        <ExperimentalAcrylicMaterial x:Key="SidebarAcrylic"
                                     BackgroundSource="Digger"
                                     TintColor="#0B0D12"
                                     TintOpacity="0.64"
                                     MaterialOpacity="0.45"
                                     FallbackColor="#E00B0D12" />
        <ExperimentalAcrylicMaterial x:Key="SaveCardAcrylic"
                                     BackgroundSource="Digger"
                                     TintColor="#0B1118"
                                     TintOpacity="0.28"
                                     MaterialOpacity="0.34"
                                     FallbackColor="#780B1118" />
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <StyleInclude Source="avares://BohemiX.App/Assets/Icons/BohemiXIcons.axaml" />
        <semi:SemiTheme Locale="zh-CN" />

        <Style Selector="controls|StripedCardBorder">
            <Setter Property="StripeAnchorMode" Value="Viewport" />
        </Style>

        <Style Selector="Button.NebulaIconButton">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#0AFFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource NebulaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource NebulaTextBrush}" />
        </Style>

        <Style Selector="Button.NebulaIconButton:pointerover">
            <Setter Property="Background" Value="#1A00E5FF" />
            <Setter Property="BorderBrush" Value="{StaticResource NebulaAccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource NebulaAccentBrush}" />
        </Style>

        <Style Selector="Button.PrimaryCommand">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{StaticResource NebulaAccentBrush}" />
            <Setter Property="Foreground" Value="#061014" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.GhostCommand">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#0AFFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource NebulaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource NebulaTextBrush}" />
        </Style>

        <Style Selector="Border.NebulaHairline">
            <Setter Property="BorderBrush" Value="{StaticResource NebulaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource NebulaSurfaceBrush}" />
        </Style>

        <Style Selector="Border.BentoCard">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{StaticResource NebulaSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NebulaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 18 40 0 #33000000" />
        </Style>

        <Style Selector="Border.BentoCard:pointerover">
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource NebulaAccentBrush}" />
            <Setter Property="BoxShadow" Value="0 22 56 0 #5500E5FF" />
        </Style>

        <Style Selector="ListBox.SidebarList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ListBox.SidebarList > ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ListBox.SidebarList > ListBoxItem:selected">
            <Setter Property="Background" Value="#1800E5FF" />
        </Style>

        <Style Selector="Border.GlyphGlassCard">
            <Setter Property="Background" Value="{StaticResource GlyphCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlyphCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="BoxShadow" Value="0 10 28 0 #24050A14" />
        </Style>

        <Style Selector="controls|SmoothCornerBorder.LauncherDashboardPanel">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#DEFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="controls|SmoothCornerBorder.LauncherStatusStrip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#DEFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="Button.LauncherStatusItem">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="#68FFFFFF" />
            <Setter Property="BorderBrush" Value="#96FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.LauncherStatusItem:pointerover">
            <Setter Property="Background" Value="#C8FFFFFF" />
            <Setter Property="BorderBrush" Value="#FFFFFFFF" />
        </Style>

        <Style Selector="Button.LauncherDashboardCommand">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Background" Value="#E92F7FC1" />
            <Setter Property="BorderBrush" Value="#FF77B4E3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.LauncherDashboardCommand:pointerover">
            <Setter Property="Background" Value="#FF246EAA" />
        </Style>

        <Style Selector="Border.LauncherModRow">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.LauncherModRow:pointerover">
            <Setter Property="Background" Value="#62FFFFFF" />
        </Style>

        <Style Selector="CheckBox.LauncherModCheck">
            <Setter Property="Foreground" Value="#18212F" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.LauncherNewsLead">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#62FFFFFF" />
            <Setter Property="BorderBrush" Value="#94FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.LauncherNewsLead:pointerover">
            <Setter Property="Background" Value="#86FFFFFF" />
            <Setter Property="BorderBrush" Value="#C8FFFFFF" />
        </Style>

        <Style Selector="Button.LauncherDailyMod">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#58FFFFFF" />
            <Setter Property="BorderBrush" Value="#A8FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.LauncherDailyMod:pointerover">
            <Setter Property="Background" Value="#84FFFFFF" />
            <Setter Property="BorderBrush" Value="#E8FFFFFF" />
        </Style>

        <Style Selector="Button.LauncherNewsRow">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#32FFFFFF" />
            <Setter Property="BorderBrush" Value="#58FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.LauncherNewsRow:pointerover">
            <Setter Property="Background" Value="#66FFFFFF" />
        </Style>

        <Style Selector="controls|StripedCardBorder.GlyphGlassCard">
            <Setter Property="Background" Value="{StaticResource GlyphCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlyphCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="BoxShadow" Value="0 10 28 0 #24050A14" />
            <Setter Property="StripeOpacity" Value="0.32" />
            <Setter Property="StripeSpeed" Value="14" />
        </Style>

        <Style Selector="controls|StripedCardBorder.GlyphMiniCard">
            <Setter Property="Background" Value="#F4F6F8" />
            <Setter Property="BorderBrush" Value="#0D0F172A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="StripeOpacity" Value="0.16" />
            <Setter Property="StripeSpeed" Value="14" />
        </Style>

        <Style Selector="controls|StripedCardBorder.GlyphPreviewCard">
            <Setter Property="Background" Value="#F4F6F8" />
            <Setter Property="BorderBrush" Value="#0D0F172A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="StripeOpacity" Value="0.14" />
            <Setter Property="StripeSpeed" Value="14" />
        </Style>

        <Style Selector="Border.SaveWorkspacePanel">
            <Setter Property="Background" Value="#101114" />
            <Setter Property="BorderBrush" Value="#2B2D33" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style Selector="Border.SaveHeaderStrip">
            <Setter Property="Background" Value="#181A1F" />
            <Setter Property="BorderBrush" Value="#30333A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style Selector="Border.SaveSurface">
            <Setter Property="Background" Value="#17191F" />
            <Setter Property="BorderBrush" Value="#2E323A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style Selector="Border.SaveDetailHero">
            <Setter Property="Background" Value="#17191F" />
            <Setter Property="BorderBrush" Value="#2E323A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style Selector="Border.SaveDetailFact">
            <Setter Property="Background" Value="#15171D" />
            <Setter Property="BorderBrush" Value="#2A2E36" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="MinHeight" Value="62" />
        </Style>

        <Style Selector="Border.SaveDetailPill">
            <Setter Property="Background" Value="#22262E" />
            <Setter Property="BorderBrush" Value="#3A404B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style Selector="Border.SaveMetricTile">
            <Setter Property="Background" Value="#151820" />
            <Setter Property="BorderBrush" Value="#2A2F38" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style Selector="Border.SaveListHeader">
            <Setter Property="Background" Value="#20242B" />
            <Setter Property="BorderBrush" Value="#333943" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style Selector="Border.SaveListRow">
            <Setter Property="Background" Value="#1D2027" />
            <Setter Property="BorderBrush" Value="#303640" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.SaveListRow:pointerover">
            <Setter Property="Background" Value="#242831" />
            <Setter Property="BorderBrush" Value="#4B5563" />
        </Style>

        <Style Selector="Border.SaveListRow.selected">
            <Setter Property="Background" Value="#333840" />
            <Setter Property="BorderBrush" Value="#F59E0B" />
        </Style>

        <Style Selector="Border.SaveSlotIcon">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#242932" />
            <Setter Property="BorderBrush" Value="#3A404B" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.SaveMountedPill">
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#2B2112" />
            <Setter Property="BorderBrush" Value="#8A5A12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <Style Selector="Border.SaveNotice">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#14171D" />
            <Setter Property="BorderBrush" Value="#2C3038" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style Selector="controls|StripedCardBorder.SaveWorkspacePanel">
            <Setter Property="Background" Value="#101114" />
            <Setter Property="BorderBrush" Value="#2B2D33" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="StripeAnchorMode" Value="Viewport" />
            <Setter Property="StripeOpacity" Value="0.1" />
            <Setter Property="StripeSpeed" Value="14" />
            <Setter Property="StripeAssetUri" Value="avares://BohemiX.App/Assets/striped-background-page.png" />
        </Style>

        <Style Selector="controls|StripedCardBorder.SaveHeaderStrip">
            <Setter Property="Background" Value="#181A1F" />
            <Setter Property="BorderBrush" Value="#30333A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="StripeOpacity" Value="0.12" />
            <Setter Property="StripeSpeed" Value="14" />
            <Setter Property="StripeAssetUri" Value="avares://BohemiX.App/Assets/striped-draft-card-surface.png" />
        </Style>

        <Style Selector="controls|StripedCardBorder.SaveSurface">
            <Setter Property="Background" Value="#17191F" />
            <Setter Property="BorderBrush" Value="#2E323A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="StripeOpacity" Value="0.12" />
            <Setter Property="StripeSpeed" Value="14" />
            <Setter Property="StripeAssetUri" Value="avares://BohemiX.App/Assets/striped-draft-card-surface.png" />
        </Style>

        <Style Selector="controls|StripedCardBorder.SaveDetailSurface">
            <Setter Property="Background" Value="#171A20" />
            <Setter Property="BorderBrush" Value="#8A5A12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="StripeOpacity" Value="0.14" />
            <Setter Property="StripeSpeed" Value="14" />
            <Setter Property="StripeAssetUri" Value="avares://BohemiX.App/Assets/striped-draft-card-surface.png" />
        </Style>

        <Style Selector="controls|StripedCardBorder.SaveMetricTile">
            <Setter Property="Background" Value="#151820" />
            <Setter Property="BorderBrush" Value="#2A2F38" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="StripeOpacity" Value="0.14" />
            <Setter Property="StripeSpeed" Value="14" />
            <Setter Property="StripeAssetUri" Value="avares://BohemiX.App/Assets/striped-draft-card-surface.png" />
        </Style>

        <Style Selector="controls|StripedCardBorder.SaveListHeader">
            <Setter Property="Background" Value="#20242B" />
            <Setter Property="BorderBrush" Value="#333943" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="StripeOpacity" Value="0.1" />
            <Setter Property="StripeSpeed" Value="14" />
            <Setter Property="StripeAssetUri" Value="avares://BohemiX.App/Assets/striped-draft-card-surface.png" />
        </Style>

        <Style Selector="controls|StripedCardBorder.SaveListRow">
            <Setter Property="Background" Value="#1D2027" />
            <Setter Property="BorderBrush" Value="#303640" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="StripeOpacity" Value="0.16" />
            <Setter Property="StripeSpeed" Value="14" />
            <Setter Property="StripeAssetUri" Value="avares://BohemiX.App/Assets/striped-draft-card-surface.png" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="controls|StripedCardBorder.SaveListRow:pointerover">
            <Setter Property="Background" Value="#242831" />
            <Setter Property="BorderBrush" Value="#4B5563" />
        </Style>

        <Style Selector="controls|StripedCardBorder.SaveListRow.selected">
            <Setter Property="Background" Value="#333840" />
            <Setter Property="BorderBrush" Value="#F59E0B" />
        </Style>

        <Style Selector="controls|StripedCardBorder.SaveNotice">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#14171D" />
            <Setter Property="BorderBrush" Value="#2C3038" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="StripeOpacity" Value="0.12" />
            <Setter Property="StripeSpeed" Value="14" />
            <Setter Property="StripeAssetUri" Value="avares://BohemiX.App/Assets/striped-draft-card-surface.png" />
        </Style>

        <Style Selector="TextBox.SavePathBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#0F1116" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="BorderBrush" Value="#30343D" />
            <Setter Property="SelectionBrush" Value="#665B8CFF" />
        </Style>

        <Style Selector="Button.SavePrimaryButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#F59E0B" />
            <Setter Property="BorderBrush" Value="#F59E0B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#111318" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.SavePrimaryButton:pointerover">
            <Setter Property="Background" Value="#FBBF24" />
            <Setter Property="BorderBrush" Value="#FBBF24" />
        </Style>

        <Style Selector="Button.SaveFlatButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#22262E" />
            <Setter Property="BorderBrush" Value="#3A404B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="FontWeight" Value="Medium" />
