        <Style Selector="Button.SaveFlatButton:pointerover">
            <Setter Property="Background" Value="#2A2F38" />
            <Setter Property="BorderBrush" Value="#58606D" />
        </Style>

        <Style Selector="ListBox.SaveListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="ListBox.SaveListBox > ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="ListBox.SaveListBox > ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
