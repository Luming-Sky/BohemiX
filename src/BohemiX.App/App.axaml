            <Setter Property="BorderBrush" Value="#3DFFFFFF" />
        </Style>

        <Style Selector="Button.GlyphWindowControlButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#D9FFFFFF" />
        </Style>

        <Style Selector="Button.GlyphWindowControlButton:pointerover">
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.CloseWindowControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#EF4444" />
        </Style>

        <Style Selector="Button.CloseWindowControl:pointerover">
            <Setter Property="Background" Value="#26EF4444" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#FCA5A5" />
        </Style>

        <Style Selector="Button.GlyphDangerButton">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#F87171" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.GlyphDangerButton:pointerover">
            <Setter Property="Background" Value="#B91C1C" />
            <Setter Property="BorderBrush" Value="#FCA5A5" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.GlyphDangerButton:disabled">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#F87171" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Opacity" Value="0.82" />
        </Style>

        <Style Selector="Button.GlyphNavCircle">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#A6FFFFFF" />
        </Style>

        <Style Selector="Button.GlyphNavCircle:pointerover">
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.GlyphNavCircle.active">
            <Setter Property="Background" Value="#332563EB" />
            <Setter Property="BorderBrush" Value="#665B8CFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.GlyphSidebarItem">
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8CFFFFFF" />
        </Style>

        <Style Selector="Button.GlyphSidebarItem:pointerover">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.GlyphSidebarItem.active">
            <Setter Property="Background" Value="#1CFFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.GlyphSidebarToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#24FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#B8FFFFFF" />
        </Style>

        <Style Selector="Button.GlyphSidebarToggleButton:pointerover">
            <Setter Property="Background" Value="#24FFFFFF" />
            <Setter Property="BorderBrush" Value="#3AFFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Border.SettingsPanel">
            <Setter Property="Background" Value="#EEF8FAFC" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="BoxShadow" Value="0 10 28 0 #24050A14" />
        </Style>

        <!-- 设置面板样式 - 深色主题，进一步降低背景亮度 -->
        <Style Selector="controls|StripedCardBorder.SettingsPanel">
            <Setter Property="Background" Value="#101114" />
            <Setter Property="BorderBrush" Value="#2B2D33" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="StripeAnchorMode" Value="Viewport" />
            <Setter Property="StripeOpacity" Value="0.1" />
            <Setter Property="StripeSpeed" Value="14" />
            <Setter Property="StripeAssetUri" Value="avares://BohemiX.App/Assets/striped-draft-card-surface.png" />
        </Style>

        <Style Selector="Border.SettingRow">
            <Setter Property="Background" Value="#1D2027" />
            <Setter Property="BorderBrush" Value="#303640" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style Selector="controls|StripedCardBorder.SettingRow">
            <Setter Property="Background" Value="#1D2027" />
            <Setter Property="BorderBrush" Value="#303640" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="StripeOpacity" Value="0.16" />
            <Setter Property="StripeSpeed" Value="14" />
            <Setter Property="StripeAssetUri" Value="avares://BohemiX.App/Assets/striped-draft-card-surface.png" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="controls|StripedCardBorder.SettingRow:pointerover">
            <Setter Property="Background" Value="#252932" />
            <Setter Property="BorderBrush" Value="#4B5563" />
        </Style>

        <Style Selector="controls|StripedCardBorder.SettingRow CheckBox">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>

        <Style Selector="CheckBox.SettingsToggle">
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="Auto,Auto"
                          ColumnSpacing="10"
                          VerticalAlignment="Center">
                        <Border x:Name="SwitchTrack"
                                Width="52"
                                Height="28"
                                CornerRadius="14"
                                Background="#202631"
                                BorderBrush="#4B5563"
                                BorderThickness="1">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                                </Transitions>
                            </Border.Transitions>
                            <Grid>
                                <Border x:Name="SwitchThumb"
                                        Width="20"
                                        Height="20"
                                        Margin="4,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        CornerRadius="10"
                                        Background="#94A3B8"
                                        BoxShadow="0 2 8 0 #66000000">
                                    <Border.Transitions>
                                        <Transitions>
                                            <ThicknessTransition Property="Margin" Duration="0:0:0.18" />
                                            <BrushTransition Property="Background" Duration="0:0:0.18" />
                                        </Transitions>
                                    </Border.Transitions>
                                </Border>
                            </Grid>
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="CheckBox.SettingsToggle:pointerover /template/ Border#SwitchTrack">
            <Setter Property="Background" Value="#293241" />
            <Setter Property="BorderBrush" Value="#64748B" />
        </Style>

        <Style Selector="CheckBox.SettingsToggle:checked /template/ Border#SwitchTrack">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#60A5FA" />
        </Style>

        <Style Selector="CheckBox.SettingsToggle:checked:pointerover /template/ Border#SwitchTrack">
            <Setter Property="Background" Value="#1D4ED8" />
            <Setter Property="BorderBrush" Value="#93C5FD" />
        </Style>

        <Style Selector="CheckBox.SettingsToggle:checked /template/ Border#SwitchThumb">
            <Setter Property="Margin" Value="28,0,0,0" />
            <Setter Property="Background" Value="#FFFFFFFF" />
        </Style>

        <Style Selector="CheckBox.SettingsToggle:focus-visible /template/ Border#SwitchTrack">
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="BoxShadow" Value="0 0 0 3 #334F7DFF" />
        </Style>

        <Style Selector="CheckBox.SettingsToggle:disabled /template/ Border#SwitchTrack">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <Style Selector="controls|StripedCardBorder.SettingRow TextBox">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Background" Value="#0F1116" />
            <Setter Property="BorderBrush" Value="#30343D" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="Border.SettingRow CheckBox">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>

        <Style Selector="Border.SettingRow TextBox">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Background" Value="#0F1116" />
            <Setter Property="BorderBrush" Value="#30343D" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="ComboBox.SettingsComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#0F1116" />
            <Setter Property="BorderBrush" Value="#30343D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <Style Selector="ComboBox.SettingsComboBox:pointerover">
            <Setter Property="Background" Value="#11141A" />
            <Setter Property="BorderBrush" Value="#4B5563" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>

        <Style Selector="ComboBox.SettingsComboBox:focus">
            <Setter Property="Background" Value="#11141A" />
            <Setter Property="BorderBrush" Value="#F59E0B" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>

        <Style Selector="ComboBox.SettingsComboBox:disabled">
            <Setter Property="Background" Value="#101318" />
            <Setter Property="BorderBrush" Value="#262B34" />
            <Setter Property="Foreground" Value="#7F8794" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="ComboBox.SettingsComboBox ComboBoxItem">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Background" Value="#17191F" />
        </Style>

    </Application.Styles>
</Application>
