<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.14" />
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="SharpGLTF.Core" Version="1.0.6" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BohemiX.Core\BohemiX.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Remove="Assets\Source\**" />
    <AvaloniaResource Remove="Assets\Models\**" />
    <AvaloniaResource Include="..\BohemiX.App\Assets\Icons\Spot\png\forge-workshop.png;
                               ..\BohemiX.App\Assets\Icons\Spot\png\hot-billet.png;
                               ..\BohemiX.App\Assets\Icons\Spot\png\craft-quality.png;
                               ..\BohemiX.App\Assets\Icons\Spot\png\recipe-book.png"
                      Link="Assets\Icons\%(Filename)%(Extension)" />
    <Content Include="Assets\Models\**"
             Link="Assets\Forge\Models\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\BohemiX.Modules.Alchemy\Assets\Sprites\workshop_background.png"
             Link="Assets\Forge\workshop_background.png"
             CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Data\*.json" />
  </ItemGroup>
</Project>
