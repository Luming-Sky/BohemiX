{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 15000
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
      "timeout": 15000
    },
    "vision": {
      "type": "local",
      "command": ["node", "index.mjs"],
      "cwd": "D:/BohemiX/.opencode/mcp/vision",
      "enabled": true,
      "timeout": 60000,
      "environment": {
        "VISION_API_BASE": "https://hubway.cc/v1",
        "VISION_MODEL": "grok-4.5",
        "VISION_API_KEY": "{env:HUBWAY_API_KEY}"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": false,
      "timeout": 30000
    }
  },
  "tools": {
    "github*": false
  }
}
